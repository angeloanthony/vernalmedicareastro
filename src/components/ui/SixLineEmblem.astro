---
// src/components/ui/SixLineEmblem.astro — the six-line emblem: six rows of
// paired bars (in I Ching terms, six broken lines — Hexagram 2, Kūn, "Earth /
// the Receptive"). Purely decorative: inline SVG, aria-hidden, no text and no
// claims. Color follows `currentColor`; size via the `size` prop (px width).
interface Props { size?: number; class?: string }
const { size = 26, class: className = '' } = Astro.props;
const rows = [0, 1, 2, 3, 4, 5];
---
<svg class={`six-line-emblem ${className}`.trim()} viewBox="0 0 30 34" width={size} height={Math.round((size * 34) / 30)} aria-hidden="true" focusable="false">
  {rows.map((i) => (
    <Fragment>
      <rect x="0" y={i * 6.2} width="13" height="3.4" rx="1" fill="currentColor" />
      <rect x="17" y={i * 6.2} width="13" height="3.4" rx="1" fill="currentColor" />
    </Fragment>
  ))}
</svg>
