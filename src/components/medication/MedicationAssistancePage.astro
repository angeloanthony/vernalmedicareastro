---
// MedicationAssistancePage.astro — the reference implementation for every
// Prescription Assistance medication page (docs/PRESCRIPTION-ASSISTANCE-PROJECT.md
// §13). Rendered by src/pages/[drug]-assistance-program.astro whenever a
// MedicationAssistanceRecord exists for the drug. One record → one page:
//
//   Hero (H1 · byline · last-verified · summary · next step) + video frame
//   Quick Answer · About the medication · Options at a glance (table)
//   Assistance programs (manufacturer / charitable / government cards)
//   How to Apply (7 steps) · What You'll Need · If Assistance Is Unavailable
//   Could Extra Help Reduce Your Costs? · Key terms (<dl>) · Related medications
//   — then the shared footer: FAQ · Sources · Related · CTA · disclaimer.
//
// Sections render only when the record has content for them (spec §11): a
// medication with no charitable fund shows the honest-negative card, not a
// padded section. Nothing on this page is hard-coded per medication.
//
// PRESENTATION NOTE: like every article page, this one has no <main> ancestor,
// so styles.css's `main …` rules never reach it. All body styling is nested
// under `.mapg`; the `is:inline` block polishes only the shared chrome around
// the body (breadcrumb · summary · sources · disclaimer) on THIS page.
import DrugPage from '../layout/DrugPage.astro';
import AuthorByline from '../content/AuthorByline.astro';
import NextSteps from '../content/NextSteps.astro';
import SummaryBlock from '../SummaryBlock.astro';
import VideoPlaceholder from './VideoPlaceholder.astro';
import AssistanceProgramCard from './AssistanceProgramCard.astro';
import ApplicationSteps from './ApplicationSteps.astro';
import { FEATURED_DRUGS } from '../../data/drugs';
import { BUSINESS } from '../../data/business';
import {
  assistanceHref,
  assistanceTitle,
  assistanceHeading,
  assistanceLabel,
  verifiedMonth,
  extraHelpProgram,
  extraHelpFacts,
  medicationAssistanceFor,
  categoryLabelsFor,
  taxonomyTags,
  KIND_META,
  STATUS_META,
  MEDICARE_META,
  KEY_TERMS,
} from '../../data/medicationAssistance';
import type { MedicationAssistanceRecord, AssistanceProgram } from '../../types/MedicationAssistance';
import type { PageContext, RelatedPage } from '../../types/Page';

interface Props {
  record: MedicationAssistanceRecord;
}
const { record: r } = Astro.props;

const href = assistanceHref(r.slug);
const verified = verifiedMonth(r.lastVerified);
const extraHelp = extraHelpProgram();
const eh = extraHelpFacts();
const phoneTel = `tel:${BUSINESS.phoneTel}`;

// Group programs the way the spec groups them (§13). Extra Help has its own
// section, so `government` here is only for any additional government route.
const byKind = (kinds: AssistanceProgram['kind'][]) => r.programs.filter((p) => kinds.includes(p.kind));
const manufacturer = byKind(['manufacturer-pap', 'manufacturer-savings', 'manufacturer-direct']);
const charitable = byKind(['charitable']);
const government = byKind(['government']).filter((p) => p.id !== 'extra-help');
const openCount = r.programs.filter((p) => p.status === 'open' || p.status === 'limited').length;

// Options-at-a-glance table: every researched program + Extra Help.
const glance = [...r.programs, extraHelp];

// Related medications: a record-driven page when one exists, else the legacy page.
const relatedMeds = r.relatedMedications
  .map((slug) => {
    const rec = medicationAssistanceFor(slug);
    if (rec) return { href: assistanceHref(slug), label: assistanceLabel(rec), sub: rec.genericName };
    const d = FEATURED_DRUGS.find((x) => x.slug === slug);
    return d ? { href: assistanceHref(slug), label: `${d.drug} Assistance Programs`, sub: d.generic } : null;
  })
  .filter((x): x is { href: string; label: string; sub: string } => x !== null);

const related: RelatedPage[] = r.relatedResources.map((x) => ({ href: x.href, label: x.label, blurb: x.blurb, silo: 'part-d' }));

const summary =
  `${r.quickAnswer.verdict} Financial assistance may be available through charitable foundations, ` +
  `manufacturer programs, Medicare's Extra Help program, or other assistance resources. Availability ` +
  `and eligibility change frequently — the information on this page was verified in ${verified}.`;

const context: PageContext = {
  page: {
    title: assistanceTitle(r),
    heading: assistanceHeading(r),
    description: r.description_meta,
    taxonomy: {
      silo: 'part-d',
      tags: taxonomyTags(r, ['drug-assistance', 'part-d', 'prescription-assistance']),
    },
    summary,
    faqs: r.faqs,
    sources: r.sources.map((s) => ({ title: s.title, url: s.url, publisher: s.publisher, date: s.checked })),
    nextSteps: [
      {
        when: `If ${r.brandName} is straining your budget,`,
        action:
          'start with the program marked "Accepting applications" below, then check whether Extra Help could lower every prescription — and call us free if you want a second set of eyes on which route fits your situation.',
      },
    ],
  },
  meta: {
    canonical: `https://vernalmedicare.com${href}`,
    ogType: 'article',
    ogTitle: assistanceHeading(r),
    ogDescription: r.description_meta,
  },
  author: 'rocco',
  datePublished: r.datePublished,
  lastUpdated: r.lastVerified,
  breadcrumb: [
    { name: 'Home', href: '/' },
    { name: 'Prescription Drug Assistance', href: '/prescription-drug-assistance.html' },
    { name: `${r.brandName} Assistance`, href },
  ],
  related,
  cta: {
    heading: 'Having trouble figuring out your prescription costs?',
    text: `If you live in Vernal or the Uintah Basin, Vernal Medicare can help you understand your Medicare prescription coverage and where to look for ${r.brandName} assistance — free, no pressure. We don't award grants or decide eligibility; the programs above do. We help you find and apply to the right ones.`,
    primary: { label: `Call ${BUSINESS.phone}`, href: phoneTel },
    secondary: { label: 'Schedule a Free Review', href: '/medicare-quote-vernal.html' },
  },
  medicalDisclaimer:
    `Assistance information last verified ${verified}. Program details — fund status, eligibility, prices, phone numbers — change often; confirm with each program before applying. Vernal Medicare does not administer, fund or approve any assistance program. Not medical advice.`,
};

const JUMPS = [
  { id: 'quick-answer', label: 'Quick answer' },
  { id: 'programs', label: 'Assistance programs' },
  { id: 'how-to-apply', label: 'How to apply' },
  { id: 'what-you-need', label: "What you'll need" },
  { id: 'if-unavailable', label: 'If assistance is unavailable' },
  { id: 'extra-help', label: 'Medicare Extra Help' },
];
---

<DrugPage context={context} bareHeader>
  <div class="mapg">
    <style is:inline>
      .page > .breadcrumbs { margin: 0 0 1.35rem; font-size: 0.9rem; }
      .page > .breadcrumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
      .page > .breadcrumbs li { display: flex; align-items: center; gap: 0.5rem; }
      .page > .breadcrumbs li + li::before { content: "\203A"; color: #a8b8c9; font-weight: 700; }
      .page > .breadcrumbs a { color: #55627a; font-weight: 600; text-decoration: none; }
      .page > .breadcrumbs a:hover { color: #dc3545; text-decoration: underline; }
      .page > .breadcrumbs [aria-current="page"] { color: #0b2c45; font-weight: 700; }
      .page > .sources { margin: 2.5rem 0; background: #fff; border: 1px solid #e2e9f1; border-radius: 16px; padding: 1.4rem 1.6rem; }
      .page > .sources h2 { margin: 0 0 0.8rem; color: #0b2c45; font-size: 1.25rem; }
      .page > .sources ul { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; color: #43526b; font-size: 0.92rem; line-height: 1.55; }
      .page > .sources a { color: #0b6ea3; font-weight: 600; }
      .page > .page-disclaimer { margin: 1.5rem 0 0; color: #6b7c8c; font-size: 0.85rem; line-height: 1.55; }
    </style>

    {/* ─── Hero + video ─────────────────────────────────────────────── */}
    <section class="mapg-hero">
      <div class="mapg-hero__copy">
        <p class="mapg-hero__kicker">{categoryLabelsFor(r).join(' · ')}</p>
        <h1 class="mapg-hero__title">{context.page.heading}</h1>
        <AuthorByline authorId={context.author} updated={context.lastUpdated} />
        <p class="mapg-hero__verified">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11.5l2 2 4-4.5"/><path d="M4 6.5l8-3.5 8 3.5v5c0 5-3.4 8.2-8 9.5-4.6-1.3-8-4.5-8-9.5z"/></svg>
          Assistance information last verified: <strong>{verified}</strong>
        </p>
        <SummaryBlock text={context.page.summary} />
        <NextSteps steps={context.page.nextSteps ?? []} />
      </div>
      <div class="mapg-hero__media">
        <VideoPlaceholder video={r.video} />
      </div>
    </section>

    <nav class="mapg-jump" aria-label="On this page">
      {JUMPS.map((j) => <a href={`#${j.id}`}>{j.label}</a>)}
    </nav>

    {/* ─── Quick answer ─────────────────────────────────────────────── */}
    <section class="mapg-quick" id="quick-answer">
      <h2>Can I get help paying for {r.brandName}?</h2>
      <p class="mapg-quick__verdict">{r.quickAnswer.verdict}</p>
      <ul class="mapg-quick__points">
        {r.quickAnswer.points.map((p) => (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
      <p class="mapg-quick__count">
        {openCount > 0
          ? `${openCount} of the ${r.programs.length} programs we checked for ${r.brandName} ${openCount === 1 ? 'was' : 'were'} accepting applications when verified in ${verified}.`
          : `None of the ${r.programs.length} programs we checked for ${r.brandName} were accepting new applications when verified in ${verified} — see the alternatives below.`}
      </p>
    </section>

    {/* ─── About the medication ─────────────────────────────────────── */}
    <section class="mapg-about">
      <div class="mapg-about__card">
        <h2>About {r.brandName} ({r.genericName})</h2>
        <p>{r.description}</p>
        <h3>Approved uses</h3>
        <ul>{r.usedFor.map((u) => <li>{u}</li>)}</ul>
        <p class="mapg-about__maker"><strong>Manufacturer:</strong> {r.manufacturer}</p>
      </div>
      <div class="mapg-about__card mapg-about__card--cost">
        <h2>Why {r.brandName} can be expensive on Medicare</h2>
        <p>{r.whyCostly}</p>
        <h3>Medicare coverage context</h3>
        <p>{r.medicareContext}</p>
        <p class="mapg-about__links">
          <a href="/medicare-formulary-lookup.html">Check typical Part D coverage</a> ·
          <a href="/medicare-drug-cost-calculator.html">Estimate your drug costs</a> ·
          <a href="/part-d-plans-vernal.html">Compare Part D plans in Vernal</a>
        </p>
      </div>
    </section>

    {/* ─── Options at a glance ──────────────────────────────────────── */}
    <section class="mapg-glance" id="programs">
      <h2>{r.brandName} assistance options at a glance</h2>
      <p class="mapg-sub">Every program we checked, what kind of help it is, whether people with Medicare can use it, and its status when we verified it. <em>A medication being listed by a program is not the same as the program accepting applications.</em></p>
      <div class="mapg-tablewrap">
        <table class="mapg-table">
          <caption class="mapg-sr-only">{r.brandName} assistance programs compared</caption>
          <thead>
            <tr><th scope="col">Program</th><th scope="col">Type of help</th><th scope="col">People with Medicare</th><th scope="col">Status ({verified})</th></tr>
          </thead>
          <tbody>
            {glance.map((p) => (
              <tr>
                <th scope="row"><a href={`#program-${p.id}`}>{p.name}</a></th>
                <td>{KIND_META[p.kind].label}</td>
                <td><span class:list={['mapg-pill', MEDICARE_META[p.medicare].cls]}>{MEDICARE_META[p.medicare].label.replace('Medicare: ', '')}</span></td>
                <td><span class:list={['mapg-pill', STATUS_META[p.status].cls]}>{STATUS_META[p.status].label}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* ─── Program cards ────────────────────────────────────────────── */}
    {manufacturer.length > 0 && (
      <section class="mapg-group">
        <div class="mapg-group__head" style={`--c:${KIND_META['manufacturer-pap'].color};--t:${KIND_META['manufacturer-pap'].tint}`}>
          <span class="mapg-group__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V9l8-5 8 5v12"/><path d="M9 21v-6h6v6"/><path d="M9 12h.01M15 12h.01M9 9h.01M15 9h.01"/></svg></span>
          <div>
            <h2>Manufacturer programs from {r.manufacturer}</h2>
            <p>A <strong>patient assistance program</strong> (free or low-cost drug by income) is not the same as a <strong>copay card</strong> (a commercial discount that usually excludes Medicare). Both are listed so you can see which one applies to you.</p>
          </div>
        </div>
        <div class="mapg-cards">{manufacturer.map((p) => <AssistanceProgramCard program={p} />)}</div>
      </section>
    )}

    {charitable.length > 0 && (
      <section class="mapg-group">
        <div class="mapg-group__head" style={`--c:${KIND_META.charitable.color};--t:${KIND_META.charitable.tint}`}>
          <span class="mapg-group__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.8 19c0-3.3 2.7-5.5 6.2-5.5s6.2 2.2 6.2 5.5"/><circle cx="17.5" cy="8.5" r="2.4"/><path d="M15.8 13.7c2.7.3 4.9 2.3 4.9 5.3"/></svg></span>
          <div>
            <h2>Charitable grants for {r.brandName}</h2>
            <p>{r.charitableSummary}</p>
          </div>
        </div>
        <div class="mapg-cards">{charitable.map((p) => <AssistanceProgramCard program={p} />)}</div>
      </section>
    )}

    {government.length > 0 && (
      <section class="mapg-group">
        <div class="mapg-group__head" style={`--c:${KIND_META.government.color};--t:${KIND_META.government.tint}`}>
          <span class="mapg-group__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5L12 5l8 5.5"/><path d="M5 10.5V19h14v-8.5"/><path d="M9.5 19v-5h5v5"/></svg></span>
          <div>
            <h2>Other government routes</h2>
            <p>{KIND_META.government.explainer}</p>
          </div>
        </div>
        <div class="mapg-cards">{government.map((p) => <AssistanceProgramCard program={p} />)}</div>
      </section>
    )}

    {/* ─── How to apply ─────────────────────────────────────────────── */}
    <section class="mapg-apply" id="how-to-apply">
      <h2>How to apply for {r.brandName} assistance</h2>
      <p class="mapg-sub">The written steps are complete on their own; the video above will walk through the same process when it is published.</p>
      <ApplicationSteps steps={r.applicationSteps} />
    </section>

    {/* ─── What you'll need + if unavailable ────────────────────────── */}
    <div class="mapg-duo">
      <section class="mapg-need" id="what-you-need">
        <h2>What you'll need</h2>
        <p class="mapg-sub">Only items the programs above actually ask for. Gather these before you start.</p>
        <ul class="mapg-check">
          {r.documentsNeeded.map((d) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              <span><strong>{d.item}</strong>{d.note && <em> — {d.note}</em>}</span>
            </li>
          ))}
        </ul>
      </section>
      <section class="mapg-alt" id="if-unavailable">
        <h2>If assistance is unavailable</h2>
        <p class="mapg-sub">A closed fund or a denial is not the end of the road. Check these next:</p>
        <ol class="mapg-altlist">
          {r.ifUnavailable.map((a) => (
            <li>
              {a.text}
              {a.href && <Fragment> <a href={a.href} {...(/^https?:/.test(a.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{a.label ?? 'Learn more'}</a></Fragment>}
            </li>
          ))}
        </ol>
      </section>
    </div>

    {/* ─── Extra Help ───────────────────────────────────────────────── */}
    <section class="mapg-eh" id="extra-help">
      <div class="mapg-eh__intro">
        <h2>Could Medicare Extra Help reduce your {r.brandName} costs?</h2>
        <p>Extra Help is not a grant for {r.brandName}. It is a Medicare program that lowers what qualifying beneficiaries pay for their Part D premium, deductible and <em>every</em> covered prescription — so it is worth checking even when a charitable fund is closed, because it does not depend on fund balances.</p>
        {r.extraHelpNote && <p>{r.extraHelpNote}</p>}
        <p>In {eh.year}, people with full Extra Help generally pay no more than {eh.brandCopay} for a covered brand-name drug. Income must be below about {eh.incomeIndividual} a year for one person ({eh.incomeCouple} for a couple) and countable resources under {eh.resourcesIndividual} ({eh.resourcesCouple} for a couple). Apply free through Social Security — online, by phone at {eh.phone}, or in person — and never pay anyone to apply for you.</p>
        <p class="mapg-eh__links">
          <a href="/medicare-extra-help-utah.html">Extra Help explained (Utah)</a> ·
          <a href="/medicare-extra-help-calculator.html">Check if you might qualify</a> ·
          <a href="/medicare-savings-programs-utah.html">Medicare Savings Programs</a> ·
          <a href="/medicare-financial-assistance.html">All help paying for Medicare</a>
        </p>
      </div>
      <AssistanceProgramCard program={extraHelp} />
    </section>

    {/* ─── Key terms ────────────────────────────────────────────────── */}
    <section class="mapg-terms">
      <h2>Key terms on this page</h2>
      <dl>
        {KEY_TERMS.map((t) => (
          <div class="mapg-terms__row">
            <dt>{t.term}</dt>
            <dd>{t.definition}</dd>
          </div>
        ))}
      </dl>
    </section>

    {/* ─── Related medications ──────────────────────────────────────── */}
    {relatedMeds.length > 0 && (
      <section class="mapg-meds">
        <h2>Related medication assistance guides</h2>
        <div class="mapg-meds__grid">
          {relatedMeds.map((m) => (
            <a class="mapg-meds__card" href={m.href}>
              <strong>{m.label}</strong>
              <span>{m.sub}</span>
            </a>
          ))}
          <a class="mapg-meds__card mapg-meds__card--hub" href="/prescription-drug-assistance.html">
            <strong>All prescription assistance</strong>
            <span>Directory &amp; program finder</span>
          </a>
        </div>
      </section>
    )}
  </div>
</DrugPage>

<style>
  .mapg {
    --navy: #0b2c45;
    --line: #e2e9f1;
    --copy: #43526b;
    --blue: #2563eb;
    --shadow: 0 10px 26px rgba(11, 44, 69, 0.06);
  }
  .mapg h2 { color: var(--navy); font-size: clamp(1.3rem, 2.4vw, 1.6rem); line-height: 1.2; margin: 0 0 0.6rem; }
  .mapg h3 { color: var(--navy); font-size: 1.02rem; margin: 0.8rem 0 0.35rem; }
  .mapg p { color: var(--copy); line-height: 1.6; }
  .mapg-sub { margin: 0 0 1.1rem; font-size: 0.95rem; max-width: 72ch; }
  .mapg-sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .mapg-pill { display: inline-block; font-size: 0.76rem; font-weight: 700; border-radius: 999px; padding: 0.2rem 0.6rem; white-space: nowrap; }
  .mapg-pill.is-open { background: #e4f5ea; color: #15803d; }
  .mapg-pill.is-limited { background: #fef3e2; color: #b45309; }
  .mapg-pill.is-closed { background: #fde8e8; color: #b91c1c; }
  .mapg-pill.is-verify, .mapg-pill.is-none { background: #eef2f6; color: #475467; }

  /* ── Hero ── */
  .mapg-hero { display: grid; grid-template-columns: 1.25fr 1fr; gap: 2.4rem; align-items: start; margin: 0.4rem 0 1.6rem; }
  .mapg-hero__kicker { margin: 0 0 0.4rem; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--blue); }
  .mapg-hero__title { margin: 0 0 0.6rem; font-size: clamp(1.9rem, 4.2vw, 2.55rem); line-height: 1.1; color: var(--navy); letter-spacing: -0.015em; }
  .mapg-hero__copy :global(.byline) { color: #55627a; font-size: 0.92rem; margin: 0 0 0.6rem; }
  .mapg-hero__copy :global(.byline a) { color: #0b6ea3; font-weight: 600; text-decoration: none; }
  .mapg-hero__verified {
    display: inline-flex; align-items: center; gap: 0.45rem; margin: 0 0 1rem;
    background: #e4f5ea; color: #15803d; font-size: 0.86rem; font-weight: 600;
    border-radius: 999px; padding: 0.35rem 0.8rem;
  }
  .mapg-hero__verified svg { width: 18px; height: 18px; }
  .mapg-hero__verified strong { color: #14532d; }
  .mapg-hero__copy :global(.summary-block) { margin: 0 0 1rem; }
  .mapg-hero__copy :global(.summary-block p) { margin: 0; font-size: 1.08rem; line-height: 1.65; color: var(--copy); }
  .mapg-hero__copy :global(.next-steps) { margin: 0; }
  .mapg-hero__copy :global(.next-step) {
    display: flex; gap: 0.7rem; align-items: flex-start;
    background: #eaf1fd; border-left: 4px solid var(--blue); border-radius: 10px;
    padding: 0.85rem 1rem; color: #17324d; font-size: 0.95rem; line-height: 1.5;
  }
  .mapg-hero__copy :global(.next-step)::before {
    content: "↓"; flex-shrink: 0; display: grid; place-items: center;
    width: 26px; height: 26px; border-radius: 50%; background: var(--blue); color: #fff; font-weight: 700; font-size: 0.9rem;
  }
  .mapg-hero__copy :global(.next-step-when) { color: var(--navy); }
  .mapg-hero__media { position: sticky; top: 110px; }
  @media (max-width: 960px) {
    .mapg-hero { grid-template-columns: 1fr; gap: 1.4rem; }
    .mapg-hero__media { position: static; }
  }

  /* ── Jump nav ── */
  .mapg-jump { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0 0 2rem; }
  .mapg-jump a {
    text-decoration: none; font-size: 0.86rem; font-weight: 700; color: var(--navy);
    background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 0.4rem 0.85rem;
  }
  .mapg-jump a:hover { border-color: var(--blue); color: var(--blue); }

  /* ── Quick answer ── */
  .mapg-quick {
    background: linear-gradient(135deg, #0b2c45 0%, #123a5c 100%); color: #fff;
    border-radius: 20px; padding: 1.7rem 1.9rem; margin: 0 0 2rem;
    box-shadow: 0 22px 50px rgba(11, 44, 69, 0.22);
  }
