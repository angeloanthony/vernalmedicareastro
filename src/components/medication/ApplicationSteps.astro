---
// ApplicationSteps.astro — the numbered, medication-specific "How to Apply"
// guide (docs/PRESCRIPTION-ASSISTANCE-PROJECT.md §10). Content comes from the
// record; this component only supplies the structure and styling.
import type { ApplicationStep } from '../../types/MedicationAssistance';

interface Props {
  steps: ApplicationStep[];
}
const { steps } = Astro.props;
---

<ol class="steps">
  {steps.map((s, i) => (
    <li class="steps__item">
      <span class="steps__n" aria-hidden="true">{i + 1}</span>
      <div class="steps__body">
        <h3>Step {i + 1} — {s.title}</h3>
        <p>{s.body}</p>
        {s.bullets && s.bullets.length > 0 && <ul>{s.bullets.map((b) => <li>{b}</li>)}</ul>}
      </div>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; counter-reset: step; }
  .steps__item {
    display: grid; grid-template-columns: 44px 1fr; gap: 1rem; align-items: start;
    background: #fff; border: 1px solid #e2e9f1; border-radius: 14px; padding: 1.1rem 1.25rem;
  }
  .steps__n {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background: linear-gradient(180deg, #2563eb, #1d4ed8); color: #fff; font-weight: 800; font-size: 1.05rem;
    box-shadow: 0 8px 18px rgba(37, 99, 235, 0.3);
  }
  .steps__body h3 { margin: 0.2rem 0 0.4rem; color: #0b2c45; font-size: 1.08rem; line-height: 1.3; }
  .steps__body p { margin: 0; color: #334155; font-size: 0.95rem; line-height: 1.6; }
  .steps__body ul { margin: 0.55rem 0 0; padding-left: 1.15rem; display: grid; gap: 0.25rem; }
  .steps__body li { color: #475467; font-size: 0.92rem; line-height: 1.5; }
  @media (max-width: 560px) {
    .steps__item { grid-template-columns: 34px 1fr; gap: 0.7rem; padding: 0.95rem 1rem; }
    .steps__n { width: 34px; height: 34px; font-size: 0.95rem; }
  }
</style>
