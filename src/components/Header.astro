---
// src/components/Header.astro
// Lifted verbatim from the existing site's top-bar + main-header + nav.
// Phone/email come from the single source of truth (business.ts).
// Active-nav is computed server-side from the current path — no client JS needed
// for the highlight, though the mobile toggle script still ships (see BaseLayout).
import { BUSINESS } from '../data/business';
import { PRIMARY_NAV, type NavLink } from '../config/navigation';
import LanguageSwitcher from './LanguageSwitcher.astro';
import SixLineEmblem from './ui/SixLineEmblem.astro';
import { getLangFromUrl, t, localizeLabel } from '../i18n/locales';
import { localizeHref } from '../i18n/content';

// i18n (M3): nav labels via localizeLabel (navigation.ts stays the single
// English source); hrefs existence-aware via localizeHref (fall back to the
// English page until a translation exists). English output is unchanged.
const lang = getLangFromUrl(Astro.url);

// Current path for active-nav highlighting. With build format 'file',
// pathname is like "/faq.html" or "/" for home.
const path = Astro.url.pathname;
const normalize = (href: string) =>
  href === 'index.html' || href === '/' ? '/' : '/' + href.replace(/^\//, '');
const here = path === '/' || path === '/index.html' ? '/' : path;
const isActive = (href?: string) => !!href && here === normalize(href);
// A hub is the "current section" if it OR any of its children is the page.
const inSection = (link: NavLink) =>
  isActive(link.href) || (link.children?.some((c) => isActive(c.href)) ?? false);

// Nav is data-driven from src/config/navigation.ts (single source of truth).
const navLinks = PRIMARY_NAV;
---

<!-- Top Bar -->
<div class="top-bar">
  {/* Decorative corner mascot — desktop only (see .top-bar-mascot in styles.css). */}
  <img
    class="top-bar-mascot"
    src="/pictures/smile.webp"
    alt=""
    width="56"
    height="56"
    aria-hidden="true"
    decoding="async"
  />
  {/* Six-line emblem as a tonal watermark behind the bar text — desktop only. */}
  <SixLineEmblem class="topbar-emblem" />
  <div class="container">
    <span>📧 <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a></span>
    <span>📞 <a href={`tel:${BUSINESS.phoneTel}`}>{BUSINESS.phone}</a> (TTY: {BUSINESS.tty})</span>
    {/* Google rating badge — figures live in BUSINESS.googleRating. */}
    <a
      class="g-rate"
      href={BUSINESS.googleReviews}
      target="_blank"
      rel="noopener"
      aria-label={t('header.reviewsAria', lang, { rating: BUSINESS.googleRating.value, count: BUSINESS.googleRating.count })}
    >
      <span class="g-rate__score">{BUSINESS.googleRating.value}</span>
      <span class="g-rate__stars" aria-hidden="true">
        {[0, 1, 2, 3, 4].map((i) => (
          <svg viewBox="0 0 24 24" width="1em" height="1em" style={`--i:${i}`} focusable="false">
            <path fill="#fbbc04" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" />
          </svg>
        ))}
      </span>
      <span class="g-rate__count">{t('header.reviewsLabel', lang, { count: BUSINESS.googleRating.count })}</span>
    </a>
    <a
      href={localizeHref('/medicare-search.html', lang)}
      class="top-search"
      aria-label={t('header.searchAria', lang)}
    >
      <span class="top-search-icon" aria-hidden="true">🔍</span>
      <span class="top-search-text">{t('header.searchLabel', lang)}</span>
    </a>
    <LanguageSwitcher />
  </div>
</div>

<!-- Header / Nav -->
<header class="main-header">
  <div class="container header-top">
    <div class="logo-left">
      <a href="/">
        <img src="/pictures/rocco.webp" alt="Rocco DeLuca — Vernal Medicare" />
      </a>
    </div>

    <div class="site-name-center">
      <a href="/" class="site-name" aria-label={t('header.homeAria', lang)}>
        <picture>
          <source srcset="/pictures/medicare-simplified.webp" type="image/webp" />
          <img src="/pictures/medicare-simplified.webp" alt="Medicare Simplified" class="brand-logo" />
        </picture>
      </a>
    </div>

    <input
      type="checkbox"
      id="nav-toggle"
      class="nav-toggle"
      aria-label={t('header.toggleAria', lang)}
      aria-expanded="false"
      aria-controls="main-nav"
    />
    <label for="nav-toggle" class="nav-toggle-label" id="nav-toggle-label">
      <span></span>
    </label>

    <nav class="main-nav" id="main-nav">
      <ul class="nav-menu">
        {
          navLinks.map((link) =>
            link.children ? (
              <li class="has-dropdown">
                <a
                  href={link.href && localizeHref(link.href, lang)}
                  class:list={['nav-hub', { featured: link.featured }]}
                  aria-haspopup="true"
                  {...(inSection(link) ? { 'aria-current': 'true' } : {})}
                >
                  {localizeLabel(link.label, lang)}
                  <span class="caret" aria-hidden="true">▾</span>
                </a>
                <ul class="dropdown">
                  {link.children.map((child) =>
                    child.href ? (
                      <li>
                        <a
                          href={localizeHref(child.href, lang)}
                          {...(isActive(child.href) ? { 'aria-current': 'page' } : {})}
                        >
                          {localizeLabel(child.label, lang)}
                        </a>
                      </li>
                    ) : (
                      <li class="dropdown-heading" role="presentation">
                        {localizeLabel(child.label, lang)}
                      </li>
                    )
                  )}
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={link.href && localizeHref(link.href, lang)}
                  {...(isActive(link.href) ? { 'aria-current': 'page' } : {})}
                >
                  {localizeLabel(link.label, lang)}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Replay the rating-star flash when the badge is hovered or focused.
  document.querySelectorAll<HTMLElement>('.g-rate').forEach((badge) => {
    const replay = () =>
      badge.querySelectorAll('svg').forEach((star) =>
        star.getAnimations().forEach((a) => {
          if (a.playState === 'finished') { a.cancel(); a.play(); }
        }),
      );
    badge.addEventListener('mouseenter', replay);
    badge.addEventListener('focus', replay);
  });
</script>

<style>
  /* Six-line emblem (Hexagram 2, Kun) as a quiet watermark in the navy top bar.
     Lighter navy at low opacity, BEHIND the text (z-index -1 inside an isolated
     bar), so the contact links stay white-on-navy. Desktop only: below 1024px
     the bar text wraps differently at every width and leaves no clear space. */
  .top-bar { isolation: isolate; }
  /* Keep the globe and "English · Español" together when the bar wraps. */
  .top-bar :global(.lang-switcher) { white-space: nowrap; }
  /* Where the corner mascot shows (>=769px, see styles.css), keep the bar text
     clear of it: 72px on both sides (mascot is 10px + 56px), so the text stays
     centred and never runs under the smiley. */
  @media (min-width: 769px) {
    .top-bar > .container { box-sizing: border-box; padding-left: 72px; padding-right: 72px; }
  }

  /* Google rating badge. The stars flash in a left-to-right chase three times
     on page load (4.8s in total) and then stop; hovering or focusing the badge
     replays it. Moving content that auto-starts must end within 5 seconds or be
     pausable (WCAG 2.2.2) — do not make this loop. Each star peaks once per
     1.4s, far under the 3-flashes-per-second limit (2.3.1).
     Reduced-motion visitors get the glow only, with no size change. */
  .g-rate {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin: 0 0.4em;
    font-size: 0.75em;
    line-height: 1;
    white-space: nowrap;
    vertical-align: middle;
  }
  .g-rate__stars { display: inline-flex; gap: 0.06em; }
  .g-rate__stars svg {
    display: block;
    overflow: visible;
    animation: g-rate-flash 1.4s ease-in-out 3 both;
    animation-delay: calc(var(--i) * 0.15s);
  }
  .g-rate__count { text-decoration: underline; text-underline-offset: 2px; }
  /* Each star flashes near-white with a gold halo, chasing left to right. */
  @keyframes g-rate-flash {
    0%, 45%, 100% { transform: scale(1); filter: none; }
    18% {
      transform: scale(1.4);
      filter: brightness(1.9) drop-shadow(0 0 3px #fff) drop-shadow(0 0 8px #fbbc04);
    }
  }
  /* Reduced motion: keep the glow, drop the size change. */
  @keyframes g-rate-glow {
    0%, 45%, 100% { filter: none; }
    18% { filter: brightness(1.9) drop-shadow(0 0 3px #fff) drop-shadow(0 0 8px #fbbc04); }
  }
  @media (prefers-reduced-motion: reduce) {
    .g-rate__stars svg { animation-name: g-rate-glow; }
  }
  @media (max-width: 481px) {
    .g-rate { font-size: 1em; }
  }
  .top-bar :global(.topbar-emblem) { display: none; }
  @media (min-width: 1024px) {
    .top-bar :global(.topbar-emblem) {
      display: block;
      position: absolute;
      right: 4%;
      top: 50%;
      transform: translateY(-50%);
      height: 82%;
      width: auto;
      color: #9fb8cc;
      opacity: 0.16;
      z-index: -1;
      pointer-events: none;
    }
  }
</style>
