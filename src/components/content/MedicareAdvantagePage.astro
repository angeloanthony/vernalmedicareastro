---
// src/components/content/MedicareAdvantagePage.astro — Medicare Advantage
// pillar template (M4; playbook §4.5). Rendered by BOTH
// /medicare-advantage-plans-vernal.html and its /es/ sibling; copy from
// src/i18n/content/{locale}/medicare-advantage-plans-vernal.json.
//
// 2026-08-25 — RENAMED from BestMedicareAdvantagePage + REDESIGNED. The old
// slug and every "Best ..." heading were retired for CMS compliance
// (42 CFR §422.2262 / MCMG: no unsubstantiated superlatives). 301s for the old
// URLs live in public/_redirects. Presentation went from a text-wall to a
// scannable landing page — custom hero, trust strip, HMO/PPO cards, dark CTA
// band — using bareHeader/bareFooter the way medicare-roosevelt-utah.astro does.
// Every SEO string, internal link and the schema payload are preserved.
import ArticlePage from '../layout/ArticlePage.astro';
import AuthorByline from './AuthorByline.astro';
import { getPageContent, hreflangAlternates, localizeHref, SITE_ORIGIN } from '../../i18n/content';
import { getLangFromUrl, getLocaleMeta } from '../../i18n/locales';
import { relatedFor } from '../../lib/related';
import { PAGE_INDEX } from '../../data/pageIndex';
import { BUSINESS } from '../../data/business';
import type { PageContext } from '../../types/Page';

const SLUG = 'medicare-advantage-plans-vernal';

interface TrustItem {
  icon: string;
  title: string;
  text: string;
}

interface Content {
  page: {
    title: string;
    heading: string;
    description: string;
    summary: string;
    faqs: { question: string; answer: string }[];
  };
  breadcrumb: { home: string; self: string };
  hero: { imgAlt: string };
  trust: TrustItem[];
  body: Record<string, string>;
  ctaPoints: string[];
}

const lang = getLangFromUrl(Astro.url);
const c = getPageContent<Content>(SLUG, lang);
const b = c.body;
const pagePath = lang === 'en' ? `/${SLUG}.html` : `/${lang}/${SLUG}.html`;

const context: PageContext = {
  page: {
    title: c.page.title,
    heading: c.page.heading,
    description: c.page.description,
    taxonomy: {
      silo: 'medicare-advantage',
      tags: ['medicare-advantage', 'advantage', 'vernal', 'uintah-county', 'local'],
      pillar: true,
    },
    summary: c.page.summary,
    faqs: c.page.faqs,
  },
  meta: {
    canonical: `${SITE_ORIGIN}${pagePath}`,
    ogType: 'article',
    gaIds: ['G-NW6ENB89NF', 'G-FTDW9B2G6Q'],
    lang,
    ogLocale: getLocaleMeta(lang).ogLocale,
    hreflang: hreflangAlternates(SLUG),
  },
  author: 'rocco',
  datePublished: '2026-04-04',
  lastUpdated: '2026-06-30',
  marketingDisclaimer: true,
  breadcrumb: [
    { name: c.breadcrumb.home, href: localizeHref('/', lang) },
    { name: c.breadcrumb.self, href: pagePath },
  ],
};

// bareFooter means we render related ourselves — use the same computation the
// layout would have, so the custom card can never drift from the default one.
const related = relatedFor(context.page.taxonomy, PAGE_INDEX, pagePath).slice(0, 6);
const tel = `tel:${BUSINESS.phoneTel}`;
// Tint the trailing year in the H1 without duplicating the heading in the JSON.
const headingHtml = c.page.heading.replace(/(\d{4})\s*$/, '<span class="mav-year">$1</span>');
const ENROLL_URL = 'https://www.sunfirematrix.com/app/consumer/medicareadvocates/10569110/';

// Trust-strip glyphs, keyed by the `icon` field in the content JSON so the
// copy file never has to carry markup.
const ICONS: Record<string, string> = {
  stethoscope:
    '<path d="M6 3v5a4 4 0 0 0 8 0V3"/><path d="M4 3h3M13 3h3"/><path d="M10 12v3a5 5 0 0 0 10 0v-1"/><circle cx="20" cy="11" r="2"/>',
  heart: '<path d="M12 20s-7-4.6-7-9.5A3.9 3.9 0 0 1 12 8a3.9 3.9 0 0 1 7 2.5C19 15.4 12 20 12 20z"/>',
  dollar: '<path d="M12 2v20"/><path d="M17 6.5C17 4.6 14.8 3.5 12 3.5S7 4.6 7 6.5s2.2 3 5 3.5 5 1.6 5 3.5-2.2 3-5 3-5-1.1-5-3"/>',
  shield: '<path d="M12 3l7 3v5.5c0 4.3-2.9 8.2-7 9.5-4.1-1.3-7-5.2-7-9.5V6z"/><path d="M9 12l2 2 4-4"/>',
};
---

<ArticlePage context={context} bareHeader bareFooter>
  <div class="mav">

    <!-- ================= HERO ================= -->
    <section class="mav-hero">
      <div class="mav-hero__copy">
        <h1 set:html={headingHtml} />
        <AuthorByline authorId={context.author} updated={context.lastUpdated} />
        <p class="mav-lede">{c.page.summary}</p>
      </div>
      <div class="mav-hero__media">
        <img
          src="/pictures/medicarevernal.webp"
          alt={c.hero.imgAlt}
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </section>

    <!-- ================= TRUST STRIP ================= -->
    <ul class="mav-trust">
      {c.trust.map((item) => (
        <li class={`mav-trust__item mav-trust__item--${item.icon}`}>
          <span class="mav-trust__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[item.icon] ?? ''} />
          </span>
          <div>
            <strong>{item.title}</strong>
            <span>{item.text}</span>
          </div>
        </li>
      ))}
    </ul>

    <!-- ================= GOOD FIT ================= -->
    <section class="mav-callout">
      <span class="mav-callout__ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="9" r="5"/><path d="M8.5 13.5L7 22l5-2.6L17 22l-1.5-8.5"/>
        </svg>
      </span>
      <div>
        <h2>{b.h2What}</h2>
        <p set:html={b.whatHtml} />
      </div>
    </section>

    <!-- ================= HMO / PPO ================= -->
    <section class="mav-section">
      <h2 class="mav-h2">
        <span class="mav-h2__ic mav-h2__ic--blue" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3 19c0-3 2.7-5 6-5s6 2 6 5"/><path d="M15.5 19c0-2.2 1.6-3.6 3.5-3.6s2.5 1 2.5 2.6"/>
          </svg>
        </span>
        {b.h2Types}
      </h2>

      <div class="mav-plans">
        <article class="mav-plan mav-plan--hmo">
          <h3>{b.h3Hmo}</h3>
          <p set:html={b.hmoHtml} />
          <p class="mav-plan__fit">
            <span class="mav-plan__tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
            </span>
            {b.hmoFit}
          </p>
        </article>

        <article class="mav-plan mav-plan--ppo">
          <h3>{b.h3Ppo}</h3>
          <p set:html={b.ppoHtml} />
          <p class="mav-plan__fit">
            <span class="mav-plan__tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
            </span>
            {b.ppoFit}
          </p>
        </article>
      </div>
    </section>

    <!-- ================= $0 PREMIUM ================= -->
    <section class="mav-zero">
      <span class="mav-zero__badge" aria-hidden="true">$0</span>
      <div class="mav-zero__copy">
        <h2>{b.h2Zero}</h2>
        <p set:html={b.zeroHtml} />
      </div>
      <span class="mav-zero__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3l7 3v5.5c0 4.3-2.9 8.2-7 9.5-4.1-1.3-7-5.2-7-9.5V6z"/><path d="M9 12l2 2 4-4"/>
        </svg>
      </span>
    </section>

    <!-- ================= HOW TO COMPARE ================= -->
    <section class="mav-section mav-compare">
      <div class="mav-compare__copy">
        <h2 class="mav-h2">
          <span class="mav-h2__ic mav-h2__ic--navy" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3v18"/><path d="M3 8h18"/><path d="M6 8l-3 6h6zM18 8l-3 6h6z"/>
            </svg>
          </span>
          {b.h2Compare}
        </h2>
        <p set:html={b.compareHtml} />
        <p class="mav-compare__btns">
          <a class="mav-btn mav-btn--outline" href={ENROLL_URL} target="_blank" rel="noopener noreferrer" set:html={b.enrollLabel} />
        </p>
      </div>
      <span class="mav-compare__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="3" width="13" height="18" rx="2"/><path d="M9 3.5h3a1 1 0 0 1 1 1V6H8V4.5a1 1 0 0 1 1-1z"/>
          <path d="M7.5 11l1.5 1.5 3-3M7.5 16l1.5 1.5 3-3"/><circle cx="18" cy="17" r="4"/><path d="M21 20l2 2"/>
        </svg>
      </span>
    </section>

    <!-- ================= RURAL UTAH ================= -->
    <section class="mav-rural">
      <span class="mav-rural__ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3.5l2.5 5.1 5.6.8-4 3.9 1 5.6-5.1-2.7-5.1 2.7 1-5.6-4-3.9 5.6-.8z"/></svg>
      </span>
      <div>
        <h2>{b.h2Rural}</h2>
        <p set:html={b.ruralHtml} />
        <p class="mav-rural__links" set:html={b.compareLinksHtml} />
      </div>
    </section>

    <p class="mav-source" set:html={b.sourceHtml} />

    <!-- ================= FAQ ================= -->
    <section class="mav-faq" aria-label={b.faqHeading}>
      <h2 class="mav-h2">
        <span class="mav-h2__ic mav-h2__ic--amber" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/><path d="M9.5 9.2A2.6 2.6 0 0 1 14.5 10c0 1.7-2.5 2-2.5 3.5"/><path d="M12 17h.01"/>
          </svg>
        </span>
        {b.faqHeading}
      </h2>
      {c.page.faqs.map((f) => (
        <details>
          <summary set:html={f.question} />
          <div class="faq-answer" set:html={f.answer} />
        </details>
      ))}
    </section>

    <!-- ================= RELATED ================= -->
    {related.length > 0 && (
      <nav class="mav-related" aria-label={b.relatedHeading}>
        <h2 class="mav-h2">
          <span class="mav-h2__ic mav-h2__ic--purple" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a4 4 0 0 0 5.7.4l2.6-2.6a4 4 0 0 0-5.7-5.7L11.2 6.5"/>
              <path d="M14 11a4 4 0 0 0-5.7-.4l-2.6 2.6a4 4 0 0 0 5.7 5.7l1.4-1.4"/>
            </svg>
          </span>
          {b.relatedHeading}
        </h2>
        <ul>
          {related.map((r) => (
            <li>
              <a href={localizeHref(r.href, lang)}>{r.label}</a>
              {r.blurb && <span> — {r.blurb}</span>}
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- ================= CTA BAND ================= -->
    <section class="mav-cta">
      <span class="mav-cta__ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 6.1 6.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2z"/>
        </svg>
      </span>
      <div class="mav-cta__copy">
        <h2>{b.ctaHeading}</h2>
        <p>{b.ctaText}</p>
        <p class="mav-cta__btns">
          <a class="mav-btn mav-btn--primary" href={tel}>{b.ctaCall}</a>
          <a class="mav-btn mav-btn--light" href={localizeHref('/medicare-quote-vernal.html', lang)}>{b.ctaQuote}</a>
        </p>
      </div>
      <ul class="mav-cta__points">
        {c.ctaPoints.map((p) => <li>{p}</li>)}
      </ul>
    </section>

  </div>
</ArticlePage>

<style>
  /* ============ Medicare Advantage pillar (scoped) ============ */
  .mav {
    --navy: #12395c;
    --navy-2: #0b2c45;
    --ink: #223140;
    --muted: #5a6b7b;
    --line: #e3eaf1;
    --blue: #1668b5;
    --red: #d02c2c;
    --green: #0f8a4d;
    --amber: #e2900c;
    --purple: #6d3fd1;
    --wash: #f5f9fc;
    color: var(--ink);
    line-height: 1.6;
  }
  .mav * { box-sizing: border-box; }
  .mav section { margin: 2.6rem 0; }
  .mav p { margin: 0 0 .9rem; }
  .mav p:last-child { margin-bottom: 0; }

  /* :global() because several link sets arrive through set:html and therefore
     never receive Astro's scope attribute. */
  .mav :global(a:not(.mav-btn)) {
    color: var(--blue);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .mav :global(a:not(.mav-btn):hover) { color: var(--red); }

  /* ---------- Section headings ---------- */
  .mav .mav-h2 {
    display: flex; align-items: center; gap: .7rem;
    font-size: clamp(1.25rem, 1rem + .9vw, 1.6rem);
    color: var(--navy); line-height: 1.25; margin: 0 0 1rem;
  }
  .mav .mav-h2__ic {
    flex: none; display: grid; place-items: center;
    width: 42px; height: 42px; border-radius: 50%;
  }
  .mav .mav-h2__ic svg { width: 22px; height: 22px; }
  .mav .mav-h2__ic--blue { background: #e7f0fa; color: var(--blue); }
  .mav .mav-h2__ic--navy { background: #e7eef6; color: var(--navy); }
  .mav .mav-h2__ic--amber { background: #fdf1dc; color: var(--amber); }
  .mav .mav-h2__ic--purple { background: #efe9fc; color: var(--purple); }

  /* ---------- Buttons ---------- */
  .mav .mav-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .45rem;
    padding: .8rem 1.3rem; border-radius: 10px; font-weight: 700; font-size: 1rem;
    line-height: 1.15; text-decoration: none; border: 2px solid transparent;
    transition: transform .12s ease, box-shadow .12s ease, background .2s ease;
  }
  .mav .mav-btn:hover { transform: translateY(-1px); }
  .mav .mav-btn--primary { background: var(--red); color: #fff; box-shadow: 0 8px 18px rgba(208,44,44,.28); }
  .mav .mav-btn--light { background: transparent; color: #fff; border-color: rgba(255,255,255,.6); }
  .mav .mav-btn--outline { background: #fff; color: var(--navy); border-color: var(--line); box-shadow: 0 4px 12px rgba(18,57,92,.08); }
  .mav .mav-btn--outline:hover { border-color: var(--blue); color: var(--blue); }

  /* ---------- HERO ---------- */
  .mav-hero {
    display: grid; grid-template-columns: 1.05fr .95fr; gap: 2rem; align-items: center;
    margin-top: .5rem !important;
  }
  .mav-hero h1 {
    font-size: clamp(1.9rem, 1.2rem + 2.4vw, 3rem);
    line-height: 1.1; color: var(--navy); margin: 0 0 .6rem; letter-spacing: -.01em;
  }
  .mav-hero .mav-year { color: var(--red); }
  .mav-hero :global(.byline) {
    font-size: .88rem; color: var(--muted); margin: 0 0 1rem;
  }
  .mav-lede { font-size: 1.05rem; color: #3d4d5c; max-width: 34em; }
  .mav-hero__media img {
    width: 100%; height: auto; display: block;
    border-radius: 16px; box-shadow: 0 18px 40px rgba(18,57,92,.18);
  }

  /* ---------- TRUST STRIP ---------- */
  .mav-trust {
    list-style: none; margin: 2.2rem 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .mav-trust__item {
    display: flex; align-items: center; gap: .8rem;
    padding: 1.1rem 1.2rem;
  }
  .mav-trust__item + .mav-trust__item { border-left: 1px solid var(--line); }
  .mav-trust__ic {
    flex: none; display: grid; place-items: center;
    width: 46px; height: 46px; border-radius: 50%;
  }
  .mav-trust__ic svg { width: 23px; height: 23px; }
  .mav-trust__item--stethoscope .mav-trust__ic { background: #e7f0fa; color: var(--blue); }
  .mav-trust__item--heart .mav-trust__ic { background: #fdeaea; color: var(--red); }
  .mav-trust__item--dollar .mav-trust__ic { background: #e5f5ec; color: var(--green); }
  .mav-trust__item--shield .mav-trust__ic { background: #e7eef6; color: var(--navy); }
  .mav-trust__item strong { display: block; color: var(--navy); font-size: .98rem; line-height: 1.25; }
  .mav-trust__item span { display: block; color: var(--muted); font-size: .86rem; line-height: 1.35; }

  /* ---------- GOOD-FIT CALLOUT ---------- */
  .mav-callout {
    display: flex; gap: 1.2rem; align-items: flex-start;
    background: #fff; border: 1px solid var(--line); border-left: 5px solid var(--red);
    border-radius: 12px; padding: 1.4rem 1.5rem;
    box-shadow: 0 10px 26px rgba(18,57,92,.07);
  }
  .mav-callout__ic {
    flex: none; display: grid; place-items: center;
    width: 54px; height: 54px; border-radius: 50%;
    background: var(--red); color: #fff;
  }
  .mav-callout__ic svg { width: 27px; height: 27px; }
  .mav-callout h2 { font-size: 1.25rem; color: var(--navy); margin: .15rem 0 .5rem; line-height: 1.3; }

  /* ---------- HMO / PPO ---------- */
  .mav-plans { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .mav-plan {
    background: #fff; border: 1px solid var(--line); border-radius: 12px;
    padding: 1.3rem 1.4rem;
  }
  .mav-plan h3 { font-size: 1.15rem; margin: 0 0 .6rem; }
  .mav-plan--hmo { background: #f6faff; }
  .mav-plan--hmo h3 { color: var(--blue); }
  .mav-plan--ppo { background: #fff8f8; }
  .mav-plan--ppo h3 { color: var(--red); }
  .mav-plan__fit {
    display: flex; gap: .55rem; align-items: flex-start;
    margin: 1rem 0 0; padding: .7rem .85rem; border-radius: 9px;
    font-size: .94rem; font-weight: 600;
  }
  .mav-plan__tick { flex: none; }
  .mav-plan__tick svg { width: 19px; height: 19px; display: block; }
  .mav-plan--hmo .mav-plan__fit { background: #e7f0fa; color: #10456f; }
  .mav-plan--ppo .mav-plan__fit { background: #fdeaea; color: #8f1f1f; }

  /* ---------- $0 PREMIUM ---------- */
  .mav-zero {
    position: relative; overflow: hidden;
    display: flex; gap: 1.3rem; align-items: flex-start;
    background: linear-gradient(180deg, #f2fbf6, #eaf7f0);
    border: 1px solid #cfe9db; border-radius: 14px; padding: 1.5rem 1.6rem;
  }
  .mav-zero__badge {
    flex: none; display: grid; place-items: center;
    width: 64px; height: 64px; border-radius: 50%;
    background: var(--green); color: #fff;
    font-weight: 800; font-size: 1.35rem; letter-spacing: -.02em;
  }
  .mav-zero__copy { position: relative; z-index: 1; max-width: 46em; }
  .mav-zero h2 { font-size: 1.25rem; color: #0c6d3e; margin: .5rem 0 .55rem; line-height: 1.3; }
  .mav-zero__mark {
    position: absolute; right: -12px; bottom: -22px; color: #bfe3d0; opacity: .55;
    pointer-events: none;
  }
  .mav-zero__mark svg { width: 128px; height: 128px; display: block; }

  /* ---------- HOW TO COMPARE ---------- */
  .mav-compare { position: relative; display: flex; gap: 1.5rem; align-items: center; }
  .mav-compare__copy { flex: 1 1 auto; }
  .mav-compare__btns { margin-top: 1.1rem !important; }
  .mav-compare__mark { flex: none; color: #b9cee1; }
  .mav-compare__mark svg { width: 118px; height: 118px; display: block; }

  /* ---------- RURAL UTAH ---------- */
  .mav-rural {
    display: flex; gap: 1.2rem; align-items: flex-start;
    background: #fffaf0; border: 1px solid #f4e2bd; border-radius: 12px;
    padding: 1.4rem 1.5rem;
  }
  .mav-rural__ic {
    flex: none; display: grid; place-items: center;
    width: 48px; height: 48px; border-radius: 50%;
    background: var(--amber); color: #fff;
  }
  .mav-rural__ic svg { width: 26px; height: 26px; }
  .mav-rural h2 { font-size: 1.2rem; color: #a9700a; margin: .3rem 0 .55rem; line-height: 1.3; }
  .mav-rural__links { font-size: .95rem; }

  /* ---------- SOURCE ---------- */
