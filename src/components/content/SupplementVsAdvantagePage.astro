---
// src/components/content/SupplementVsAdvantagePage.astro — the Medigap-vs-
// Advantage comparison template (M4; playbook §4.5). Rendered by BOTH
// /medicare-supplement-vs-advantage.html and its /es/ sibling.
// DATA-LAYER PATTERN: the annual Part B deductible comes from figuresFor()/usd
// and is interpolated into the copy via the {partBDeductible} placeholder —
// figures stay in the data layer, never in translated JSON.
// PRESENTATION NOTE: this page has no <main> ancestor, so every `main …` rule
// in styles.css is inert here. The scoped block at the bottom supplies the
// card/callout language the shared .faq/.related/.page-cta sections already
// use (white cards, #e2e9f1 borders, navy #0b2c45, red #dc3545 accents), so
// the body reads as one piece with the chrome above and below it. Every
// selector is nested under .sva — this component's CSS ships inside the
// shared /es/ route bundle, so nothing may leak past the wrapper.
import ArticlePage from '../layout/ArticlePage.astro';
import { figuresFor } from '../../data/annualMedicareData';
import { usd } from '../../lib/formatters';
import { getPageContent, interp, hreflangAlternates, localizeHref, SITE_ORIGIN } from '../../i18n/content';
import { getLangFromUrl, getLocaleMeta } from '../../i18n/locales';
import type { PageContext } from '../../types/Page';

const SLUG = 'medicare-supplement-vs-advantage';
const f = figuresFor();
const vars = { partBDeductible: usd(f.partB.deductible) };

interface Content {
  page: {
    title: string;
    heading: string;
    description: string;
    summary: string;
    faqs: { question: string; answer: string }[];
  };
  meta: { ogTitle: string; ogDescription: string };
  breadcrumb: { home: string; self: string };
  sources: { title: string; url: string; publisher: string }[];
  body: {
    quickSummaryHtml: string;
    biggerPictureHtml: string;
    introHtml: string;
    h2Medigap: string;
    medigapIntroHtml: string;
    medigapItemsHtml: string[];
    medigapOutroHtml: string;
    h2Advantage: string;
    advantageIntroHtml: string;
    advantageItemsHtml: string[];
    h2Table: string;
    tableHeadMedigap: string;
    tableHeadAdvantage: string;
    tableRows: { label: string; medigap: string; advantage: string }[];
    h2Rural: string;
    ruralHtml1: string;
    ruralHtml2: string;
    h2Switching: string;
    switchingHtml1: string;
    switchingHtml2: string;
    switchingHtml3: string;
    h2Help: string;
    helpHtml1: string;
    helpHtml2: string;
    callCtaLabel: string;
    sourcesHeading: string;
    sourcesNote: string;
    relatedHeading: string;
    relatedItemsHtml: string[];
  };
}

const lang = getLangFromUrl(Astro.url);
const c = getPageContent<Content>(SLUG, lang);
const b = c.body;
const pagePath = lang === 'en' ? `/${SLUG}.html` : `/${lang}/${SLUG}.html`;

const context: PageContext = {
  page: {
    title: c.page.title,
    heading: c.page.heading,
    description: c.page.description,
    taxonomy: { silo: 'medigap', tags: ['medigap', 'advantage', 'comparison', 'original-medicare'] },
    summary: c.page.summary,
    sources: c.sources,
    faqs: c.page.faqs,
  },
  meta: {
    canonical: `${SITE_ORIGIN}${pagePath}`,
    ogType: 'article',
    ogTitle: c.meta.ogTitle,
    ogDescription: c.meta.ogDescription,
    lang,
    ogLocale: getLocaleMeta(lang).ogLocale,
    hreflang: hreflangAlternates(SLUG),
  },
  author: 'rocco',
  datePublished: '2026-03-27',
  lastUpdated: '2026-07-01',
  breadcrumb: [
    { name: c.breadcrumb.home, href: localizeHref('/', lang) },
    { name: c.breadcrumb.self, href: pagePath },
  ],
};
---

<ArticlePage context={context}>
  <div class="sva">
    {/* Page-local chrome polish — breadcrumb · H1 · byline · standfirst.
        StandardPageLayout renders those four, and styles.css has no rule for
        any of them (the article has no <main> ancestor, so the `main …` block
        never reaches them) — which is why the breadcrumb renders as a numbered
        list. Kept `is:inline` so it ships with THIS page only and no other
        page's appearance changes mid-measurement; promote it verbatim into
        styles.css when a site-wide chrome pass is wanted. */}
    <style is:inline>
      .page > .breadcrumbs { margin: 0 0 1.35rem; font-size: 0.9rem; }
      .page > .breadcrumbs ol {
        list-style: none; margin: 0; padding: 0;
        display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
      }
      .page > .breadcrumbs li { display: flex; align-items: center; gap: 0.5rem; }
      .page > .breadcrumbs li + li::before { content: "\203A"; color: #a8b8c9; font-weight: 700; }
      .page > .breadcrumbs a { color: #55627a; font-weight: 600; text-decoration: none; }
      .page > .breadcrumbs a:hover { color: #dc3545; text-decoration: underline; }
      .page > .breadcrumbs [aria-current="page"] { color: #0b2c45; font-weight: 700; }

      .page > .page-header {
        margin: 0 0 1.5rem;
        padding-bottom: 1.15rem;
        border-bottom: 1px solid #e2e9f1;
      }
      .page > .page-header h1 {
        color: #0b2c45;
        font-size: clamp(1.75rem, 1.15rem + 2.1vw, 2.6rem);
        line-height: 1.18;
        letter-spacing: -0.02em;
        margin: 0 0 0.65rem;
      }
      .page > .page-header .byline { margin: 0; font-size: 0.92rem; line-height: 1.65; color: #55627a; }
      .page > .page-header .byline a { color: #0b6ea3; font-weight: 600; text-decoration: none; }
      .page > .page-header .byline a:hover { color: #dc3545; text-decoration: underline; }

      .page > .summary-block { margin: 0 0 1.8rem; }
      .page > .summary-block p { margin: 0; font-size: 1.18rem; line-height: 1.7; color: #43526b; }
    </style>

    {/* AI-First Summary Block */}
    <aside class="sva-key">
      <span class="sva-key-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2.5 3.8 6v5.4c0 4.6 3.3 8.9 8.2 10.1 4.9-1.2 8.2-5.5 8.2-10.1V6Z" />
          <path d="m8.6 12.1 2.3 2.3 4.5-4.6" />
        </svg>
      </span>
      <p set:html={b.quickSummaryHtml} />
    </aside>

    <aside class="sva-guide">
      <span class="sva-guide-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9.2" />
          <path d="m15.6 8.4-2 5.2-5.2 2 2-5.2Z" />
        </svg>
      </span>
      <p set:html={b.biggerPictureHtml} />
    </aside>

    <p class="sva-lead" set:html={b.introHtml} />

    <div class="sva-duo">
      <section class="sva-card sva-card--gap">
        <div class="sva-head">
          <span class="sva-head-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2.5 3.8 6v5.4c0 4.6 3.3 8.9 8.2 10.1 4.9-1.2 8.2-5.5 8.2-10.1V6Z" />
              <path d="M12 8.2v7.6M8.2 12h7.6" />
            </svg>
          </span>
          <h2>{b.h2Medigap}</h2>
        </div>

        <p set:html={b.medigapIntroHtml} />

        <ul class="sva-list">
          {b.medigapItemsHtml.map((item) => <li set:html={interp(item, vars)} />)}
        </ul>

        <p class="sva-note" set:html={b.medigapOutroHtml} />
      </section>

      <section class="sva-card sva-card--adv">
        <div class="sva-head">
          <span class="sva-head-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.5 8.2 12 3.6l8.5 4.6v7.6L12 20.4l-8.5-4.6Z" />
              <path d="M3.5 8.2 12 12.8l8.5-4.6M12 12.8v7.6" />
            </svg>
          </span>
          <h2>{b.h2Advantage}</h2>
        </div>

        <p set:html={b.advantageIntroHtml} />

        <ul class="sva-list">
          {b.advantageItemsHtml.map((item) => <li set:html={item} />)}
        </ul>
      </section>
    </div>

    <section class="sva-section">
      <div class="sva-head">
        <span class="sva-head-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3.4v17.2M4.4 7.2h15.2" />
            <path d="M7.6 7.2 4.4 13.6h6.4ZM16.4 7.2l-3.2 6.4h6.4Z" />
            <path d="M9 20.6h6" />
          </svg>
        </span>
        <h2>{b.h2Table}</h2>
      </div>

      <div class="sva-table-wrap">
        <table class="sva-table">
          <thead>
            <tr>
              <th scope="col" class="sva-col-label"></th>
              <th scope="col" class="sva-col-gap">{b.tableHeadMedigap}</th>
              <th scope="col" class="sva-col-adv">{b.tableHeadAdvantage}</th>
            </tr>
          </thead>
          <tbody>
            {b.tableRows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td data-label={b.tableHeadMedigap}>{row.medigap}</td>
                <td data-label={b.tableHeadAdvantage}>{row.advantage}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sva-section">
      <div class="sva-head">
        <span class="sva-head-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21.4s6.6-5.4 6.6-11a6.6 6.6 0 1 0-13.2 0c0 5.6 6.6 11 6.6 11Z" />
            <circle cx="12" cy="10.2" r="2.5" />
          </svg>
        </span>
        <h2>{b.h2Rural}</h2>
      </div>

      <p set:html={b.ruralHtml1} />

      <p set:html={b.ruralHtml2} />
    </section>

    <section class="sva-section sva-section--alert">
      <div class="sva-head">
        <span class="sva-head-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3.6 21 19.4H3Z" />
            <path d="M12 9.6v4.2M12 16.9h.01" />
          </svg>
        </span>
        <h2>{b.h2Switching}</h2>
      </div>

      <p set:html={b.switchingHtml1} />

      <p class="sva-flag" set:html={b.switchingHtml2} />

      <p set:html={b.switchingHtml3} />
    </section>

    <section class="sva-section sva-section--help">
      <div class="sva-head">
        <span class="sva-head-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8.4" r="3.6" />
            <path d="M4.8 20.4a7.2 7.2 0 0 1 14.4 0" />
          </svg>
        </span>
        <h2>{b.h2Help}</h2>
      </div>

      <p set:html={b.helpHtml1} />

      <p set:html={b.helpHtml2} />

      <p class="sva-cta">
        <a href="tel:+14352195120" class="btn sva-btn">{b.callCtaLabel}</a>
      </p>
    </section>

    {/* Sources — `sources` in the class is the editorial-completeness contract
        marker (scripts/seo/sources.mjs). Keep it if this block is restyled. */}
    <section class="sva-section sva-sources">
      <div class="sva-head">
        <span class="sva-head-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" /><path d="M3 12h18" />
            <path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z" />
          </svg>
        </span>
        <h2>{b.sourcesHeading}</h2>
      </div>
      <ul>
        {c.sources.map((src) => (
          <li>
            <a href={src.url} target="_blank" rel="noopener noreferrer">{src.title}</a> — {src.publisher}
          </li>
        ))}
      </ul>
      <p class="sva-sources__note">{b.sourcesNote}</p>
    </section>

    {/* Related Articles */}
    <section class="sva-section sva-related">
      <div class="sva-head">
        <span class="sva-head-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13.6a3.6 3.6 0 0 0 5.4.4l2.6-2.6a3.6 3.6 0 0 0-5.1-5.1l-1.5 1.5" />
            <path d="M14 10.4a3.6 3.6 0 0 0-5.4-.4L6 12.6a3.6 3.6 0 0 0 5.1 5.1l1.5-1.5" />
          </svg>
        </span>
        <h2>{b.relatedHeading}</h2>
      </div>
      <ul>
        {b.relatedItemsHtml.map((item) => <li set:html={item} />)}
      </ul>
    </section>
  </div>
</ArticlePage>

<style>
  /* ---------------------------------------------------------------------
     Medigap-vs-Advantage body. Palette mirrors the shared chrome:
       navy #0b2c45 · border #e2e9f1 · red #dc3545 · muted copy #43526b
     Two comparison hues carry the whole page — Medigap blue (#0b6ea3, the
     same head colour the Medigap page table uses) vs Advantage teal
     (#0e7c66) — so the cards, the list ticks and the table columns agree.
     --------------------------------------------------------------------- */
  .sva {
    --gap-hue: #0b6ea3;
    --gap-soft: #eaf4fb;
    --adv-hue: #0e7c66;
    --adv-soft: #e7f4f1;
    --navy: #0b2c45;
    --line: #e2e9f1;
    --copy: #43526b;
    --shadow: 0 2px 14px rgba(11, 44, 69, 0.06);
    --shadow-lift: 0 14px 32px rgba(11, 44, 69, 0.12);
    color: var(--copy);
  }

  /* Typography — the page has no <main>, so nothing else sets these. */
  .sva :global(p) {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--copy);
    margin: 0 0 1rem;
  }
  .sva :global(p:last-child) { margin-bottom: 0; }
  .sva :global(strong) { color: var(--navy); font-weight: 700; }

  .sva h2 {
    color: var(--navy);
    font-size: clamp(1.3rem, 1.05rem + 1vw, 1.7rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    font-weight: 800;
    margin: 0;
    display: block;
  }
  .sva h2::after { display: none; } /* kill the global orange underline */

  .sva :global(a) {
    color: var(--gap-hue);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(11, 110, 163, 0.32);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .sva :global(a:hover),
  .sva :global(a:focus) { color: #dc3545; border-bottom-color: #dc3545; }

  /* ---- Section head (icon tile + H2) ---------------------------------- */
  .sva-head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0 0 1.1rem;
  }
  .sva-head-icon {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    background: var(--gap-soft);
    color: var(--gap-hue);
  }
  .sva-head-icon svg { width: 25px; height: 25px; }

  /* ---- Quick summary (the AI-pullable TL;DR) -------------------------- */
  .sva-key {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin: 0 0 1.25rem;
    padding: 1.4rem 1.6rem;
    border-radius: 16px;
    border: 1px solid #d3e2f0;
    border-left: 6px solid var(--navy);
    background: linear-gradient(135deg, #f4f9fd 0%, #eaf3fa 100%);
    box-shadow: var(--shadow);
  }
  .sva-key-icon {
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--navy);
    color: #fff;
  }
  .sva-key-icon svg { width: 23px; height: 23px; }
  .sva-key :global(p) { font-size: 1.08rem; color: #2c3c53; }

  /* ---- "Bigger picture" hub link -------------------------------------- */
  .sva-guide {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    margin: 0 0 1.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fff;
    box-shadow: var(--shadow);
  }
  .sva-guide-icon {
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    background: var(--gap-soft);
    color: var(--gap-hue);
  }
  .sva-guide-icon svg { width: 22px; height: 22px; }
  .sva-guide :global(p) { font-size: 1rem; }

  /* ---- Lead paragraph -------------------------------------------------- */
  .sva :global(.sva-lead) {
    max-width: 74ch;
    margin: 0 0 2rem;
    font-size: 1.2rem;
    line-height: 1.7;
    color: #2c3c53;
  }

  /* ---- The two "how it works" cards, side by side ---------------------- */
  .sva-duo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 1.4rem;
    margin: 0 0 2.25rem;
    align-items: stretch;
  }

  .sva-card,
  .sva-section {
    position: relative;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1.6rem 1.7rem;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .sva-section { margin: 0 0 1.6rem; }

  .sva-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 5px;
    background: var(--accent, var(--navy));
  }
  .sva-card--gap { --accent: var(--gap-hue); }
  .sva-card--adv { --accent: var(--adv-hue); }
  .sva-card--adv .sva-head-icon { background: var(--adv-soft); color: var(--adv-hue); }

  /* ---- Tick lists ------------------------------------------------------ */
  .sva-list {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .sva-list li {
    position: relative;
    padding-left: 2.2rem;
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--copy);
  }
  .sva-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.22em;
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 50%;
    background: var(--tick-soft, var(--gap-soft));
  }
  .sva-list li::after {
    content: "";
    position: absolute;
    left: 0.53rem;
    top: 0.5em;
    width: 0.34rem;
    height: 0.66rem;
    border: solid var(--tick, var(--gap-hue));
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg);
  }
  .sva-card--adv .sva-list { --tick: var(--adv-hue); --tick-soft: var(--adv-soft); }

  /* Closing "what this means locally" note under the Medigap list */
  .sva :global(.sva-note) {
    margin: 1.3rem 0 0;
    padding: 0.9rem 1.1rem;
    border-radius: 12px;
    background: var(--gap-soft);
    border-left: 4px solid var(--gap-hue);
    font-size: 1rem;
    color: #2c4257;
  }

  /* ---- Comparison table ------------------------------------------------ */
  .sva-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 14px;
    -webkit-overflow-scrolling: touch;
  }
  .sva-table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    font-size: 1rem;
    background: #fff;
  }
  .sva-table thead th {
    background: var(--navy);
    color: #fff;
    text-align: left;
    font-size: 0.97rem;
    font-weight: 700;
    padding: 0.95rem 1.1rem;
    white-space: nowrap;
  }
  .sva-table thead .sva-col-gap { box-shadow: inset 0 -4px 0 var(--gap-hue); }
  .sva-table thead .sva-col-adv { box-shadow: inset 0 -4px 0 var(--adv-hue); }
  .sva-table tbody th {
    text-align: left;
    font-weight: 700;
    color: var(--navy);
    background: #f6fafd;
    padding: 0.9rem 1.1rem;
    border-top: 1px solid #e8eef5;
    vertical-align: top;
    width: 21%;
  }
  .sva-table tbody td {
    padding: 0.9rem 1.1rem;
    border-top: 1px solid #e8eef5;
    color: var(--copy);
    vertical-align: top;
    line-height: 1.55;
  }
  .sva-table tbody tr:hover th { background: #eef5fb; }
  .sva-table tbody tr:hover td { background: #f7fbfe; }

  /* ---- Switching-trap warning ------------------------------------------ */
  .sva-section--alert {
    border-left: 6px solid #dc3545;
    background: linear-gradient(180deg, #fffaf9 0%, #ffffff 55%);
  }
  .sva-section--alert .sva-head-icon { background: #fdeaec; color: #dc3545; }
  .sva :global(.sva-flag) {
    padding: 0.95rem 1.15rem;
    border-radius: 12px;
    background: #fdf1f2;
    border-left: 4px solid #dc3545;
    color: #6b2b32;
  }
  .sva :global(.sva-flag strong) { color: #8f1d28; }

  /* ---- Talk-to-Rocco block --------------------------------------------- */
  .sva-section--help {
    background: linear-gradient(135deg, #f6fbff 0%, #eef6fc 100%);
    border-color: #d3e2f0;
  }
  .sva :global(.sva-cta) {
    text-align: center;
    margin: 1.6rem 0 0.2rem;
  }
