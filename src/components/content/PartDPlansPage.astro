---
// src/components/content/PartDPlansPage.astro — Part D pillar-adjacent
// template (M4; playbook §4.5). Rendered by BOTH /part-d-plans-vernal.html
// and its /es/ sibling; copy from src/i18n/content/{locale}/part-d-plans-vernal.json.
//
// Design (M45): rebuilt from a plain article into the money-page layout used by
// the costs / help-center hubs — a split hero (H1 + byline + lede | Vernal
// photo), a two-column body with icon-badged sections and a sticky agent card,
// an FAQ accordion, a "Related Helpful Resources" card grid, and a navy CTA
// banner. bareHeader + bareFooter: this component owns the whole page. Schema
// (Article + FAQPage + breadcrumb) is still assembled from `context`, so the
// structured data is unchanged by the redesign.
//
// LINKS: internal links stay relative IN THE CONTENT JSON — getPageContent()
// rewrites them per locale. Any href written directly in this markup must go
// through localizeHref(…, lang).
import ArticlePage from '../layout/ArticlePage.astro';
import AuthorByline from './AuthorByline.astro';
import SummaryBlock from '../SummaryBlock.astro';
import { BUSINESS } from '../../data/business';
import { authorById } from '../../data/authors';
import { PAGE_INDEX } from '../../data/pageIndex';
import { relatedFor } from '../../lib/related';
import { getPageContent, interp, hreflangAlternates, localizeHref, SITE_ORIGIN } from '../../i18n/content';
import { getLangFromUrl, getLocaleMeta, t } from '../../i18n/locales';
import type { PageContext } from '../../types/Page';

const SLUG = 'part-d-plans-vernal';

interface KeyPoint { title: string; html: string }
interface TableData { caption: string; cols: string[]; rows: string[][] }
interface Definition { term: string; def: string }
interface Content {
  page: {
    title: string;
    heading: string;
    description: string;
    summary: string;
    faqs: { question: string; answer: string }[];
  };
  breadcrumb: { home: string; self: string };
  table: TableData;
  definitions: Definition[];
  body: Record<string, string | string[] | KeyPoint[]> & {
    keyPoints: KeyPoint[];
    relatedItemsHtml: string[];
  };
  ui: {
    heroImageAlt: string;
    agentHeading: string;
    agentRole: string;
    agentPoints: string[];
    textBtn: string;
    faqHeading: string;
    resourcesHeading: string;
    moreHeading: string;
    ctaTitle: string;
    ctaSub: string;
    ctaCall: string;
    ctaQuote: string;
  };
}

const lang = getLangFromUrl(Astro.url);
const c = getPageContent<Content>(SLUG, lang);
const b = c.body;
const ui = c.ui;
const vars = { phone: BUSINESS.phone, tty: BUSINESS.tty, email: BUSINESS.email };
const t9 = (s: string) => interp(s, vars);
const pagePath = lang === 'en' ? `/${SLUG}.html` : `/${lang}/${SLUG}.html`;

const context: PageContext = {
  page: {
    title: c.page.title,
    heading: c.page.heading,
    description: c.page.description,
    taxonomy: {
      silo: 'part-d',
      tags: ['part-d', 'plan-comparison', 'drugs', 'vernal', 'uintah-county', 'local'],
    },
    summary: c.page.summary,
    faqs: c.page.faqs,
  },
  meta: {
    canonical: `${SITE_ORIGIN}${pagePath}`,
    ogType: 'article',
    gaIds: ['G-NW6ENB89NF', 'G-FTDW9B2G6Q'],
    lang,
    ogLocale: getLocaleMeta(lang).ogLocale,
    hreflang: hreflangAlternates(SLUG),
  },
  author: 'rocco',
  datePublished: '2026-04-04',
  lastUpdated: '2026-07-01',
  marketingDisclaimer: true,
  breadcrumb: [
    { name: c.breadcrumb.home, href: localizeHref('/', lang) },
    { name: c.breadcrumb.self, href: pagePath },
  ],
};

// Trailing year in the H1 renders in the brand red ("… Vernal, Utah 2026").
const headMatch = c.page.heading.match(/^(.*?)\s(\d{4})\s*$/);
const headLead = headMatch ? headMatch[1] : c.page.heading;
const headYear = headMatch ? headMatch[2] : '';

const agent = authorById('rocco');
const agentName = agent?.name ?? BUSINESS.legalAgent;
const phoneHref = `tel:${BUSINESS.phoneTel}`;
const smsHref = `sms:${BUSINESS.smsTel}?&body=${encodeURIComponent(t('contactFab.smsBody', lang, { agent: agentName }))}`;

// bareFooter drops the framework's RelatedPages, so compute the same top-4 here
// and render them as cards. Exclude the English href — that is the index key.
const related = relatedFor(context.page.taxonomy, PAGE_INDEX, `/${SLUG}.html`);

const CARD_STYLE = [
  { accent: '#2563eb', tint: '#eaf1fe', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M10.6 3.4 3.4 10.6a5 5 0 0 0 7.1 7.1l7.1-7.1a5 5 0 1 0-7-7.1z"/><path d="M7 7l7 7"/></svg>' },
  { accent: '#16a34a', tint: '#e6f6ec', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 12.4 12.4 20.6a2 2 0 0 1-2.8 0l-6.2-6.2a2 2 0 0 1-.6-1.4V4.5a2 2 0 0 1 2-2h8.5a2 2 0 0 1 1.4.6l5.9 5.9a2 2 0 0 1 0 2.8z"/><circle cx="7.8" cy="7.8" r="1.3" fill="currentColor" stroke="none"/></svg>' },
  { accent: '#d97706', tint: '#fdf2e0', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"/><rect x="8" y="6" width="8" height="3" rx="0.6"/><path d="M8.5 13h.01M12 13h.01M15.5 13h.01M8.5 16.5h.01M12 16.5h.01M15.5 16.5v2"/></svg>' },
  { accent: '#7c3aed', tint: '#f2ebfd', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5"/><circle cx="11.5" cy="13.5" r="2.8"/><path d="M13.6 15.6 16 18"/></svg>' },
];
const cards = related.map((r, i) => ({ ...r, ...CARD_STYLE[i % CARD_STYLE.length] }));

// Body sections, in reading order. Icon + accent are language-neutral, so they
// live here rather than in the translated content JSON.
const GEAR = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5v.2a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1h.2a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>';
const PEOPLE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 20c0-3.4 2.9-6.2 6.5-6.2s6.5 2.8 6.5 6.2"/><circle cx="17.6" cy="9.4" r="2.4"/><path d="M17.6 14c2.4 0 4.4 1.9 4.4 4.3"/></svg>';
const DOLLAR = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M16 7.2A3.6 3.6 0 0 0 12.4 5.2h-.9C9.6 5.2 8.2 6.4 8.2 8s1.3 2.5 3.4 2.9l1 .2c2.1.4 3.4 1.3 3.4 2.9s-1.4 2.8-3.3 2.8h-.9A3.6 3.6 0 0 1 8 16.8"/></svg>';
const PILL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M10.6 3.4 3.4 10.6a5 5 0 0 0 7.1 7.1l7.1-7.1a5 5 0 1 0-7-7.1z"/><path d="M7 7l7 7"/></svg>';
const CALENDAR = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16.5" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/><path d="m9 14.5 2 2 4-4"/></svg>';

const sections = [
  { h2: b.h2How as string, accent: '#dc2626', tint: '#fdecec', icon: GEAR, html: b.howHtml as string, points: null },
  { h2: b.h2Key as string, accent: '#ea580c', tint: '#fdeee0', icon: PEOPLE, html: '', points: b.keyPoints },
  { h2: b.h2Costs as string, accent: '#16a34a', tint: '#e6f6ec', icon: DOLLAR, html: b.costsHtml as string, points: null },
  { h2: b.h2Common as string, accent: '#7c3aed', tint: '#f2ebfd', icon: PILL, html: b.commonHtml as string, points: null },
  { h2: b.h2When as string, accent: '#2563eb', tint: '#eaf1fe', icon: CALENDAR, html: b.whenHtml as string, points: null },
];

const SCALES = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M3.5 7.5h17"/><path d="M6.8 7.5 3.5 14h6.6zM17.2 7.5 13.9 14h6.6z"/><path d="M8 20h8"/></svg>';
const BOOK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4.5A1.5 1.5 0 0 1 5.5 3H19v15H5.5A1.5 1.5 0 0 0 4 19.5z"/><path d="M4 19.5A1.5 1.5 0 0 1 5.5 18H19v3H5.5A1.5 1.5 0 0 1 4 19.5z"/><path d="M8 7.5h7M8 11h5"/></svg>';

const PHONE_SVG = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.7 21 3 13.3 3 3c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1z"/></svg>';
const TICK_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
---

<ArticlePage context={context} bareHeader bareFooter>
  {/* ─── Hero ─────────────────────────────────────────────────────────── */}
  <section class="pd-hero">
    <div class="pd-hero__copy">
      <h1 class="pd-hero__title">
        {headLead}{headYear && <Fragment> <span class="pd-hero__year">{headYear}</span></Fragment>}
      </h1>
      <AuthorByline authorId={context.author} updated={context.lastUpdated} />
      {/* The real <SummaryBlock> doubles as the hero lede: same copy, and the
          page keeps the AI-summary contract that bareHeader would otherwise drop. */}
      <div class="pd-hero__lede"><SummaryBlock text={c.page.summary} /></div>
    </div>
    <div class="pd-hero__art">
      <img
        class="pd-hero__img"
        src="/pictures/medicarevernal.webp"
        alt={ui.heroImageAlt}
        width="1672"
        height="940"
        loading="eager"
        decoding="async"
      />
    </div>
  </section>

  {/* ─── Body + sticky agent rail ─────────────────────────────────────── */}
  <div class="pd-grid">
    <div class="pd-main">
      <aside class="pd-note">
        <span class="pd-note__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3.5" width="14" height="17" rx="2"/><rect x="9" y="1.8" width="6" height="3.4" rx="1"/><path d="M8.5 11h7M8.5 15h4.5"/></svg></span>
        <p set:html={b.needHtml} />
      </aside>

      {sections.map((s) => (
        <section class="pd-sec" style={`--accent:${s.accent};--tint:${s.tint}`}>
          <h2 class="pd-sec__h">
            <span class="pd-sec__icon" aria-hidden="true" set:html={s.icon} />
            {s.h2}
          </h2>
          {s.points ? (
            <ul class="pd-checks">
              {s.points.map((p) => (
                <li>
                  <span class="pd-checks__mark" aria-hidden="true" set:html={TICK_SVG} />
                  <span><strong>{p.title}:</strong> <span set:html={p.html} /></span>
                </li>
              ))}
            </ul>
          ) : (
            <p set:html={s.html} />
          )}
        </section>
      ))}

      {/* The two routes to drug coverage, side by side. A Part D page that
          compares nothing has failed at its job (scripts/seo/standards.mjs). */}
      <section class="pd-sec" style="--accent:#0891b2;--tint:#e2f5f9">
        <h2 class="pd-sec__h">
          <span class="pd-sec__icon" aria-hidden="true" set:html={SCALES} />
          {b.h2Table}
        </h2>
        <div class="pd-tablewrap">
          <table class="pd-table">
            <caption class="pd-table__cap">{c.table.caption}</caption>
            <thead>
              <tr>{c.table.cols.map((col) => <th scope="col">{col}</th>)}</tr>
            </thead>
            <tbody>
              {c.table.rows.map((row) => (
                <tr>
                  <th scope="row">{row[0]}</th>
                  {row.slice(1).map((cell) => <td>{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {/* Definitions of the terms this page uses. <dl> is what the editorial
          standard detects, and what AI extractors pull for term queries. */}
      <section class="pd-sec" style="--accent:#4f46e5;--tint:#ecebfd">
        <h2 class="pd-sec__h">
          <span class="pd-sec__icon" aria-hidden="true" set:html={BOOK} />
          {b.h2Defs}
        </h2>
        <dl class="pd-defs">
          {c.definitions.map((d) => (
            <div class="pd-defs__row">
              <dt><dfn>{d.term}</dfn></dt>
              <dd set:html={d.def} />
            </div>
          ))}
        </dl>
      </section>

      {/* `sources` in the class is the editorial-completeness contract marker
          (scripts/seo/sources.mjs) — keep it on any citation line. */}
      <p class="pd-sources" set:html={b.sourceHtml} />
    </div>

    <aside class="pd-rail">
      <div class="pd-agent">
        <h2 class="pd-agent__h">{ui.agentHeading}</h2>
        <div class="pd-agent__who">
          <img class="pd-agent__photo" src="/pictures/rocco.webp" alt={`${agentName}, ${ui.agentRole}`} width="72" height="72" loading="lazy" decoding="async" />
          <span class="pd-agent__id">
            <strong>{agentName}</strong>
            <em>{ui.agentRole}</em>
          </span>
        </div>
        <ul class="pd-agent__points">
          {ui.agentPoints.map((p) => (
            <li>
              <span class="pd-agent__tick" aria-hidden="true" set:html={TICK_SVG} />
              <span>{p}</span>
            </li>
          ))}
        </ul>
        <a class="pd-btn pd-btn--call" href={phoneHref}>
          <span class="pd-btn__icon" aria-hidden="true" set:html={PHONE_SVG} />
          {BUSINESS.phone}
        </a>
        <a class="pd-btn pd-btn--text" href={smsHref}>
          <span class="pd-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h13a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H9l-4 3v-3H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/></svg></span>
          {ui.textBtn}
        </a>
      </div>
    </aside>
  </div>

  {/* ─── FAQ ──────────────────────────────────────────────────────────── */}
  <section class="pd-faq" aria-label={ui.faqHeading}>
    {(context.page.faqs ?? []).map((f) => (
      <details class="pd-faq__item">
        <summary>
          <span class="pd-faq__q" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.4 9.3a2.6 2.6 0 0 1 4.7 1.4c0 1.7-2.1 2.1-2.1 3.6"/><circle cx="12" cy="17.1" r="0.6" fill="currentColor" stroke="none"/></svg></span>
          <span class="pd-faq__label" set:html={f.question} />
          <span class="pd-faq__plus" aria-hidden="true"></span>
        </summary>
        <div class="pd-faq__a" set:html={f.answer} />
      </details>
    ))}
  </section>

  {/* ─── Related ──────────────────────────────────────────────────────── */}
  <section class="pd-rel" aria-labelledby="pd-rel-h">
    <h2 id="pd-rel-h" class="pd-rel__h">{ui.resourcesHeading}</h2>
    {/* `related` / `page-cta` below are contract classes read by the editorial
        gate; bareFooter drops the components that normally carry them. */}
    <div class="pd-rel__grid related">
      {cards.map((r) => (
        <a class="pd-rcard" href={localizeHref(r.href, lang)} style={`--accent:${r.accent};--tint:${r.tint}`}>
          <span class="pd-rcard__icon" aria-hidden="true" set:html={r.icon} />
          <span class="pd-rcard__label">{r.label}</span>
          <span class="pd-rcard__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span>
        </a>
      ))}
    </div>

    <h3 class="pd-rel__more-h">{ui.moreHeading}</h3>
    <ul class="pd-rel__more">
      {b.relatedItemsHtml.map((item) => <li set:html={item} />)}
    </ul>
  </section>

  {/* ─── CTA banner ───────────────────────────────────────────────────── */}
  <section class="pd-cta page-cta">
    <span class="pd-cta__shield" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8l7.5 3.1v5.4c0 5.2-3.6 8.5-7.5 9.9-3.9-1.4-7.5-4.7-7.5-9.9V5.9z"/><path d="m8.6 12.1 2.4 2.4 4.4-4.6"/></svg></span>
    <div class="pd-cta__msg">
      <h2 class="pd-cta__title">{ui.ctaTitle}</h2>
      <p>{ui.ctaSub}</p>
    </div>
    <div class="pd-cta__actions">
      <a class="pd-btn pd-btn--call" href={phoneHref}>
        <span class="pd-btn__icon" aria-hidden="true" set:html={PHONE_SVG} />
        {t9(ui.ctaCall)}
      </a>
      <a class="pd-btn pd-btn--quote" href={BUSINESS.quoteUrl} target="_blank" rel="noopener noreferrer">{ui.ctaQuote}</a>
    </div>
  </section>
</ArticlePage>

<style>
  /* Palette matches the costs / help-center hubs: navy #0b2c45, blue #2563eb,
     brand red #dc2626, with a per-section accent driven by --accent/--tint. */

  /* ── Breadcrumb ───────────────────────────────────────────────────────── */
  /* The framework breadcrumb has no site-wide styling yet (there is no
     .breadcrumbs rule in public/styles.css), so every page renders it as a bare
     numbered list. Styled :global here — this stylesheet only ships on this
     page and its /es/ sibling — rather than editing the global sheet, which
     would restyle all 166 pages. */
  :global(.page > .breadcrumbs) { margin: 0 0 1.1rem; }
  :global(.page > .breadcrumbs ol) {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
    list-style: none; padding: 0; margin: 0;
    font-size: 0.85rem; color: #64748b;
  }
  :global(.page > .breadcrumbs li) { display: flex; align-items: center; gap: 0.5rem; }
  :global(.page > .breadcrumbs li + li::before) { content: "\203A"; color: #9fb0c2; font-weight: 700; }
  :global(.page > .breadcrumbs a) { color: #1f4e8c; text-decoration: none; font-weight: 600; }
  :global(.page > .breadcrumbs a:hover) { text-decoration: underline; }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .pd-hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 2.5rem;
    margin: 0.25rem 0 2rem;
  }
  .pd-hero__title {
    font-size: clamp(2rem, 4.4vw, 3rem);
    line-height: 1.1;
    font-weight: 800;
    color: #0b2c45;
    margin: 0 0 0.6rem;
  }
  .pd-hero__year { color: #dc2626; }
  .pd-hero :global(.byline) {
    margin: 0 0 1rem;
    color: #64748b;
    font-size: 0.85rem;
  }
  .pd-hero__lede :global(.summary-block) { margin: 0; }
  .pd-hero__lede :global(.summary-block p) { margin: 0; color: #475569; font-size: 1.02rem; line-height: 1.6; }
  .pd-hero__img {
    width: 100%; height: auto; display: block;
    border-radius: 16px;
    box-shadow: 0 18px 44px rgba(11, 44, 69, 0.18);
  }

  /* ── Body + rail ──────────────────────────────────────────────────────── */
  .pd-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 2.5rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }
  .pd-main { min-width: 0; }

  .pd-note {
    display: flex; align-items: flex-start; gap: 1rem;
    background: #f0f7fd; border: 1px solid #d9e7f5; border-radius: 12px;
    padding: 1.15rem 1.25rem; margin: 0 0 1.75rem;
  }
  .pd-note__icon {
    flex: none; width: 46px; height: 46px; border-radius: 50%;
    display: grid; place-items: center; background: #1f6fb2; color: #fff;
  }
  .pd-note__icon svg { width: 24px; height: 24px; }
