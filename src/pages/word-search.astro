---
// src/pages/word-search.astro — Vernal Word Search: a relaxing, untimed,
// large-print word-search game. The first non-Medicare title in the library;
// Medicare vocabulary is one optional theme, never the default.
//
// Engine: src/lib/games/wordSearch.ts (unit-tested). Interface:
// src/lib/games/wordSearchUi.ts. Same shell as the other games:
// StandardPageLayout with bareHeader + bareFooter and the real SummaryBlock /
// AuthorByline / SourcesList / PageCTA components. Styles are `is:global`
// under `.ws-page` because the board renders with innerHTML.
import StandardPageLayout from '../components/layout/StandardPageLayout.astro';
import SummaryBlock from '../components/SummaryBlock.astro';
import AuthorByline from '../components/content/AuthorByline.astro';
import SourcesList from '../components/content/SourcesList.astro';
import PageCTA from '../components/content/PageCTA.astro';
import { BUSINESS } from '../data/business';
import { THEMES, LEVELS, LEVEL_ORDER } from '../lib/games/wordSearch';
import type { PageContext } from '../types/Page';

const context: PageContext = {
  page: {
    title: 'Free Word Search Puzzles for Seniors — Large Print, Untimed | Vernal Medicare Games',
    heading: 'Vernal Word Search',
    description:
      'A free, untimed word search with large letters and six themes — nature, animals, geography, food, everyday life, and optional Medicare words. Three difficulty levels, hints, touch or keyboard, and your puzzle is saved on your device.',
    taxonomy: { silo: 'tools', tags: ['tools', 'game', 'word-games', 'puzzles', 'seniors'] },
    summary:
      'Vernal Word Search is a free browser puzzle built for comfortable play: big letters, no timer, no account. Pick a theme and a difficulty, then find the hidden words by dragging, by tapping the first and last letter, or with the arrow keys. Stuck? A hint shows where a word starts. Your current puzzle is saved on your device, and every new puzzle is different. One optional theme practices Medicare words — the rest are just for fun.',
    faqs: [
      {
        question: 'How do I select a word?',
        answer:
          'Three ways: drag from the first letter to the last with your mouse or finger; tap the first letter and then the last letter; or use the arrow keys to move, press Enter on the first letter, move to the last letter, and press Enter again. Press Escape to cancel.',
      },
      {
        question: 'Is there a time limit?',
        answer: 'No. There is no clock and no score to beat. Take as long as you like, leave, and come back — the puzzle is saved on your device.',
      },
      {
        question: 'What do the difficulty levels change?',
        answer:
          'Easy is an 8 × 8 grid with 6 words running across or down. Medium is 10 × 10 with 8 words and adds diagonals. Hard is 12 × 12 with 10 words and adds backwards words.',
      },
      {
        question: 'Do hints cost anything?',
        answer: 'No. A hint highlights the first letter of a word you have not found yet. The game counts hints so you can see them, but nothing is taken away.',
      },
      {
        question: 'Is the Medicare theme required?',
        answer: 'No. It is one optional theme among six, marked “optional” in the list. Choose it if you want to practice Medicare vocabulary; the other themes are just for fun.',
      },
    ],
    sources: [
      { title: 'Medicare costs (premiums, deductibles, copayments, coinsurance)', url: 'https://www.medicare.gov/basics/costs/medicare-costs', publisher: 'Medicare.gov' },
      { title: 'Medigap basics', url: 'https://www.medicare.gov/health-drug-plans/medigap/basics', publisher: 'Medicare.gov' },
      { title: 'Part D basics (drug coverage, formularies, pharmacies)', url: 'https://www.medicare.gov/health-drug-plans/part-d/basics', publisher: 'Medicare.gov' },
      { title: 'Hospice care', url: 'https://www.medicare.gov/coverage/hospice-care', publisher: 'Medicare.gov' },
    ],
  },
  meta: {
    canonical: 'https://vernalmedicare.com/word-search.html',
    ogType: 'website',
    ogTitle: 'Vernal Word Search — Free, Untimed, Large Print',
    ogDescription: 'A relaxing word search with big letters, six themes, three difficulty levels, hints, and no timer.',
  },
  author: 'rocco',
  datePublished: '2026-10-23',
  lastUpdated: '2026-10-23',
  medicalDisclaimer:
    'Vernal Word Search is an entertainment puzzle. It is not medical advice and makes no health claims. The optional Medicare Words theme practices vocabulary only; for questions about your own coverage, check Medicare.gov or talk with a licensed agent.',
  breadcrumb: [
    { name: 'Home', href: '/' },
    { name: 'Games', href: '/games.html' },
    { name: 'Word Search', href: '/word-search.html' },
  ],
};
const { page } = context;

const MORE = [
  { href: '/games.html', name: 'All games', desc: 'Browse the Vernal Medicare game library.' },
  { href: '/medicare-journey-game.html', name: 'Medicare Journey', desc: 'Explore a valley, solve puzzles, collect knowledge cards.' },
  { href: '/medicare-adventure-game.html', name: 'Medicare Adventure', desc: 'A five-stage quiz game with points and badges.' },
  { href: '/medicare-life-simulator.html', name: 'Medicare Life Simulator', desc: 'Guide Joe’s retirement month by month.' },
  { href: '/medicare-glossary.html', name: 'Medicare Glossary', desc: 'Plain-English definitions of the Medicare Words theme.' },
  { href: '/medicare-calculators.html', name: 'Free Medicare Calculators', desc: 'Costs, penalties, and important dates.' },
  { href: '/medicare-quiz.html', name: 'Medicare Plan Quiz', desc: 'Seven questions about the coverage that may fit you.' },
  { href: '/medicare-help-center.html', name: 'Medicare Help Center', desc: 'Guides and where to start.' },
];
---

<StandardPageLayout context={context} bareHeader bareFooter>
<div class="ws-page">

  <section class="ws-hero">
    <div>
      <p class="ws-eyebrow">Vernal Medicare Games · Word Games</p>
      <h1>{page.heading}</h1>
      <p class="ws-hero__tag">Big letters. Six themes. No timer. Find the words at your own pace.</p>
      <SummaryBlock text={page.summary} />
      <AuthorByline authorId={context.author} updated={context.lastUpdated} />
      <p class="ws-hero__cta"><a class="ws-btn ws-btn-primary" href="#ws">Start playing <span aria-hidden="true">↓</span></a></p>
    </div>
    <ul class="ws-hero__facts" aria-label="At a glance">
      <li><strong>{THEMES.length}</strong><span>themes</span></li>
      <li><strong>{LEVEL_ORDER.length}</strong><span>difficulty levels</span></li>
      <li><strong>0</strong><span>timers</span></li>
      <li><strong>∞</strong><span>new puzzles</span></li>
    </ul>
  </section>

  <div class="ws" id="ws" aria-label="Word search game">
    <div class="ws-controls" id="ws-controls"></div>
    <div class="ws-play">
      <div class="ws-boardwrap"><div class="ws-board" id="ws-board"><noscript><p class="ws-muted">Vernal Word Search needs JavaScript turned on in your browser.</p></noscript></div></div>
      <aside class="ws-side"><div id="ws-words"></div><div id="ws-done" hidden></div></aside>
    </div>
    <p class="ws-sr" id="ws-live" aria-live="polite"></p>
  </div>

  <section class="ws-sec" aria-labelledby="ws-how-h">
    <h2 id="ws-how-h">How to play</h2>
    <ol class="ws-steps">
      <li><span aria-hidden="true">1</span><p><strong>Pick a theme and a level.</strong> {LEVEL_ORDER.map((l) => `${LEVELS[l].label}: ${LEVELS[l].hint}`).join('. ')}.</p></li>
      <li><span aria-hidden="true">2</span><p><strong>Find a word.</strong> Drag from the first letter to the last — or tap the first letter, then the last. With a keyboard: arrows move, Enter marks the start and the end.</p></li>
      <li><span aria-hidden="true">3</span><p><strong>Stuck?</strong> Press Hint to light up the first letter of a word you haven’t found. Hints are counted, never penalized.</p></li>
      <li><span aria-hidden="true">4</span><p><strong>Come back any time.</strong> Your puzzle is saved on this device. “New puzzle” shuffles a fresh one.</p></li>
    </ol>
  </section>

  <section class="ws-sec" aria-labelledby="ws-themes-h">
    <h2 id="ws-themes-h">Themes</h2>
    <ul class="ws-themes">
      {THEMES.map((t) => (<li class={t.optional ? 'is-optional' : ''}><strong>{t.label}{t.optional && <em> · optional</em>}</strong><p>{t.blurb}</p></li>))}
    </ul>
  </section>

  <div class="ws-two">
    <section class="ws-faq" aria-label="Frequently Asked Questions">
      <h2>Frequently Asked Questions</h2>
      {page.faqs?.map((f) => (
        <details class="ws-faq__item"><summary><span set:html={f.question} /><span class="ws-faq__plus" aria-hidden="true">+</span></summary><div class="ws-faq__a" set:html={f.answer} /></details>
      ))}
    </section>
    <div>
      <nav class="related ws-more" aria-labelledby="ws-more-h">
        <h2 id="ws-more-h">More games and tools</h2>
        <ul>{MORE.map((m) => (<li><a href={m.href}><strong>{m.name}</strong><span>{m.desc}</span></a></li>))}</ul>
      </nav>
    </div>
  </div>

  <div class="ws-src">
    <h2 class="ws-src-h">Where the Medicare Words come from</h2>
    <p class="ws-src-p">The optional Medicare Words theme uses terms as Medicare.gov uses them. Look any of them up here:</p>
    <SourcesList sources={page.sources ?? []} />
  </div>

  <div class="ws-cta">
    <img class="ws-cta__photo" src="/pictures/rocco.webp" alt={`${BUSINESS.legalAgent}, licensed Medicare agent in Vernal, Utah`} width="96" height="96" loading="lazy" decoding="async" />
    <PageCTA />
  </div>
</div>
</StandardPageLayout>

<script>
  import { mount } from '../lib/games/wordSearchUi';
  mount();
</script>

<style is:global>
  .ws-page {
    --ws-ink: #0b2c45; --ws-soft: #334155; --ws-line: #d3e0ee; --ws-blue: #1d4ed8; --ws-blue-soft: #e5edfe;
    --ws-coral: #d0343d; --ws-coral-dark: #a8262f; --ws-teal: #0f766e; --ws-gold: #f59e0b;
    --ws-shadow: 0 14px 34px -22px rgba(11, 44, 69, 0.55);
    color: var(--ws-ink);
  }
  .ws-page *, .ws-page *::before, .ws-page *::after { box-sizing: border-box; }
  .ws-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .ws-page a:focus-visible, .ws-page button:focus-visible, .ws-page select:focus-visible, .ws-page summary:focus-visible { outline: 4px solid var(--ws-gold); outline-offset: 3px; }
  .ws-page h2 { color: var(--ws-ink); }
  .ws-muted { color: #5b6b7d; }
  .ws-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; font: inherit; font-weight: 800; font-size: 1.1rem; min-height: 56px; padding: 0.7rem 1.4rem; border-radius: 999px; cursor: pointer; border: 2px solid transparent; text-decoration: none; }
  .ws-btn svg { width: 22px; height: 22px; }
  .ws-btn-primary { background: var(--ws-coral); color: #fff !important; box-shadow: 0 5px 0 var(--ws-coral-dark); }
  .ws-btn-primary:hover { background: #bb2d36; }
  .ws-btn-primary:active { transform: translateY(3px); box-shadow: 0 2px 0 var(--ws-coral-dark); }
  .ws-btn-ghost { background: #fff; color: var(--ws-blue); border-color: var(--ws-line); }
  .ws-btn-ghost:hover { border-color: var(--ws-blue); background: var(--ws-blue-soft); }
  .ws-btn[disabled] { opacity: 0.5; cursor: default; }

  /* Hero */
  .ws-hero { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; align-items: center; background: linear-gradient(180deg, #eef7ff, #fff); border: 1px solid var(--ws-line); border-radius: 26px; padding: 2rem 2.25rem; margin: 0.5rem 0 1.5rem; }
  .ws-eyebrow { margin: 0 0 0.4rem; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ws-teal); }
  .ws-hero h1 { font-size: clamp(2rem, 4.2vw, 2.9rem); line-height: 1.08; font-weight: 800; margin: 0 0 0.6rem; color: var(--ws-ink); }
  .ws-hero__tag { font-size: 1.2rem; font-weight: 700; margin: 0 0 0.75rem; }
  .ws-hero .summary-block { background: none; border: 0; padding: 0; margin: 0 0 0.6rem; box-shadow: none; }
  .ws-hero .summary-block p { margin: 0; font-size: 1.05rem; line-height: 1.6; color: var(--ws-soft); }
  .ws-hero .byline { margin: 0 0 1rem; font-size: 0.92rem; color: #5b6b7d; }
  .ws-hero__cta { margin: 0; }
  .ws-hero__facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .ws-hero__facts li { background: #fff; border: 1px solid var(--ws-line); border-radius: 18px; padding: 1rem; text-align: center; box-shadow: var(--ws-shadow); }
  .ws-hero__facts strong { display: block; font-size: 2.2rem; line-height: 1; color: var(--ws-blue); }
  .ws-hero__facts span { color: var(--ws-soft); font-weight: 700; }

  /* Game shell */
  .ws { background: #fff; border: 2px solid var(--ws-line); border-radius: 26px; box-shadow: 0 18px 50px -26px rgba(11, 44, 69, 0.4); padding: 1rem; margin: 0 0 2rem; scroll-margin-top: 140px; font-size: 1.1rem; }
  .ws-controls { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.75rem 1.25rem; padding: 0.75rem 0.9rem; background: #f6faff; border: 1px solid var(--ws-line); border-radius: 18px; margin-bottom: 1rem; }
  .ws-ctl { display: flex; flex-direction: column; gap: 0.3rem; border: 0; margin: 0; padding: 0; min-width: 0; }
  .ws-ctl--actions { flex-direction: row; gap: 0.5rem; margin-left: auto; }
  .ws-label { font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: #5b6b7d; padding: 0; }
  .ws-select { font: inherit; font-weight: 700; min-height: 52px; padding: 0.4rem 0.8rem; border-radius: 12px; border: 2px solid var(--ws-line); background: #fff; color: var(--ws-ink); }
  .ws-levels { flex-direction: row; flex-wrap: wrap; align-items: flex-end; gap: 0.35rem; }
  .ws-levels legend { float: left; width: 100%; margin-bottom: 0.3rem; }
  .ws-level { font: inherit; font-weight: 800; min-height: 52px; padding: 0.4rem 1rem; border-radius: 12px; border: 2px solid var(--ws-line); background: #fff; color: var(--ws-blue); cursor: pointer; }
  .ws-level.is-on { background: var(--ws-blue); color: #fff; border-color: var(--ws-blue); }
  .ws-levelhint { flex-basis: 100%; margin: -0.25rem 0 0; font-size: 0.92rem; color: #5b6b7d; }
  .ws-controls .ws-btn { min-height: 52px; font-size: 1.02rem; padding: 0.5rem 1.1rem; }

  .ws-play { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 1.25rem; align-items: start; }
  .ws-boardwrap { display: flex; justify-content: center; }
  .ws-board { width: 100%; max-width: calc(var(--cell, 54px) * 12 + 11 * 4px + 16px); }
  .ws-board.is-miss .ws-grid { animation: ws-shake 0.35s ease; }
  .ws-grid { display: grid; gap: 4px; padding: 8px; background: #e2ecf6; border-radius: 16px; touch-action: none; user-select: none; -webkit-user-select: none; }
  .ws-grid [role="row"] { display: contents; }
  /* Cells grow with the space available but never past 60px, so an 8×8 grid
     stays a comfortable ~540px rather than filling the column. */
  .ws-grid { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); max-width: calc(var(--n) * 60px + (var(--n) - 1) * 4px + 16px); margin: 0 auto; }
  .ws-cell { aspect-ratio: 1; min-width: 0; width: 100%; font: inherit; font-weight: 800; font-size: clamp(1rem, 2.6vw, 1.5rem); line-height: 1; color: var(--ws-ink); background: #fff; border: 2px solid transparent; border-radius: 10px; cursor: pointer; padding: 0; display: grid; place-items: center; transition: background 0.12s ease, transform 0.12s ease; }
  .ws-cell:hover { background: var(--ws-blue-soft); }
  .ws-cell.is-sel { background: #bfdbfe; border-color: var(--ws-blue); transform: scale(1.04); }
  .ws-cell.is-anchor { border-color: var(--ws-coral); box-shadow: 0 0 0 3px rgba(208, 52, 61, 0.3); }
  .ws-cell.is-hint { border-color: var(--ws-gold); background: #fef3c7; animation: ws-pulse 1.4s ease-in-out infinite; }
  .ws-cell.is-found { color: #fff; }
  .ws-c0.is-found, .ws-list .ws-c0 { --c: #1d4ed8; } .ws-c1.is-found, .ws-list .ws-c1 { --c: #0f766e; } .ws-c2.is-found, .ws-list .ws-c2 { --c: #b45309; } .ws-c3.is-found, .ws-list .ws-c3 { --c: #6b21a8; }
  .ws-c4.is-found, .ws-list .ws-c4 { --c: #be185d; } .ws-c5.is-found, .ws-list .ws-c5 { --c: #166534; } .ws-c6.is-found, .ws-list .ws-c6 { --c: #c2410c; } .ws-c7.is-found, .ws-list .ws-c7 { --c: #0369a1; }
  .ws-cell.is-found { background: var(--c); }
  .ws-side { background: #f6faff; border: 1px solid var(--ws-line); border-radius: 18px; padding: 0.9rem 1rem; }
  .ws-progress { margin: 0 0 0.6rem; font-size: 1.05rem; color: var(--ws-soft); }
  .ws-progress strong { font-size: 1.4rem; color: var(--ws-ink); }
  .ws-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }
  .ws-list li { display: flex; align-items: center; gap: 0.35rem; font-weight: 800; letter-spacing: 0.04em; font-size: 1.05rem; padding: 0.3rem 0.5rem; border-radius: 10px; background: #fff; border: 1px solid var(--ws-line); }
  .ws-list li svg { width: 18px; height: 18px; color: var(--c); flex: none; }
  .ws-list li.is-found { color: #64748b; text-decoration: line-through; border-color: var(--c); }
  .ws-win { margin-top: 0.9rem; text-align: center; background: #fffbeb; border: 2px solid #fcd34d; border-radius: 16px; padding: 1rem; animation: ws-in 0.3s ease both; }
  .ws-win__star { display: inline-grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: #facc15; color: #78350f; margin-bottom: 0.3rem; animation: ws-pop 0.5s ease; }
  .ws-win__star svg { width: 32px; height: 32px; }
  .ws-page .ws-win h3 { margin: 0 0 0.25rem; font-size: 1.3rem; color: var(--ws-ink); }
  .ws-win h3:focus { outline: none; }
  .ws-win p { margin: 0 0 0.6rem; color: var(--ws-soft); font-size: 0.98rem; }
  .ws-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; }

  /* Sections */
  .ws-sec { margin: 0 0 2rem; }
  .ws-page .ws-sec h2, .ws-faq h2, .ws-more h2, .ws-src-h { font-size: clamp(1.5rem, 3vw, 2rem); margin: 0 0 0.8rem; }
  .ws-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .ws-steps li { display: flex; gap: 0.9rem; align-items: flex-start; }
  .ws-steps li > span { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; color: #fff; background: var(--ws-blue); box-shadow: 0 0 0 4px var(--ws-blue-soft); }
  .ws-steps p { margin: 0.35rem 0 0; font-size: 1.08rem; color: var(--ws-soft); }
  .ws-steps strong { color: var(--ws-ink); }
  .ws-themes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem; }
  .ws-themes li { background: #fff; border: 1px solid var(--ws-line); border-radius: 16px; padding: 0.9rem 1rem; box-shadow: var(--ws-shadow); }
  .ws-themes li.is-optional { border-style: dashed; }
  .ws-themes strong { font-size: 1.08rem; color: var(--ws-blue); }
  .ws-themes em { font-style: normal; font-weight: 700; color: #5b6b7d; font-size: 0.9rem; }
  .ws-themes p { margin: 0.2rem 0 0; color: var(--ws-soft); font-size: 0.98rem; }
  .ws-two { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 0 0 2rem; align-items: start; }
  .ws-faq__item { background: #fff; border: 1px solid var(--ws-line); border-radius: 14px; margin-bottom: 0.6rem; }
  .ws-faq__item summary { display: flex; align-items: center; gap: 0.75rem; list-style: none; cursor: pointer; padding: 0.85rem 1rem; min-height: 56px; font-weight: 800; font-size: 1.05rem; }
  .ws-faq__item summary::-webkit-details-marker { display: none; }
  .ws-faq__plus { margin-left: auto; width: 30px; height: 30px; flex: none; border-radius: 50%; display: grid; place-items: center; color: var(--ws-coral); background: #fff1f1; font-weight: 800; transition: transform 0.2s ease; }
  .ws-faq__item[open] .ws-faq__plus { transform: rotate(45deg); }
  .ws-faq__a { padding: 0 1rem 1rem; color: var(--ws-soft); }
  .ws-page .ws-more { margin: 0; }
  .ws-page .ws-more ul { grid-template-columns: 1fr; gap: 0.5rem; }
  .ws-page .ws-more li { padding: 0; border: 0; background: none; box-shadow: none; }
  .ws-page .ws-more li::before { content: none; }
  .ws-page .ws-more li:hover { transform: none; box-shadow: none; }
  .ws-page .ws-more li a, .ws-page .ws-more li:hover a { display: flex; flex-direction: column; gap: 0.05rem; padding: 0.7rem 0.9rem; background: #fff; border: 1px solid var(--ws-line); border-radius: 12px; color: var(--ws-ink) !important; box-shadow: var(--ws-shadow); }
  .ws-page .ws-more li a:hover { border-color: var(--ws-blue); }
  .ws-more strong { font-size: 1.02rem; color: var(--ws-blue); }
  .ws-more span { font-weight: 400; color: var(--ws-soft); font-size: 0.94rem; }
  .ws-src { margin: 0 0 2rem; }
  .ws-src-p { margin: 0 0 0.75rem; color: var(--ws-soft); }
  .ws-page .sources { background: #fff; border: 1px solid var(--ws-line); border-radius: 18px; padding: 1.1rem 1.35rem; margin: 0; box-shadow: var(--ws-shadow); }
  .ws-page .sources h2 { font-size: 1.2rem; margin: 0 0 0.5rem; }
  .ws-page .sources li { margin: 0.3rem 0; color: var(--ws-soft); }
  .ws-cta { display: flex; align-items: center; gap: 1.5rem; background: linear-gradient(135deg, #0b2c45, #12406a); color: #fff; border-radius: 24px; padding: 1.5rem 1.75rem; margin: 0 0 1.5rem; }
  .ws-cta__photo { flex: none; width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 4px solid #fff; background: #fff; }
  .ws-cta .page-cta { flex: 1; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; margin: 0; padding: 0; background: none; border: 0; }
  .ws-cta .page-cta h2 { flex: 1 1 100%; margin: 0; color: #fff; font-size: 1.6rem; }
  .ws-cta .page-cta > p:not(.page-cta-actions) { flex: 1 1 280px; margin: 0; color: #dbeafe; }
