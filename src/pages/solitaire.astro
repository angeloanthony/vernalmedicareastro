---
// src/pages/solitaire.astro — Vernal Solitaire: classic Klondike with large,
// readable cards, draw-one or draw-three, undo, hints, and no timer.
// Entertainment only; no Medicare content. Engine: src/lib/games/solitaire.ts
// (pure, unit-tested); interface: src/lib/games/solitaireUi.ts. Same shell as
// the other games (StandardPageLayout bareHeader + bareFooter with the real
// SummaryBlock / AuthorByline / SourcesList / PageCTA). Styles are `is:global`
// under `.sol-page` because the board renders with innerHTML.
import StandardPageLayout from '../components/layout/StandardPageLayout.astro';
import SummaryBlock from '../components/SummaryBlock.astro';
import AuthorByline from '../components/content/AuthorByline.astro';
import SourcesList from '../components/content/SourcesList.astro';
import PageCTA from '../components/content/PageCTA.astro';
import { BUSINESS } from '../data/business';
import { card, isRed } from '../lib/games/solitaire';
import { cardFaceHtml } from '../lib/games/solitaireUi';
import type { PageContext } from '../types/Page';

const context: PageContext = {
  page: {
    title: 'Free Klondike Solitaire for Seniors — Large Cards, Untimed | Vernal Medicare Games',
    heading: 'Vernal Solitaire',
    description:
      'Free, untimed Klondike Solitaire with large, easy-to-read cards. Draw one or draw three, unlimited undo, hints when you want them, and a move counter. Tap, drag, or use the keyboard. Your game is saved on your device.',
    taxonomy: { silo: 'tools', tags: ['tools', 'game', 'cards-classic', 'puzzles', 'seniors'] },
    summary:
      'Vernal Solitaire is the classic Klondike card game, built for comfortable play: big cards with clear corner indexes, no clock, no account, and no ads. Choose draw one or draw three, build the four foundations from Ace to King, and take back any move with Undo. Tap a card and then tap where it goes, or drag it; every legal spot lights up. A hint is always one tap away, and your game is saved on this device so you can finish it later.',
    faqs: [
      { question: 'How do I move a card?', answer: 'Tap or click a card, then tap where you want it to go — the foundations and columns that can take it light up. Tap the same card twice to send it to its best spot. You can also drag cards with a mouse or your finger, or use the arrow keys and Enter.' },
      { question: 'What is the difference between draw one and draw three?', answer: 'Draw one turns over a single card from the stock each time, which makes the game easier. Draw three turns over three cards and lets you play only the top one, the traditional harder rule. Switching the rule starts a new game.' },
      { question: 'Is there a time limit or score?', answer: 'No. There is no clock and no points. The game counts your moves, hints, and undos so you can try to improve, but nothing is timed and nothing is taken away.' },
      { question: 'Can every game be won?', answer: 'No. Some Klondike deals cannot be won no matter how you play. When no move or draw is left, the game tells you and offers Undo, the same deal again, or a new game.' },
      { question: 'What does “Finish for me” do?', answer: 'When the stock is empty and every card is face up, the rest of the game is automatic. The button moves the remaining cards to the foundations for you, one at a time.' },
      { question: 'Can I play with a keyboard?', answer: 'Yes. Tab to the board, then use the arrow keys to move between piles and cards. Press Enter or the space bar to pick up a card and again to put it down. Escape puts a card back. Every card and pile has a spoken name for screen readers.' },
    ],
    sources: [
      { title: 'WCAG 2.2 — Target Size (Minimum)', url: 'https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum.html', publisher: 'W3C Web Accessibility Initiative' },
      { title: 'WCAG 2.2 — Dragging Movements (an alternative to dragging must exist)', url: 'https://www.w3.org/WAI/WCAG22/Understanding/dragging-movements.html', publisher: 'W3C Web Accessibility Initiative' },
      { title: 'WCAG 2.1 — Animation from Interactions (reduced motion)', url: 'https://www.w3.org/WAI/WCAG21/Understanding/animation-from-interactions.html', publisher: 'W3C Web Accessibility Initiative' },
      { title: 'ARIA Authoring Practices — Keyboard navigation inside components', url: 'https://www.w3.org/WAI/ARIA/apg/practices/keyboard-interface/', publisher: 'W3C Web Accessibility Initiative' },
    ],
  },
  meta: {
    canonical: 'https://vernalmedicare.com/solitaire.html',
    ogType: 'website',
    ogTitle: 'Vernal Solitaire — Classic Klondike, Large Cards, No Timer',
    ogDescription: 'Free Klondike Solitaire with big readable cards, draw one or three, undo, hints, and no clock. Tap, drag, or play by keyboard.',
  },
  author: 'rocco',
  datePublished: '2026-10-24',
  lastUpdated: '2026-10-24',
  medicalDisclaimer:
    'Vernal Solitaire is an entertainment game. It is not medical advice, makes no health claims, and is not a test of memory or cognition. For questions about Medicare, check Medicare.gov or talk with a licensed agent.',
  breadcrumb: [
    { name: 'Home', href: '/' },
    { name: 'Games', href: '/games.html' },
    { name: 'Solitaire', href: '/solitaire.html' },
  ],
};
const { page } = context;

const SAMPLE = [card('S', 1), card('H', 13), card('D', 7), card('C', 11)];

const MORE = [
  { href: '/games.html', name: 'All games', desc: 'Browse the Vernal Medicare game library.' },
  { href: '/memory-match.html', name: 'Vernal Memory Match', desc: 'Turn two cards, find the pairs.' },
  { href: '/word-search.html', name: 'Vernal Word Search', desc: 'Big letters, six themes, no timer.' },
  { href: '/medicare-journey-game.html', name: 'Medicare Journey', desc: 'Explore a valley, solve puzzles, collect knowledge cards.' },
  { href: '/medicare-adventure-game.html', name: 'Medicare Adventure', desc: 'A five-stage quiz game with points and badges.' },
  { href: '/medicare-life-simulator.html', name: 'Medicare Life Simulator', desc: 'Guide Joe’s retirement month by month.' },
  { href: '/medicare-calculators.html', name: 'Free Medicare Calculators', desc: 'Costs, penalties, and important dates.' },
  { href: '/medicare-help-center.html', name: 'Medicare Help Center', desc: 'Guides and where to start.' },
];
---

<StandardPageLayout context={context} bareHeader bareFooter>
<div class="sol-page">

  <section class="sol-hero">
    <div>
      <p class="sol-eyebrow">Vernal Medicare Games · Cards &amp; Classic Games</p>
      <h1>{page.heading}</h1>
      <p class="sol-hero__tag">Classic Klondike. Big cards, no clock, unlimited undo.</p>
      <SummaryBlock text={page.summary} />
      <AuthorByline authorId={context.author} updated={context.lastUpdated} />
      <p class="sol-hero__cta"><a class="sol-btn sol-btn-primary" href="#sol">Start playing <span aria-hidden="true">↓</span></a></p>
    </div>
    <ul class="sol-hero__preview" aria-label="Sample cards">
      {SAMPLE.map((c) => (<li class={`sol-card is-up is-static ${isRed(c) ? 'is-red' : 'is-black'}`} set:html={cardFaceHtml(c)} />))}
    </ul>
  </section>

  <div class="sol" id="sol" aria-label="Solitaire game">
    <div class="sol-controls" id="sol-controls"></div>
    <p class="sol-status" id="sol-status" aria-live="off"></p>
    <p class="sol-msg" id="sol-msg"></p>
    <div class="sol-board" id="sol-board" role="group" aria-label="Solitaire board. Arrow keys move between piles and cards; Enter picks up or puts down a card."><noscript><p class="sol-muted sol-noscript">Vernal Solitaire needs JavaScript turned on in your browser.</p></noscript></div>
    <div id="sol-panel" hidden></div>
    <p class="sol-sr" id="sol-live" aria-live="polite"></p>
  </div>

  <section class="sol-sec" aria-labelledby="sol-how-h">
    <h2 id="sol-how-h">How to play</h2>
    <ol class="sol-steps">
      <li><span aria-hidden="true">1</span><p><strong>The goal.</strong> Build the four foundations at the top right from Ace up to King, one suit each. When all 52 cards are home, you win.</p></li>
      <li><span aria-hidden="true">2</span><p><strong>The columns.</strong> Cards in the seven columns go in descending order with alternating colors — a red Six on a black Seven. Only a King can start an empty column. A face-up run moves together.</p></li>
      <li><span aria-hidden="true">3</span><p><strong>The stock.</strong> Tap the stock at the top left to turn over one card (or three). When it runs out, tap again to turn the waste pile back over. You can go through it as many times as you like.</p></li>
      <li><span aria-hidden="true">4</span><p><strong>Moving cards.</strong> Tap a card, then tap where it goes; legal spots light up. Tap the same card twice to send it to its best spot. Dragging and the keyboard work too.</p></li>
      <li><span aria-hidden="true">5</span><p><strong>Stuck?</strong> Hint shows a good move. Undo takes back as many moves as you like. “Same deal” replays the exact cards; “New game” shuffles. Your game is saved on this device.</p></li>
    </ol>
  </section>

  <div class="sol-two">
    <section class="sol-faq" aria-label="Frequently Asked Questions">
      <h2>Frequently Asked Questions</h2>
      {page.faqs?.map((f) => (
        <details class="sol-faq__item"><summary><span set:html={f.question} /><span class="sol-faq__plus" aria-hidden="true">+</span></summary><div class="sol-faq__a" set:html={f.answer} /></details>
      ))}
    </section>
    <nav class="related sol-more" aria-labelledby="sol-more-h">
      <h2 id="sol-more-h">More games and tools</h2>
      <ul>{MORE.map((m) => (<li><a href={m.href}><strong>{m.name}</strong><span>{m.desc}</span></a></li>))}</ul>
    </nav>
  </div>

  <div class="sol-src">
    <h2 class="sol-src-h">Built for comfortable play</h2>
    <p class="sol-src-p">Cards are large touch targets, every drag has a tap alternative, motion is optional, and the board works with a keyboard and a screen reader. The guidelines we follow:</p>
    <SourcesList sources={page.sources ?? []} />
  </div>

  <div class="sol-cta">
    <img class="sol-cta__photo" src="/pictures/rocco.webp" alt={`${BUSINESS.legalAgent}, licensed Medicare agent in Vernal, Utah`} width="96" height="96" loading="lazy" decoding="async" />
    <PageCTA />
  </div>
</div>
</StandardPageLayout>

<script>
  import { mount } from '../lib/games/solitaireUi';
  mount();
</script>

<style is:global>
  .sol-page {
    --sol-ink: #0b2c45; --sol-soft: #334155; --sol-line: #d3e0ee; --sol-blue: #1d4ed8; --sol-blue-soft: #e5edfe;
    --sol-coral: #d0343d; --sol-coral-dark: #a8262f; --sol-teal: #0f766e; --sol-gold: #f59e0b; --sol-navy: #0f2744;
    --sol-felt: #1f6b43; --sol-felt-dark: #174f32; --sol-red: #c81e2b; --sol-black: #15233a;
    --sol-shadow: 0 14px 34px -22px rgba(11, 44, 69, 0.55);
    color: var(--sol-ink);
  }
  .sol-page *, .sol-page *::before, .sol-page *::after { box-sizing: border-box; }
  .sol-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .sol-page a:focus-visible, .sol-page button:focus-visible, .sol-page summary:focus-visible { outline: 4px solid var(--sol-gold); outline-offset: 3px; }
  .sol-page h2 { color: var(--sol-ink); }
  .sol-muted { color: #5b6b7d; }
  .sol-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; font: inherit; font-weight: 800; font-size: 1.1rem; min-height: 56px; padding: 0.7rem 1.4rem; border-radius: 999px; cursor: pointer; border: 2px solid transparent; text-decoration: none; }
  .sol-btn svg { width: 22px; height: 22px; }
  .sol-btn-primary { background: var(--sol-coral); color: #fff !important; box-shadow: 0 5px 0 var(--sol-coral-dark); }
  .sol-btn-primary:hover { background: #bb2d36; }
  .sol-btn-primary:active { transform: translateY(3px); box-shadow: 0 2px 0 var(--sol-coral-dark); }
  .sol-btn-ghost { background: #fff; color: var(--sol-blue); border-color: var(--sol-line); }
  .sol-btn-ghost:hover { border-color: var(--sol-blue); background: var(--sol-blue-soft); }
  .sol-btn[disabled] { opacity: 0.5; cursor: default; }

  /* Hero */
  .sol-hero { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 2rem; align-items: center; background: linear-gradient(180deg, #eef7ff, #fff); border: 1px solid var(--sol-line); border-radius: 26px; padding: 2rem 2.25rem; margin: 0.5rem 0 1.5rem; }
  .sol-eyebrow { margin: 0 0 0.4rem; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--sol-teal); }
  .sol-hero h1 { font-size: clamp(2rem, 4.2vw, 2.9rem); line-height: 1.08; font-weight: 800; margin: 0 0 0.6rem; color: var(--sol-ink); }
  .sol-hero__tag { font-size: 1.2rem; font-weight: 700; margin: 0 0 0.75rem; }
  .sol-hero .summary-block { background: none; border: 0; padding: 0; margin: 0 0 0.6rem; box-shadow: none; }
  .sol-hero .summary-block p { margin: 0; font-size: 1.05rem; line-height: 1.6; color: var(--sol-soft); }
  .sol-hero .byline { margin: 0 0 1rem; font-size: 0.92rem; color: #5b6b7d; }
  .sol-hero__cta { margin: 0; }
  .sol-hero__preview { list-style: none; margin: 0; padding: 0.5rem 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; --card-w: 100%; }
  .sol-hero__preview > li { position: relative; aspect-ratio: 5 / 7; width: 100%; min-width: 0; transform: rotate(-4deg); box-shadow: var(--sol-shadow); font-size: clamp(0.9rem, 2vw, 1.3rem); }
  .sol-hero__preview > li:nth-child(even) { transform: rotate(4deg) translateY(10px); }

  /* Game shell */
  .sol { background: #fff; border: 2px solid var(--sol-line); border-radius: 26px; box-shadow: 0 18px 50px -26px rgba(11, 44, 69, 0.4); padding: 1rem; margin: 0 0 2rem; scroll-margin-top: 140px; font-size: 1.1rem; }
  .sol-controls { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.75rem 1.25rem; padding: 0.75rem 0.9rem; background: #f6faff; border: 1px solid var(--sol-line); border-radius: 18px; margin-bottom: 0.75rem; }
  .sol-ctl { display: flex; flex-direction: column; gap: 0.3rem; border: 0; margin: 0; padding: 0; min-width: 0; }
  .sol-ctl--actions { flex-direction: row; flex-wrap: wrap; gap: 0.5rem; margin-left: auto; }
  .sol-label { font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: #5b6b7d; padding: 0; }
  .sol-modes { flex-direction: row; flex-wrap: wrap; align-items: flex-end; gap: 0.35rem; }
  .sol-modes legend { float: left; width: 100%; margin-bottom: 0.3rem; }
  .sol-mode { font: inherit; font-weight: 800; min-height: 52px; padding: 0.4rem 1rem; border-radius: 12px; border: 2px solid var(--sol-line); background: #fff; color: var(--sol-blue); cursor: pointer; }
  .sol-mode.is-on { background: var(--sol-blue); color: #fff; border-color: var(--sol-blue); }
  .sol-controls .sol-btn { min-height: 52px; font-size: 1.02rem; padding: 0.5rem 1.1rem; }
  .sol-status { display: flex; flex-wrap: wrap; gap: 0.3rem 1.25rem; margin: 0 0 0.25rem; padding: 0 0.3rem; color: var(--sol-soft); font-size: 1.02rem; }
  .sol-status strong { color: var(--sol-ink); font-size: 1.2rem; }
  .sol-msg { min-height: 1.6em; margin: 0 0 0.6rem; padding: 0 0.3rem; font-size: 1.05rem; font-weight: 700; color: var(--sol-ink); }

  /* Board */
  .sol-board { --gap: 10px; --card-max: 110px; --card-w: 80px; --card-h: calc(var(--card-w) * 1.4); --off-down: calc(var(--card-h) * 0.14); --off-up: calc(var(--card-h) * 0.3); --radius: calc(var(--card-w) * 0.09);
    position: relative; background: radial-gradient(ellipse at 50% 20%, #2a8456, var(--sol-felt) 55%, var(--sol-felt-dark)); border-radius: 18px; padding: 12px; min-height: 240px; user-select: none; -webkit-user-select: none; font-size: calc(var(--card-w) * 0.26); }
  .sol-board .sol-card, .sol-board .sol-slot, .sol-board .sol-stock { font-size: calc(var(--card-w) * 0.26); }
  .sol-row { display: grid; grid-template-columns: repeat(7, var(--card-w)); gap: var(--gap); justify-content: center; }
  .sol-row--top { margin-bottom: calc(var(--gap) * 1.6); }
  .sol-pile { position: relative; min-height: var(--card-h); border-radius: var(--radius); }
  .sol-pile--waste { grid-column: 2 / span 2; }
  .sol-pile--foundation:nth-child(3) { grid-column: 4; }
  .sol-pile--tableau { padding-bottom: 0; }
  .sol-pile.is-target::after { content: ""; position: absolute; inset: -4px; border-radius: calc(var(--radius) + 4px); border: 3px solid #fde68a; box-shadow: 0 0 0 4px rgba(253, 230, 138, 0.35); pointer-events: none; z-index: 20; }
  .sol-pile--tableau.is-target::after { inset: -4px -4px calc(-1 * var(--gap)); }
  .sol-pile.is-hint .sol-stock { outline: 3px solid #fde68a; outline-offset: 3px; }

  .sol-card { position: absolute; left: 0; top: 0; width: var(--card-w); height: var(--card-h); border-radius: var(--radius); padding: 0; margin: 0; border: 0; font: inherit; line-height: 1; cursor: pointer; background: #fff; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25), 0 3px 8px -4px rgba(0, 0, 0, 0.4); }
  .sol-card.is-up { color: var(--sol-black); border: 1px solid #c9d3df; touch-action: none; }
  .sol-card.is-up.is-red { color: var(--sol-red); }
  .sol-card.is-static { cursor: default; }
  .sol-card.is-down { background: linear-gradient(160deg, #1b4b7a, var(--sol-navy)); border: calc(var(--card-w) * 0.04) solid #fff; cursor: default; }
  .sol-card__back { position: absolute; inset: 10%; border-radius: calc(var(--radius) * 0.6); border: 2px solid rgba(255, 255, 255, 0.45); background: repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.12) 0 4px, transparent 4px 10px); }
  .sol-card__back::after { content: ""; position: absolute; left: 50%; top: 50%; width: 36%; height: 36%; transform: translate(-50%, -50%); border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.55); background: radial-gradient(circle, #fbbf24 0 22%, transparent 24%); }
  .sol-card__idx { position: absolute; top: 5%; left: 7%; display: flex; flex-direction: column; align-items: center; font-weight: 800; font-size: 1em; letter-spacing: -0.02em; }
  .sol-card__idx i { font-style: normal; font-size: 0.85em; margin-top: -0.05em; }
  .sol-card__idx--b { top: auto; left: auto; right: 7%; bottom: 5%; transform: rotate(180deg); }
  .sol-card__pip { position: absolute; left: 50%; top: 54%; transform: translate(-50%, -50%); font-size: 2.1em; }
  .sol-card__court { position: absolute; left: 50%; top: 54%; transform: translate(-50%, -50%); width: 56%; height: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 8%; border: 2px solid currentColor; font-size: 1.15em; background: linear-gradient(180deg, rgba(253, 230, 138, 0.35), rgba(253, 230, 138, 0.08)); }
  .sol-card__court b { font-size: 1.35em; font-weight: 800; line-height: 1; }
  .sol-card.is-selected { box-shadow: 0 0 0 3px #fde68a, 0 0 0 6px rgba(253, 230, 138, 0.4), 0 8px 18px -6px rgba(0, 0, 0, 0.5); z-index: 10; }
  .sol-card.is-hint { box-shadow: 0 0 0 3px #fde68a, 0 0 0 6px rgba(253, 230, 138, 0.4); z-index: 10; }
  .sol-card.is-lifting { opacity: 0.25; }
  .sol-card:focus-visible { outline: 4px solid #fff; outline-offset: 2px; z-index: 12; }
  .sol-slot { position: absolute; left: 0; top: 0; width: var(--card-w); height: var(--card-h); border-radius: var(--radius); border: 2px dashed rgba(255, 255, 255, 0.45); background: rgba(0, 0, 0, 0.12); color: rgba(255, 255, 255, 0.5); font: inherit; font-weight: 800; font-size: 1.6em; display: grid; place-items: center; padding: 0; cursor: pointer; }
  .sol-slot--quiet { cursor: default; }
  .sol-slot:focus-visible { outline: 4px solid #fff; outline-offset: 2px; }
  .sol-stock { position: relative; width: var(--card-w); height: var(--card-h); border-radius: var(--radius); border: 0; padding: 0; background: none; cursor: pointer; font: inherit; touch-action: manipulation; }
  .sol-stock__card { position: absolute; left: calc(var(--k) * 2px); top: calc(var(--k) * -2px); width: var(--card-w); height: var(--card-h); }
  .sol-stock__n { position: absolute; right: -6px; bottom: -8px; min-width: 1.6em; padding: 0.15em 0.4em; border-radius: 999px; background: #fde68a; color: #78350f; font-weight: 800; font-size: 0.75em; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3); }
  .sol-stock.is-empty { border: 2px dashed rgba(255, 255, 255, 0.45); background: rgba(0, 0, 0, 0.12); color: #fff; display: grid; place-items: center; }
  .sol-stock.is-empty[disabled] { opacity: 0.5; cursor: default; }
  .sol-stock__recycle svg { width: 45%; height: 45%; min-width: 24px; min-height: 24px; }
  .sol-stock:focus-visible { outline: 4px solid #fff; outline-offset: 3px; }
  .sol-waste__card { left: 0; }
  .sol-pile--waste.is-fan .sol-waste__card { left: calc(var(--k) * var(--card-w) * 0.4); }
  .sol-drag { position: fixed; left: 0; top: 0; z-index: 1000; pointer-events: none; will-change: transform; filter: drop-shadow(0 10px 14px rgba(0, 0, 0, 0.35)); }
  .sol-drag .sol-card { cursor: grabbing; }
  .sol-noscript { color: #fff; margin: 1rem; text-align: center; }

  /* Panels */
  .sol-win, .sol-note { margin-top: 1rem; text-align: center; background: #fffbeb; border: 2px solid #fcd34d; border-radius: 16px; padding: 1rem; animation: sol-in 0.3s ease both; }
  .sol-note { background: #f6faff; border-color: var(--sol-line); }
  .sol-win__star { display: inline-grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: #facc15; color: #78350f; margin-bottom: 0.3rem; animation: sol-pop 0.5s ease; }
  .sol-win__star svg { width: 32px; height: 32px; }
  .sol-page .sol-win h3, .sol-page .sol-note h3 { margin: 0 0 0.25rem; font-size: 1.3rem; color: var(--sol-ink); }
  .sol-win h3:focus, .sol-note h3:focus { outline: none; }
  .sol-win p, .sol-note p { margin: 0 0 0.6rem; color: var(--sol-soft); font-size: 0.98rem; }
  .sol-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; }

  /* Sections */
  .sol-sec { margin: 0 0 2rem; }
  .sol-page .sol-sec h2, .sol-faq h2, .sol-more h2, .sol-src-h { font-size: clamp(1.5rem, 3vw, 2rem); margin: 0 0 0.8rem; }
  .sol-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .sol-steps li { display: flex; gap: 0.9rem; align-items: flex-start; }
  .sol-steps li > span { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; color: #fff; background: var(--sol-blue); box-shadow: 0 0 0 4px var(--sol-blue-soft); }
  .sol-steps p { margin: 0.35rem 0 0; font-size: 1.08rem; color: var(--sol-soft); }
  .sol-steps strong { color: var(--sol-ink); }
