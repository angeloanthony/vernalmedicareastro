        },
      ];

      var MAX = STAGES.reduce(function (s, st) { return s + st.questions.length * PTS; }, 0);

      // ── State. Saved only at stage completion, only on this device. ──
      function fresh() { return { done: {}, results: {} }; }
      function load() {
        try {
          var raw = window.localStorage.getItem(STORE);
          var s = raw ? JSON.parse(raw) : null;
          return s && s.done && s.results ? s : fresh();
        } catch (e) { return fresh(); }
      }
      function save() {
        try { window.localStorage.setItem(STORE, JSON.stringify(state)); } catch (e) { /* private mode — play still works */ }
      }

      var state = load();
      var run = null; // { stage, q, picks: [], answered: bool }
      // A stage left part-way through during this visit. Kept in memory only, so
      // saved progress still changes only when a stage is finished.
      var paused = null;

      function unlocked(i) { return i === 0 || !!state.done[STAGES[i - 1].id]; }
      function doneCount() { return STAGES.filter(function (s) { return state.done[s.id]; }).length; }
      function correctIn(id) { return (state.results[id] || []).filter(function (p) { return p.c; }).length; }
      function totalScore() { return STAGES.reduce(function (s, st) { return s + correctIn(st.id) * PTS; }, 0); }
      function liveScore() {
        if (!run) return totalScore();
        var st = STAGES[run.stage];
        var prior = state.done[st.id] ? correctIn(st.id) * PTS : 0;
        return totalScore() - prior + run.picks.filter(function (p) { return p.c; }).length * PTS;
      }

      function announce(msg) { live.textContent = ''; window.setTimeout(function () { live.textContent = msg; }, 30); }

      function renderHud() {
        scoreEl.textContent = String(liveScore());
        var n = doneCount();
        progLabel.textContent = n + ' of ' + STAGES.length + ' stages complete';
        barEl.style.width = (n / STAGES.length * 100) + '%';
        badgesEl.innerHTML = STAGES.map(function (s) {
          var got = !!state.done[s.id];
          return '<li class="mag-hud-badge mag-tone-' + s.tone + (got ? ' is-got' : '') + '" title="' + s.badge + (got ? ' badge earned' : ' badge not yet earned') + '">' +
            ICONS[s.icon] + '<span class="mag-sr">' + s.badge + (got ? ' — earned' : ' — not yet earned') + '</span></li>';
        }).join('');
      }

      // Focus moves with each new screen so keyboard and screen-reader users
      // land on it — but not on page load, where it would steal focus.
      var interacted = false;
      function show(html) {
        screen.innerHTML = html;
        renderHud();
        var f = screen.querySelector('[data-focus]');
        if (f && interacted) f.focus({ preventScroll: true });
        var top = root.getBoundingClientRect().top;
        if (top < 0) root.scrollIntoView({ block: 'start' });
      }

      function btn(act, label, cls, extra) {
        return '<button type="button" class="mag-btn ' + (cls || '') + '" data-act="' + act + '"' + (extra || '') + '>' + label + '</button>';
      }

      // ── Map ──
      function renderMap() {
        run = null;
        var next = STAGES.findIndex(function (s) { return !state.done[s.id]; });
        var lead = doneCount() === 0 ? 'Your journey through Medicare starts here. Complete each stage to unlock the next one.' :
          next === -1 ? 'You’ve finished every stage. Replay any stage, or see your final score.' :
          'Welcome back! Stage ' + (next + 1) + ' is ready for you.';
        var html = '<div class="mag-view mag-view--map">' + SCENE +
          '<div class="mag-map-head"><h2 class="mag-title" tabindex="-1" data-focus>The Adventure Map</h2><p class="mag-lead">' + lead + '</p></div>' +
          '<ol class="mag-trail">';
        STAGES.forEach(function (s, i) {
          var isDone = !!state.done[s.id], open = unlocked(i), isNext = i === next;
          var inProg = !!(paused && paused.stage === i);
          var state_ = inProg ? ' is-progress' : isDone ? ' is-done' : open ? ' is-open' : ' is-locked';
          var status, cta;
          if (inProg) { status = 'In progress · ' + paused.picks.length + ' of ' + s.questions.length + ' answered'; cta = 'Continue'; }
          else if (isDone) { status = correctIn(s.id) + ' of ' + s.questions.length + ' correct · ' + s.badge + ' badge'; cta = 'Replay'; }
          else if (open) { status = 'Ready to play'; cta = 'Start Stage ' + (i + 1); }
          else { status = 'Locked — finish Stage ' + i + ' first'; cta = ''; }
          html += '<li class="mag-stop mag-tone-' + s.tone + state_ + (isNext ? ' is-next' : '') + '">' +
            '<button type="button" class="mag-stop-btn" data-act="open" data-i="' + i + '"' + (open ? '' : ' aria-disabled="true"') + '>' +
            '<span class="mag-node" aria-hidden="true">' + (isDone && !inProg ? ICONS.check : String(i + 1)) + '</span>' +
            '<span class="mag-stop-art">' + ILLUS[s.id] + (open ? '' : '<span class="mag-stop-lock">' + ICONS.lock + '</span>') + '</span>' +
            '<span class="mag-stop-num">Stage ' + (i + 1) + '</span>' +
            '<span class="mag-stop-title">' + s.title + '</span>' +
            '<span class="mag-stop-preview">' + PREVIEW[s.id] + '</span>' +
            '<span class="mag-stop-status">' + status + '</span>' +
            (cta ? '<span class="mag-stop-cta">' + cta + ' <span aria-hidden="true">›</span></span>' : '') +
            '</button></li>';
        });
        html += '</ol><div class="mag-actions">';
        if (next === -1) html += btn('final', 'See my final score', 'mag-btn-primary');
        if (doneCount() > 0) html += btn('restart', 'Start the game over', 'mag-btn-ghost');
        html += '</div></div>';
        show(html);
      }

      // ── Stage intro ──
      function renderIntro(i) {
        var s = STAGES[i], resume = !!(paused && paused.stage === i);
        var actions = resume
          ? btn('resume', 'Continue where you left off', 'mag-btn-primary', ' data-i="' + i + '"') + btn('start', 'Start this stage over', 'mag-btn-ghost', ' data-i="' + i + '"')
          : btn('start', 'Start Stage ' + (i + 1), 'mag-btn-primary', ' data-i="' + i + '"');
        show('<div class="mag-view"><div class="mag-banner mag-tone-' + s.tone + '"><span class="mag-banner-icon">' + ILLUS[s.id] + '</span>' +
          '<div><span class="mag-stop-num">Stage ' + (i + 1) + ' of ' + STAGES.length + '</span><h2 class="mag-title" tabindex="-1" data-focus>' + s.title + '</h2></div></div>' +
          '<div class="mag-lesson"><h3>Quick lesson</h3><p>' + s.lesson + '</p><p class="mag-meta">' + s.questions.length + ' questions · ' + (s.questions.length * PTS) + ' points possible · no time limit</p></div>' +
          (resume ? '<p class="mag-resume-note">You’ve answered ' + paused.picks.length + ' of ' + s.questions.length + ' questions in this stage so far.</p>' : '') +
          '<div class="mag-actions">' + actions + btn('map', 'Back to the map', 'mag-btn-ghost') + '</div></div>');
      }

      function matchBoard(s) {
        var opts = s.questions[0].opts;
        return '<div class="mag-board" aria-label="Match board"><p class="mag-board-title">Match board</p><ul>' + opts.map(function (o, oi) {
          var found = null;
          run.picks.forEach(function (p, qi) { if (s.questions[qi].a === oi && s.questions[qi].tag) found = s.questions[qi].tag; });
          return '<li class="' + (found ? 'is-matched' : '') + '"><strong>' + o + '</strong><span>' + (found ? found : '?') + '</span></li>';
        }).join('') + '</ul></div>';
      }

      function calendar(cal) {
        return '<figure class="mag-cal"><div class="mag-cal-grid" aria-hidden="true">' + MONTHS.map(function (m, mi) {
          var on = cal.months.indexOf(mi) > -1;
          return '<span class="mag-cal-m' + (on ? ' is-on' : '') + (cal.key === mi ? ' is-key' : '') + '">' + m + '</span>';
        }).join('') + '</div><figcaption>' + cal.label + '</figcaption></figure>';
      }

      // ── Question ──
      function renderQuestion() {
        var s = STAGES[run.stage], Q = s.questions[run.q], pick = run.picks[run.q];
        var html = '<div class="mag-view"><div class="mag-qhead"><span class="mag-chip mag-tone-' + s.tone + '">' + ICONS[s.icon] + 'Stage ' + (run.stage + 1) + ': ' + s.title + '</span>' +
          '<span class="mag-qcount">Question ' + (run.q + 1) + ' of ' + s.questions.length + '</span></div>' +
          '<div class="mag-dots" aria-hidden="true">' + s.questions.map(function (_, qi) {
            var p = run.picks[qi];
            return '<span class="' + (p ? (p.c ? 'is-right' : 'is-wrong') : qi === run.q ? 'is-now' : '') + '"></span>';
          }).join('') + '</div>';
        if (s.match) html += matchBoard(s);
        html += (Q.prompt ? '<p class="mag-prompt">' + Q.prompt + '</p>' : '') +
          '<h2 class="mag-q" tabindex="-1"' + (pick ? '' : ' data-focus') + '>' + Q.q + '</h2>' +
          '<div class="mag-opts" role="group" aria-label="Answer choices">' + Q.opts.map(function (o, oi) {
            var cls = '';
            if (pick) { if (oi === Q.a) cls = ' is-right'; else if (oi === pick.o) cls = ' is-wrong'; else cls = ' is-dim'; }
            var mark = pick && oi === Q.a ? ICONS.check : pick && oi === pick.o ? ICONS.cross : String.fromCharCode(65 + oi);
            var sr = pick && oi === Q.a ? '<span class="mag-sr"> (correct answer)</span>' : pick && oi === pick.o ? '<span class="mag-sr"> (your answer)</span>' : '';
            return '<button type="button" class="mag-opt' + cls + '" data-act="pick" data-o="' + oi + '"' + (pick ? ' disabled' : '') + '>' +
              '<span class="mag-opt-key">' + mark + '</span><span>' + o + sr + '</span></button>';
          }).join('') + '</div>';
        if (pick) {
          var last = run.q === s.questions.length - 1;
          html += '<div class="mag-fb ' + (pick.c ? 'is-right' : 'is-wrong') + '">' +
            '<p class="mag-fb-title">' + (pick.c ? ICONS.check + 'Correct! +' + PTS + ' points' : ICONS.cross + 'Not quite — the answer is: ' + Q.opts[Q.a]) + '</p>' +
            '<p>' + Q.why + '</p>' + (Q.cal ? calendar(Q.cal) : '') +
            '<div class="mag-actions">' + btn('next', last ? 'Finish the stage' : 'Next question', 'mag-btn-primary', ' data-focus') + '</div></div>';
        }
        html += '<div class="mag-leave">' + btn('map', 'Leave this stage and go back to the map', 'mag-btn-link') + '</div></div>';
        show(html);
      }

      // ── Stage complete ──
      function finishStage() {
        var s = STAGES[run.stage];
        if (paused && paused.stage === run.stage) paused = null;
        state.results[s.id] = run.picks.map(function (p) { return { o: p.o, c: p.c }; });
        state.done[s.id] = true;
        save();
        var i = run.stage, got = correctIn(s.id), n = s.questions.length, perfect = got === n;
        run = null;
        var nextBtn = i < STAGES.length - 1 ? btn('open', 'Continue to Stage ' + (i + 2), 'mag-btn-primary', ' data-i="' + (i + 1) + '"') : btn('final', 'See my final score', 'mag-btn-primary');
        show('<div class="mag-view mag-done">' + confetti() + '<div class="mag-medal mag-tone-' + s.tone + '">' + ILLUS[s.id] + (perfect ? '<span class="mag-medal-star">' + ICONS.star + '</span>' : '') + '</div>' +
          '<h2 class="mag-title" tabindex="-1" data-focus>Badge earned: ' + s.badge + '!</h2>' +
          '<p class="mag-lead">You finished Stage ' + (i + 1) + ', ' + s.title + '. You got <strong>' + got + ' of ' + n + '</strong> correct for <strong>' + (got * PTS) + ' points</strong>.' +
          (perfect ? ' A perfect stage — you earned a gold star!' : ' You can replay this stage any time from the map.') + '</p>' +
          (i < STAGES.length - 1 ? '<p class="mag-unlock">' + ICONS.check + 'Stage ' + (i + 2) + ', ' + STAGES[i + 1].title + ', is now unlocked.</p>' : '') +
          '<div class="mag-keep"><h3>Learn more about this stage</h3><ul>' + s.learn.map(function (l) { return '<li><a href="' + l.href + '">' + l.text + '</a></li>'; }).join('') + '</ul></div>' +
          '<div class="mag-actions">' + nextBtn + btn('map', 'Back to the map', 'mag-btn-ghost') + '</div></div>');
        announce('Stage ' + (i + 1) + ' complete. ' + got + ' of ' + n + ' correct.');
      }

      // ── Final score ──
      function renderFinal() {
        run = null;
        var score = totalScore(), pct = score / MAX;
        var rank = pct >= 0.9 ? 'Medicare Navigator' : pct >= 0.6 ? 'Medicare Explorer' : 'Medicare Learner';
        var msg = pct >= 0.9 ? 'Outstanding! You know your way around Medicare.' :
          pct >= 0.6 ? 'Great job! You have a strong start — review the questions below to fill in the gaps.' :
          'Nice work finishing the adventure! Medicare takes practice. Review the explanations below, then try again.';
        var missed = [];
        STAGES.forEach(function (s, i) {
          (state.results[s.id] || []).forEach(function (r, qi) { if (!r.c) missed.push({ s: s, i: i, Q: s.questions[qi], r: r }); });
        });
        var html = '<div class="mag-view mag-final">' + confetti() + '<div class="mag-medal mag-tone-gold">' + ILLUS.final + '</div>' +
          '<h2 class="mag-title" tabindex="-1" data-focus>Adventure complete!</h2>' +
          '<p class="mag-final-score"><strong>' + score + '</strong> of ' + MAX + ' points</p>' +
          '<p class="mag-rank">Your title: <strong>' + rank + '</strong></p><p class="mag-lead">' + msg + '</p>' +
          '<h3>Your badges</h3><ul class="mag-achieve">' + STAGES.map(function (s) {
            var got = correctIn(s.id), n = s.questions.length;
            return '<li class="mag-tone-' + s.tone + '">' +
              (got === n ? '<span class="mag-achieve-star" title="Perfect stage">' + ICONS.star + '<span class="mag-sr"> Perfect stage</span></span>' : '') +
              '<span class="mag-achieve-art">' + ILLUS[s.id] + '</span><strong>' + s.badge + '</strong>' +
              '<span class="mag-achieve-score">' + s.title + ' · ' + got + ' of ' + n + '</span></li>';
          }).join('') + '</ul>' +
          '<h3>Questions to review' + (missed.length ? ' (' + missed.length + ')' : '') + '</h3>' +
          (missed.length ? '<ol class="mag-missed">' + missed.map(function (m) {
            return '<li><span class="mag-chip mag-tone-' + m.s.tone + '">Stage ' + (m.i + 1) + ': ' + m.s.title + '</span>' +
              '<p class="mag-missed-q">' + (m.Q.prompt ? m.Q.prompt + ' ' : '') + m.Q.q + '</p>' +
              '<p><strong>Correct answer:</strong> ' + m.Q.opts[m.Q.a] + ' <span class="mag-review-you">(you chose: ' + m.Q.opts[m.r.o] + ')</span></p>' +
              '<p>' + m.Q.why + '</p></li>';
          }).join('') + '</ol>' : '<p class="mag-perfect">You answered every question correctly — nothing to review!</p>') +
          '<h3>Review every question</h3>';
        STAGES.forEach(function (s, i) {
          var res = state.results[s.id] || [];
          html += '<details class="mag-review mag-tone-' + s.tone + '"><summary><span>' + ICONS[s.icon] + 'Stage ' + (i + 1) + ': ' + s.title + '</span><span>' + correctIn(s.id) + ' of ' + s.questions.length + ' correct</span></summary><ol>' +
            s.questions.map(function (Q, qi) {
              var r = res[qi], ok = r && r.c;
              return '<li class="' + (ok ? 'is-right' : 'is-wrong') + '"><p class="mag-review-q">' + (ok ? ICONS.check : ICONS.cross) + '<span>' + (Q.prompt ? Q.prompt + ' ' : '') + Q.q + '</span></p>' +
                '<p><strong>Answer:</strong> ' + Q.opts[Q.a] + (ok ? '' : (r ? ' <span class="mag-review-you">(you chose: ' + Q.opts[r.o] + ')</span>' : '')) + '</p><p>' + Q.why + '</p></li>';
            }).join('') + '</ol><p class="mag-review-more">Learn more: ' + s.learn.map(function (l) { return '<a href="' + l.href + '">' + l.text + '</a>'; }).join(' · ') + '</p></details>';
        });
        html += '<p class="mag-note">This game is general education, not advice about your own coverage. For your own situation, check Medicare.gov or talk with a licensed agent.</p>' +
          '<div class="mag-actions">' + btn('replay', 'Play again from the start', 'mag-btn-primary') + btn('map', 'Back to the map', 'mag-btn-ghost') + '</div></div>';
        show(html);
        announce('Adventure complete. ' + score + ' of ' + MAX + ' points.');
      }

      function reset() { state = fresh(); paused = null; save(); }

      root.addEventListener('click', function (e) {
        var t = e.target.closest('[data-act]');
        if (!t || !screen.contains(t)) return;
        interacted = true;
        var act = t.getAttribute('data-act');
        var i = parseInt(t.getAttribute('data-i') || '0', 10);
        if (act === 'open') {
          if (!unlocked(i)) { announce('Stage ' + (i + 1) + ' is locked. Finish Stage ' + i + ' to unlock it.'); return; }
          renderIntro(i);
        } else if (act === 'start') {
          if (paused && paused.stage === i) paused = null;
          run = { stage: i, q: 0, picks: [] };
          renderQuestion();
        } else if (act === 'resume' && paused) {
          run = paused;
          paused = null;
          renderQuestion();
        } else if (act === 'pick' && run && !run.picks[run.q]) {
          var o = parseInt(t.getAttribute('data-o'), 10), Q = STAGES[run.stage].questions[run.q];
          run.picks[run.q] = { o: o, c: o === Q.a };
          renderQuestion();
          announce(o === Q.a ? 'Correct! Plus ' + PTS + ' points.' : 'Not quite. The answer is: ' + Q.opts[Q.a] + '.');
        } else if (act === 'next' && run) {
          if (run.q < STAGES[run.stage].questions.length - 1) { run.q++; renderQuestion(); }
          else finishStage();
        } else if (act === 'map') {
          if (run && run.picks.length) paused = run;
          renderMap();
        } else if (act === 'final') {
          renderFinal();
        } else if (act === 'restart') {
          if (window.confirm('Start over? This erases your points and badges.')) { reset(); renderMap(); }
        } else if (act === 'replay') {
          reset(); renderMap();
        }
      });

      renderMap();
    })();
  </script>
</div>
</StandardPageLayout>

<style is:global>
  /* ── Tokens (page-wide) ─────────────────────────────────────────────── */
  .mag-page {
    --mag-ink: #0b2c45;
    --mag-ink-soft: #334155;
    --mag-line: #d3e0ee;
    --mag-blue: #1d4ed8;
    --mag-blue-soft: #e5edfe;
    --mag-coral: #d0343d;
    --mag-coral-dark: #a8262f;
    --mag-green: #166534;
    --mag-green-soft: #dcfce7;
    --mag-red: #991b1b;
    --mag-red-soft: #fee2e2;
    --mag-amber: #92400e;
    --mag-amber-soft: #fef3c7;
    --mag-purple: #6b21a8;
    --mag-purple-soft: #f3e8ff;
    --mag-gold: #a16207;
    --mag-gold-soft: #fef9c3;
    --mag-shadow: 0 14px 34px -22px rgba(11, 44, 69, 0.55);
    color: var(--mag-ink);
  }
  .mag-page *, .mag-page *::before, .mag-page *::after { box-sizing: border-box; }
  .mag-page svg { flex: none; }
  .mag-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .mag-page a { color: var(--mag-blue); }
  .mag-page a:focus-visible, .mag-page button:focus-visible, .mag-page summary:focus-visible { outline: 4px solid #f59e0b; outline-offset: 3px; }
  .mag-page .mag-sec-h { font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.2; font-weight: 800; color: var(--mag-ink); margin: 0 0 0.75rem; }
  .mag-page .mag-sec-h--accent { color: var(--mag-coral); }
  .mag-sec-sub { margin: -0.25rem 0 1rem; color: var(--mag-ink-soft); font-size: 1.05rem; }

  /* Shared expand/collapse indicator: a plus that turns into a minus. */
  .mag-plus { margin-left: auto; width: 30px; height: 30px; flex: none; border-radius: 50%; display: grid; place-items: center; color: var(--mag-coral); background: #fff1f1; transition: transform 0.2s ease; }
  .mag-plus svg { width: 16px; height: 16px; }
  details[open] > summary .mag-plus { transform: rotate(45deg); }
  .mag-page summary { list-style: none; cursor: pointer; }
  .mag-page summary::-webkit-details-marker { display: none; }
  .mag-page details[open] > summary ~ * { animation: mag-in 0.25s ease both; }

  /* ── Hero ───────────────────────────────────────────────────────────── */
  .mag-hero {
    display: grid; grid-template-columns: 1.05fr 1fr; gap: 2rem; align-items: center;
    background: linear-gradient(180deg, #eef7ff 0%, #ffffff 100%);
    border: 1px solid var(--mag-line); border-radius: 26px; padding: 2rem 2.25rem; margin: 0.5rem 0 1.5rem;
  }
  .mag-hero h1 { font-size: clamp(2rem, 4.2vw, 3rem); line-height: 1.08; font-weight: 800; color: var(--mag-ink); margin: 0 0 0.6rem; }
  .mag-hero h1 span { display: block; }
  .mag-hero .mag-hero__accent { color: var(--mag-coral); }
  .mag-hero__tag { font-size: 1.2rem; font-weight: 700; color: var(--mag-ink); margin: 0 0 0.75rem; }
  .mag-hero .summary-block { background: none; border: 0; padding: 0; margin: 0 0 0.6rem; box-shadow: none; }
  .mag-hero .summary-block p { margin: 0; font-size: 1.05rem; line-height: 1.6; color: var(--mag-ink-soft); }
  .mag-hero .byline { margin: 0 0 1rem; font-size: 0.92rem; color: #5b6b7d; }
  .mag-callout { display: flex; gap: 0.8rem; align-items: flex-start; background: #fff; border: 1px solid var(--mag-line); border-radius: 16px; padding: 0.9rem 1.1rem; box-shadow: var(--mag-shadow); }
  .mag-callout__icon { flex: none; width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; background: var(--mag-blue-soft); color: var(--mag-blue); }
  .mag-callout__icon svg { width: 24px; height: 24px; }
  .mag-callout p { margin: 0; font-size: 1rem; line-height: 1.5; color: var(--mag-ink-soft); }
  .mag-callout strong { display: block; color: var(--mag-ink); }
  .mag-callout a { font-weight: 800; }
  .mag-hero__art { width: 100%; height: auto; display: block; filter: drop-shadow(0 18px 30px rgba(11, 44, 69, 0.18)); }

  /* ── Game shell ─────────────────────────────────────────────────────── */
  .mag {
    font-size: 1.15rem; line-height: 1.55; color: var(--mag-ink);
    background: linear-gradient(180deg, #f2f8ff 0%, #ffffff 320px);
    border: 2px solid var(--mag-line); border-radius: 26px;
    box-shadow: 0 18px 50px -26px rgba(11, 44, 69, 0.4);
    padding: 1.25rem; margin: 0 0 1.5rem;
  }
  .mag svg { width: 1em; height: 1em; }
  .mag h2, .mag h3 { color: var(--mag-ink); }
  .mag-noscript { font-weight: 700; padding: 1rem; }

  /* Tones — each stage has its own color, always paired with an icon and text. */
  .mag-page .mag-tone-blue { --t: var(--mag-blue); --ts: var(--mag-blue-soft); }
  .mag-page .mag-tone-green { --t: var(--mag-green); --ts: var(--mag-green-soft); }
  .mag-page .mag-tone-amber { --t: var(--mag-amber); --ts: var(--mag-amber-soft); }
  .mag-page .mag-tone-purple { --t: var(--mag-purple); --ts: var(--mag-purple-soft); }
  .mag-page .mag-tone-gold { --t: var(--mag-gold); --ts: var(--mag-gold-soft); }

  /* ── HUD ────────────────────────────────────────────────────────────── */
  .mag-hud { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; padding: 0.9rem 1.1rem; background: #fff; border: 2px solid var(--mag-line); border-radius: 18px; margin-bottom: 1.25rem; }
  .mag-hud-star { width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center; background: radial-gradient(circle at 35% 30%, #fde68a, #f59e0b 70%); color: #fff; box-shadow: inset 0 -3px 0 rgba(146, 64, 14, 0.35), 0 6px 14px -8px rgba(146, 64, 14, 0.8); }
  .mag-hud-star svg { width: 30px; height: 30px; filter: drop-shadow(0 1px 0 rgba(146, 64, 14, 0.5)); }
  .mag-hud-label { display: block; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mag-ink-soft); }
  .mag-hud-num { display: block; font-size: 2rem; font-weight: 800; line-height: 1.05; color: var(--mag-ink); font-variant-numeric: tabular-nums; }
  .mag-hud-prog { flex: 1 1 220px; }
  .mag-bar { height: 14px; background: var(--mag-blue-soft); border-radius: 8px; overflow: hidden; margin-top: 6px; }
  .mag-bar-fill { height: 100%; width: 0; background: linear-gradient(90deg, #2563eb, #38bdf8); border-radius: 8px; transition: width 0.5s ease; }
  .mag-hud-badges { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .mag-hud-badge { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; font-size: 1.3rem; background: #f1f5f9; color: #94a3b8; border: 2px dashed #cbd5e1; }
  .mag-hud-badge.is-got { background: var(--ts); color: var(--t); border: 2px solid var(--t); animation: mag-pop 0.4s ease; }

  /* ── Shared game pieces ─────────────────────────────────────────────── */
  .mag-view { animation: mag-in 0.35s ease both; position: relative; }
  .mag .mag-title { font-size: 1.75rem; line-height: 1.25; margin: 0 0 0.5rem; }
  .mag .mag-title:focus, .mag .mag-q:focus { outline: none; }
  .mag .mag-title:focus-visible, .mag .mag-q:focus-visible { outline: 3px dashed var(--mag-blue); outline-offset: 4px; }
  .mag-lead { font-size: 1.15rem; color: var(--mag-ink-soft); margin: 0 0 1rem; }
  .mag-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
  .mag-btn { font: inherit; font-weight: 800; font-size: 1.15rem; min-height: 60px; padding: 0.75rem 1.5rem; border-radius: 999px; cursor: pointer; border: 2px solid transparent; transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease; }
  .mag-btn-primary { background: var(--mag-coral); color: #fff; box-shadow: 0 5px 0 var(--mag-coral-dark); }
  .mag-btn-primary:hover { background: #bb2d36; transform: translateY(-1px); }
  .mag-btn-primary:active { transform: translateY(3px); box-shadow: 0 2px 0 var(--mag-coral-dark); }
  .mag-btn-ghost { background: #fff; color: var(--mag-blue); border-color: var(--mag-line); }
  .mag-btn-ghost:hover { border-color: var(--mag-blue); background: var(--mag-blue-soft); }
  .mag-btn-ghost:active { transform: translateY(2px); }
  .mag-leave { margin-top: 1.25rem; border-top: 1px solid #e2e8f0; padding-top: 0.5rem; }
  .mag-btn-link { min-height: 48px; padding: 0.5rem 0; background: none; color: var(--mag-blue); text-decoration: underline; font-size: 1.05rem; font-weight: 700; border-radius: 6px; }

  /* ── Adventure map ──────────────────────────────────────────────────── */
  .mag-view--map {
    border-radius: 20px; padding: 1.25rem 1rem 1.5rem; overflow: hidden;
    background: linear-gradient(180deg, #e3f2fe 0%, #f1f9ff 140px, #e9f7e4 300px, #dcf1d2 100%);
  }
  .mag-scene { position: absolute; left: 0; top: 64px; width: 100%; height: 190px; pointer-events: none; }
  .mag-map-head, .mag-trail, .mag-view--map .mag-actions { position: relative; }
  .mag-map-head .mag-title { font-size: clamp(1.7rem, 3.4vw, 2.2rem); }

  .mag-trail { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 1.4rem; }
  .mag-trail::before { content: ''; position: absolute; left: 52px; top: 30px; bottom: 30px; border-left: 6px dashed #c8a56a; }
  .mag-stop { position: relative; }
  .mag-stop-btn {
    position: relative; width: 100%; height: 100%;
    display: grid; grid-template-columns: 76px 1fr; column-gap: 1rem; align-items: center; align-content: center;
    text-align: left; font: inherit; color: inherit; cursor: pointer;
    background: #fff; border: 2px solid var(--mag-line); border-radius: 20px; padding: 1.2rem 1rem 1rem;
    box-shadow: var(--mag-shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .mag-stop-art { grid-row: 1 / span 6; position: relative; width: 76px; height: 76px; }
  .mag-stop-art > svg { width: 100%; height: 100%; }
  .mag-stop-num, .mag-stop-title, .mag-stop-preview, .mag-stop-status, .mag-stop-cta { grid-column: 2; }
  .mag-node {
    position: absolute; top: -16px; left: -10px; z-index: 1;
    width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center;
    font-weight: 800; font-size: 1.1rem; background: #fff; color: var(--mag-ink); border: 3px solid var(--mag-line);
  }
  .mag-node svg { width: 18px; height: 18px; }
  .mag-stop-num { font-size: 0.82rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.07em; color: #5b6b7d; }
  .mag-stop-title { font-size: 1.25rem; font-weight: 800; line-height: 1.2; color: var(--mag-ink); }
  .mag-stop-preview { font-size: 1rem; line-height: 1.4; color: var(--mag-ink-soft); margin-top: 0.15rem; }
  .mag-stop-status { font-size: 0.95rem; font-weight: 700; color: var(--t); margin-top: 0.3rem; }
  .mag-stop-cta { justify-self: start; display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.6rem; padding: 0.5rem 1.1rem; border-radius: 999px; font-size: 1rem; font-weight: 800; background: var(--mag-coral); color: #fff; box-shadow: 0 3px 0 var(--mag-coral-dark); }
  .mag-stop-lock { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: #475569; border: 3px solid #94a3b8; }
  .mag-stop-lock svg { width: 18px; height: 18px; }

  .mag-stop:not(.is-locked) .mag-stop-btn:hover { transform: translateY(-4px); border-color: var(--t); box-shadow: 0 22px 36px -22px rgba(11, 44, 69, 0.65); }
  .mag-stop:not(.is-locked) .mag-stop-btn:active { transform: translateY(1px); box-shadow: 0 8px 16px -14px rgba(11, 44, 69, 0.6); }
  .mag-stop.is-next .mag-stop-btn { border-color: var(--mag-blue); box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.16), 0 22px 36px -22px rgba(11, 44, 69, 0.6); }
  .mag-stop.is-next .mag-node { background: var(--mag-blue); color: #fff; border-color: #fff; animation: mag-pulse 2.2s ease-in-out infinite; }
  .mag-stop.is-done .mag-node { background: var(--mag-green); color: #fff; border-color: #fff; }
  .mag-stop.is-done .mag-stop-cta { background: #fff; color: var(--mag-green); border: 2px solid var(--mag-green); box-shadow: none; }
  .mag-stop.is-progress .mag-stop-btn { border-color: #d97706; }
  .mag-stop.is-progress .mag-node { background: #d97706; color: #fff; border-color: #fff; }
  .mag-stop.is-progress .mag-stop-status { color: var(--mag-amber); }
  .mag-stop.is-progress .mag-stop-cta { background: #b45309; box-shadow: 0 3px 0 #7c2d12; }
  .mag-stop.is-locked .mag-stop-btn { background: #f6f8fb; border-style: dashed; cursor: not-allowed; box-shadow: none; }
  .mag-stop.is-locked .mag-stop-art > svg { filter: grayscale(1); opacity: 0.4; }
  .mag-stop.is-locked .mag-stop-title { color: #475569; }
  .mag-stop.is-locked .mag-stop-status { color: #475569; }

  @media (min-width: 980px) {
    .mag-trail { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; align-items: stretch; padding-top: 0.5rem; }
    .mag-trail::before { left: 3%; right: 3%; top: 48%; bottom: auto; border-left: 0; border-top: 6px dashed #c8a56a; }
    .mag-stop:nth-child(even) { margin-top: 2.25rem; }
    .mag-stop:nth-child(odd) { margin-bottom: 2.25rem; }
    .mag-stop-btn { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; text-align: center; padding: 1.7rem 0.75rem 1rem; }
    .mag-stop-art { width: 84px; height: 84px; margin-bottom: 0.45rem; }
    .mag-node { left: 50%; top: -19px; margin-left: -19px; }
    .mag-stop-title { font-size: 1.15rem; }
    .mag-stop-preview { font-size: 0.95rem; }
    .mag-stop-status { font-size: 0.9rem; }
    .mag-stop-cta { margin-top: auto; justify-self: auto; font-size: 0.98rem; }
    .mag-stop-status { margin-bottom: 0.7rem; }
  }

  /* ── Stage intro ────────────────────────────────────────────────────── */
  .mag-banner { display: flex; align-items: center; gap: 1rem; padding: 1.1rem 1.25rem; border-radius: 20px; background: var(--ts); border: 2px solid var(--t); margin-bottom: 1rem; }
  .mag-banner-icon { flex: none; width: 84px; height: 84px; border-radius: 22px; display: grid; place-items: center; background: #fff; box-shadow: 0 8px 18px -12px rgba(11, 44, 69, 0.6); transform: rotate(-4deg); padding: 8px; }
  .mag-banner-icon svg { width: 100%; height: 100%; }
  .mag-banner .mag-title { margin: 0; }
  .mag-lesson { background: #fff; border: 2px solid var(--mag-line); border-radius: 18px; padding: 1rem 1.25rem; }
  .mag-lesson h3 { margin: 0 0 0.35rem; font-size: 1.15rem; }
  .mag-lesson p { margin: 0 0 0.5rem; }
  .mag-meta { font-size: 1rem; font-weight: 700; color: var(--mag-ink-soft); }
  .mag-resume-note { margin: 1rem 0 0; padding: 0.75rem 1rem; border-radius: 14px; background: var(--mag-amber-soft); color: var(--mag-amber); font-weight: 700; font-size: 1.05rem; }

  /* ── Question ───────────────────────────────────────────────────────── */
  .mag-qhead { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
  .mag-chip { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 1rem; font-weight: 800; padding: 0.35rem 0.8rem; border-radius: 999px; background: var(--ts); color: var(--t); }
  .mag-qcount { font-size: 1rem; font-weight: 700; color: var(--mag-ink-soft); }
  .mag-dots { display: flex; gap: 8px; margin: 0.25rem 0 1rem; }
  .mag-dots span { width: 16px; height: 16px; border-radius: 50%; background: #e2e8f0; border: 2px solid #cbd5e1; }
  .mag-dots .is-now { background: #fff; border-color: var(--mag-blue); box-shadow: 0 0 0 3px var(--mag-blue-soft); }
  .mag-dots .is-right { background: var(--mag-green); border-color: var(--mag-green); }
  .mag-dots .is-wrong { background: #fff; border-color: var(--mag-red); }
  .mag-prompt { margin: 0 0 0.25rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.95rem; color: var(--mag-ink-soft); }
  .mag .mag-q { font-size: 1.45rem; line-height: 1.35; margin: 0 0 1rem; }
  .mag-opts { display: grid; gap: 0.75rem; }
  .mag-opt { display: flex; align-items: center; gap: 0.9rem; width: 100%; min-height: 64px; text-align: left; font: inherit; font-size: 1.15rem; font-weight: 600; color: var(--mag-ink); background: #fff; border: 2px solid var(--mag-line); border-radius: 16px; padding: 0.8rem 1rem; cursor: pointer; transition: transform 0.12s ease, border-color 0.12s ease, background 0.12s ease; }
  .mag-opt:not([disabled]):hover { border-color: var(--mag-blue); background: var(--mag-blue-soft); transform: translateX(3px); }
  .mag-opt:not([disabled]):active { transform: translateX(1px) scale(0.995); }
  .mag-opt[disabled] { cursor: default; }
  .mag-opt-key { flex: none; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; font-weight: 800; background: var(--mag-blue-soft); color: var(--mag-blue); }
  .mag-opt.is-right { border-color: var(--mag-green); background: var(--mag-green-soft); animation: mag-pop 0.35s ease; }
  .mag-opt.is-right .mag-opt-key { background: var(--mag-green); color: #fff; }
  .mag-opt.is-wrong { border-color: var(--mag-red); background: var(--mag-red-soft); animation: mag-shake 0.35s ease; }
  .mag-opt.is-wrong .mag-opt-key { background: var(--mag-red); color: #fff; }
  .mag-opt.is-dim { color: #475569; }

  .mag-board { background: #fff; border: 2px dashed var(--mag-line); border-radius: 16px; padding: 0.75rem 1rem; margin-bottom: 1rem; }
  .mag-board-title { margin: 0 0 0.5rem; font-size: 0.9rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mag-ink-soft); }
  .mag-board ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.5rem; }
  .mag-board li { display: flex; flex-direction: column; padding: 0.5rem 0.75rem; border-radius: 12px; background: #f1f5f9; font-size: 1rem; }
  .mag-board li span { color: #64748b; }
  .mag-board li.is-matched { background: var(--mag-green-soft); animation: mag-pop 0.4s ease; }
  .mag-board li.is-matched span { color: var(--mag-green); font-weight: 700; }

  .mag-fb { margin-top: 1.1rem; border-radius: 16px; padding: 1rem 1.25rem; border: 2px solid; animation: mag-in 0.3s ease both; }
  .mag-fb.is-right { background: var(--mag-green-soft); border-color: var(--mag-green); }
  .mag-fb.is-wrong { background: #fff7ed; border-color: #c2410c; }
  .mag-fb p { margin: 0 0 0.5rem; }
  .mag-fb-title { display: flex; align-items: center; gap: 0.5rem; font-size: 1.25rem; font-weight: 800; }
  .mag-fb.is-right .mag-fb-title { color: var(--mag-green); }
  .mag-fb.is-wrong .mag-fb-title { color: #9a3412; }

  .mag-cal { margin: 0.75rem 0 0; }
  .mag-cal-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }
  .mag-cal-m { text-align: center; font-weight: 700; font-size: 1rem; padding: 0.45rem 0; border-radius: 10px; background: #fff; color: #64748b; border: 2px solid #e2e8f0; }
  .mag-cal-m.is-on { background: var(--mag-amber-soft); color: var(--mag-amber); border-color: #d97706; }
  .mag-cal-m.is-key { background: var(--mag-amber); color: #fff; border-color: var(--mag-amber); }
  .mag-cal figcaption { margin-top: 0.4rem; font-weight: 700; font-size: 1rem; color: var(--mag-ink-soft); }
  @media (min-width: 640px) { .mag-cal-grid { grid-template-columns: repeat(12, 1fr); } }

  /* ── Stage complete + final ─────────────────────────────────────────── */
  .mag-done, .mag-final { text-align: center; overflow: hidden; border-radius: 20px; padding: 0.5rem 0.25rem; }
  .mag-done .mag-actions, .mag-final .mag-actions { justify-content: center; }
  .mag-medal { position: relative; width: 128px; height: 128px; margin: 0.75rem auto 1rem; border-radius: 50%; display: grid; place-items: center; padding: 18px; background: radial-gradient(circle at 35% 30%, #fff, var(--ts) 70%); border: 5px solid var(--t); box-shadow: 0 0 0 8px var(--ts), 0 16px 30px -16px rgba(11, 44, 69, 0.7); animation: mag-medal 0.6s cubic-bezier(.2, 1.4, .4, 1) both; }
  .mag-medal > svg { width: 100%; height: 100%; }
  .mag-medal-star { position: absolute; top: -8px; right: -8px; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; font-size: 1.6rem; background: #facc15; color: #78350f; border: 3px solid #fff; animation: mag-pop 0.5s 0.4s ease both; }
  .mag-unlock { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; color: var(--mag-green); background: var(--mag-green-soft); padding: 0.5rem 1rem; border-radius: 999px; }
  .mag-keep { text-align: left; background: #fff; border: 2px solid var(--mag-line); border-radius: 16px; padding: 0.9rem 1.25rem; margin-top: 1rem; }
  .mag-keep h3 { margin: 0 0 0.35rem; font-size: 1.1rem; }
  .mag-keep ul { margin: 0; padding-left: 1.2rem; }
  .mag a { color: var(--mag-blue); font-weight: 700; }

  .mag-confetti { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .mag-confetti i { position: absolute; top: -16px; left: var(--x); width: 10px; height: 16px; border-radius: 3px; background: var(--c); opacity: 0; transform: rotate(var(--r)); animation: mag-fall 2.2s ease-in var(--d) forwards; }

  .mag-final .mag-medal { width: 140px; height: 140px; }
  .mag-final-score { font-size: 1.35rem; margin: 0; }
  .mag-final-score strong { font-size: 3.2rem; color: var(--mag-ink); font-variant-numeric: tabular-nums; }
  .mag-rank { font-size: 1.2rem; margin: 0.25rem 0 0.5rem; }
  .mag-final h3 { text-align: left; margin: 1.5rem 0 0.6rem; font-size: 1.3rem; }
  .mag-achieve { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; text-align: center; }
  .mag-achieve li { position: relative; background: #fff; border: 2px solid var(--t); border-radius: 18px; padding: 0.9rem 0.6rem 0.8rem; }
  .mag-achieve-art { display: block; width: 64px; height: 64px; margin: 0 auto 0.35rem; }
  .mag-achieve-art svg { width: 100%; height: 100%; }
  .mag-achieve strong { display: block; font-size: 1.05rem; color: var(--t); }
  .mag-achieve span.mag-achieve-score { display: block; font-size: 0.95rem; color: var(--mag-ink-soft); }
  .mag-achieve-star { position: absolute; top: 8px; right: 8px; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-size: 1.05rem; background: #facc15; color: #78350f; }
  .mag-missed { text-align: left; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .mag-missed li { background: #fff7ed; border: 2px solid #fdba74; border-radius: 16px; padding: 0.9rem 1.1rem; }
  .mag-missed p { margin: 0 0 0.35rem; font-size: 1.05rem; }
  .mag-missed .mag-chip { font-size: 0.9rem; margin-bottom: 0.4rem; }
  .mag-missed-q { font-weight: 700; }
  .mag-perfect { text-align: left; font-weight: 700; color: var(--mag-green); background: var(--mag-green-soft); border-radius: 14px; padding: 0.8rem 1rem; }
  .mag-review { text-align: left; background: #fff; border: 2px solid var(--mag-line); border-left: 8px solid var(--t); border-radius: 14px; margin-bottom: 0.6rem; }
  .mag-review summary { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; padding: 0.9rem 1rem; min-height: 56px; font-weight: 800; }
  .mag-review summary span:first-child { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--t); }
  .mag-review ol { margin: 0; padding: 0 1rem 0.5rem 2.2rem; }
  .mag-review li { padding: 0.6rem 0; border-top: 1px solid #e2e8f0; }
  .mag-review li p { margin: 0 0 0.3rem; font-size: 1.05rem; }
  .mag-review-q { display: flex; gap: 0.5rem; font-weight: 700; }
  .mag-review li.is-right .mag-review-q svg { color: var(--mag-green); margin-top: 0.3em; }
  .mag-review li.is-wrong .mag-review-q svg { color: var(--mag-red); margin-top: 0.3em; }
  .mag-review-you { color: var(--mag-ink-soft); }
  .mag-review-more { padding: 0 1rem 0.9rem; margin: 0; font-size: 1rem; }
  .mag-note { font-size: 1rem; color: var(--mag-ink-soft); margin-top: 1rem; }

  /* ── Feature trio ───────────────────────────────────────────────────── */
  .mag-trio { list-style: none; margin: 0 0 2rem; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .mag-trio li { display: flex; gap: 0.9rem; align-items: flex-start; background: #fff; border: 1px solid var(--mag-line); border-radius: 18px; padding: 1.1rem 1.2rem; box-shadow: var(--mag-shadow); }
  .mag-trio__icon { flex: none; width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; background: #f1f7ff; }
  .mag-trio__icon svg { width: 38px; height: 38px; }
  .mag-page .mag-trio h3 { margin: 0 0 0.2rem; font-size: 1.15rem; color: var(--mag-blue); }
  .mag-trio p { margin: 0; color: var(--mag-ink-soft); font-size: 1rem; line-height: 1.5; }

  /* ── How to play ────────────────────────────────────────────────────── */
  .mag-howto { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; align-items: center; margin: 0 0 2rem; }
  .mag-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
