---
// src/pages/medicare-adventure-game.astro — "Medicare Adventure", a five-stage
// educational board game that runs entirely in the browser (no server, no
// signup). Built on StandardPageLayout with bareHeader + bareFooter: the page
// draws its own illustrated hero, FAQ, sources, related tools and CTA band, but
// reuses SummaryBlock / AuthorByline / SourcesList / PageCTA so every editorial
// marker the gate scores is still the real component. Not CalculatorPage: a
// game is not a HowTo, so the primary schema stays WebPage.
//
// Accuracy: every question was checked against Medicare.gov on 2026-10-20
// (pages listed in `sources`). The game deliberately avoids dollar amounts that
// change every year — the only numbers in it are fixed rules (7-month IEP,
// 24 months of disability benefits, 8-month SEP, 10% Part B penalty, 63 days)
// and clearly-labelled examples ("like $20", "like 20%").
//
// Styles are `is:global` but every selector is prefixed with `.mag`: the game
// builds its screens with innerHTML, and Astro's scoped attribute selectors do
// not match elements created at runtime. All illustrations are inline SVG —
// no image requests beyond the agent photo already used across the site.
import StandardPageLayout from '../components/layout/StandardPageLayout.astro';
import SummaryBlock from '../components/SummaryBlock.astro';
import AuthorByline from '../components/content/AuthorByline.astro';
import SourcesList from '../components/content/SourcesList.astro';
import PageCTA from '../components/content/PageCTA.astro';
import { BUSINESS } from '../data/business';
import type { PageContext } from '../types/Page';

const context: PageContext = {
  page: {
    title: 'Medicare Adventure Game | Learn Medicare by Playing | Vernal Medicare',
    heading: 'Medicare Adventure: Learn Medicare by Playing',
    description:
      'A free, no-signup Medicare learning game. Travel five stages — Medicare basics, Parts A–D, enrollment periods, and costs — earn points and badges, and learn why each answer is right.',
    taxonomy: { silo: 'tools', tags: ['tools', 'game', 'quiz', 'medicare-101', 'turning-65', 'enrollment', 'costs'] },
    summary:
      'Medicare Adventure is a free game that teaches Medicare basics in five short stages: who Medicare is for, what Parts A, B, C, and D do, when you can sign up or make changes, and what premiums, deductibles, copayments, and coinsurance mean. There is no time limit and no signup. Every answer comes with a plain-English explanation and a link to learn more. It is general education, not advice about your own coverage.',
    faqs: [
      {
        question: 'Is the Medicare Adventure game free?',
        answer:
          'Yes. It is free, needs no signup, and runs right in your web browser. Your progress is saved only on your own device so you can come back later.',
      },
      {
        question: 'Is there a time limit?',
        answer:
          'No. Take as long as you like on every question. You can leave and come back, replay any stage you have finished, or start the whole game over.',
      },
      {
        question: 'Will the game tell me which Medicare plan to choose?',
        answer:
          'No. The game teaches general Medicare concepts. Your own choices depend on your doctors, prescriptions, budget, and situation — for that, use Medicare.gov or talk with a licensed agent.',
      },
      {
        question: 'Where do the answers come from?',
        answer:
          'Each question was checked against official Medicare.gov pages, listed in the sources below. Medicare rules and costs can change each year, so always confirm details for your situation.',
      },
    ],
    sources: [
      { title: 'Get started with Medicare', url: 'https://www.medicare.gov/basics/get-started-with-medicare', publisher: 'Medicare.gov' },
      { title: 'When can I sign up for Medicare?', url: 'https://www.medicare.gov/basics/get-started-with-medicare/sign-up/when-can-i-sign-up-for-medicare', publisher: 'Medicare.gov' },
      { title: 'When does Medicare coverage start?', url: 'https://www.medicare.gov/basics/get-started-with-medicare/sign-up/when-does-medicare-coverage-start', publisher: 'Medicare.gov' },
      { title: 'Joining a health or drug plan', url: 'https://www.medicare.gov/basics/get-started-with-medicare/get-more-coverage/joining-a-plan', publisher: 'Medicare.gov' },
      { title: 'What Part A covers', url: 'https://www.medicare.gov/what-medicare-covers/what-part-a-covers', publisher: 'Medicare.gov' },
      { title: 'What Part B covers', url: 'https://www.medicare.gov/what-medicare-covers/what-part-b-covers', publisher: 'Medicare.gov' },
      { title: 'Medicare costs', url: 'https://www.medicare.gov/basics/costs/medicare-costs', publisher: 'Medicare.gov' },
      { title: 'Avoid late enrollment penalties', url: 'https://www.medicare.gov/basics/costs/medicare-costs/avoid-penalties', publisher: 'Medicare.gov' },
      { title: 'What’s not covered by Original Medicare', url: 'https://www.medicare.gov/providers-services/original-medicare/not-covered', publisher: 'Medicare.gov' },
      { title: 'Medigap basics', url: 'https://www.medicare.gov/health-drug-plans/medigap/basics', publisher: 'Medicare.gov' },
    ],
  },
  meta: {
    canonical: 'https://vernalmedicare.com/medicare-adventure-game.html',
    ogType: 'website',
    ogTitle: 'Medicare Adventure — Learn Medicare by Playing',
    ogDescription: 'A free five-stage game that teaches Medicare Parts A–D, enrollment periods, and costs in plain English.',
  },
  author: 'rocco',
  datePublished: '2026-10-20',
  lastUpdated: '2026-10-21',
  medicalDisclaimer:
    'Medicare Adventure is general education only. It does not determine your eligibility, enrollment rights, or costs, and it does not recommend any plan or carrier. Rules and amounts can change each year — confirm your options with Medicare.gov, Social Security, or a licensed agent.',
  breadcrumb: [
    { name: 'Home', href: '/' },
    { name: 'Calculators', href: '/medicare-calculators.html' },
    { name: 'Medicare Adventure Game', href: '/medicare-adventure-game.html' },
  ],
};
const { page } = context;

// What each stage covers — titles and links match the game's own STAGES data.
// Previews describe the subject only; they never give away an answer.
const LEARN = [
  { title: 'Meet Medicare', teaser: 'Who Medicare is for and how it works.',
    body: 'Who Medicare is for, what “Original Medicare” means, and how some younger people can qualify.',
    links: [{ href: '/turning-65.html', text: 'Turning 65: your Medicare checklist' }, { href: '/medicare-coverage.html', text: 'What Medicare covers' }] },
  { title: 'Discover the Parts', teaser: 'What Parts A, B, C, and D do.',
    body: 'Match Parts A, B, C, and D to the kinds of care each one helps pay for.',
    links: [{ href: '/medicare-part-a-vs-part-b.html', text: 'Part A vs. Part B' }, { href: '/medicare-advantage-plans-vernal.html', text: 'Medicare Advantage (Part C)' }, { href: '/part-d-plans-vernal.html', text: 'Part D drug plans' }] },
  { title: 'Enrollment Calendar', teaser: 'When you can sign up or make changes.',
    body: 'Calendar puzzles about the Initial Enrollment Period, fall Open Enrollment, the General Enrollment Period, and Special Enrollment Periods.',
    links: [{ href: '/medicare-enrollment-periods.html', text: 'Medicare enrollment periods explained' }, { href: '/medicare-general-enrollment-period.html', text: 'The General Enrollment Period' }, { href: '/working-past-65.html', text: 'Working past 65' }] },
  { title: 'Cost Puzzle', teaser: 'Premiums, deductibles, copayments, and coinsurance.',
    body: 'Match the four cost words you’ll see on every plan to what they mean.',
    links: [{ href: '/medicare-costs.html', text: 'Medicare costs' }, { href: '/medicare-glossary.html', text: 'Medicare glossary' }] },
  { title: 'Final Challenge', teaser: 'Mixed questions to put it all together.',
    body: 'Mixed questions on Medigap, yearly out-of-pocket limits, what Original Medicare doesn’t cover, and late enrollment penalties.',
    links: [{ href: '/medigap.html', text: 'Medigap (Medicare Supplement)' }, { href: '/medicare-supplement-vs-advantage.html', text: 'Medigap vs. Medicare Advantage' }, { href: '/delaying-medicare-part-b.html', text: 'Delaying Part B' }] },
];

const TERMS = [
  { term: 'Premium', def: 'The amount you pay for your coverage, usually every month — even in months you don’t use any care.' },
  { term: 'Deductible', def: 'What you pay for covered care each year before Medicare or your plan starts to pay.' },
  { term: 'Copayment', def: 'A set dollar amount you pay for a covered service, like a doctor visit. It stays the same no matter what the service costs.' },
  { term: 'Coinsurance', def: 'A percentage of the cost you pay for a covered service, usually after your deductible — so what you pay goes up or down with the cost.' },
];

const TOOLS = [
  { href: '/medicare-calculators.html', name: 'Free Medicare Calculators', desc: 'Estimate costs, penalties, and important dates.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"/><rect x="8" y="6" width="8" height="3" rx="0.6"/><path d="M8.5 13h.01M12 13h.01M15.5 13h.01M8.5 16.5h.01M12 16.5h.01M15.5 16.5h.01"/></svg>' },
  { href: '/medicare-quiz.html', name: 'Medicare Plan Quiz', desc: 'Seven questions to see which type of coverage may fit you.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1"/><path d="M8.5 10l1.5 1.5L13 8.5M8.5 15.5l1.5 1.5 3-3"/></svg>' },
  { href: '/medicare-eligibility-calculator.html', name: 'Eligibility & Timeline Calculator', desc: 'See when you qualify and your enrollment dates.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path d="M8 14h2M12 14h2M8 17h2"/></svg>' },
  { href: '/turning-65.html', name: 'Turning 65: Your Medicare Step-by-Step', desc: 'A simple guide to what to do, and when.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M5 5h11l3 3-3 3H5z"/><path d="M19 13H8l-3 3 3 3h11z"/></svg>' },
];

const PLUS = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>';
---

<StandardPageLayout context={context} bareHeader bareFooter>
<div class="mag-page">

  {/* ─── Hero ─────────────────────────────────────────────────────────── */}
  <section class="mag-hero">
    <div class="mag-hero__copy">
      <h1><span>Medicare Adventure:</span> <span class="mag-hero__accent">Learn Medicare by Playing</span></h1>
      <p class="mag-hero__tag">A friendly, interactive game to help you understand Medicare.</p>
      <SummaryBlock text={page.summary} />
      <AuthorByline authorId={context.author} updated={context.lastUpdated} />
      <div class="mag-callout">
        <span class="mag-callout__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/><path d="M22 9v6"/></svg></span>
        <p><strong>Have a question about your own situation?</strong> Call or text {BUSINESS.legalAgent} at <a href={`tel:${BUSINESS.phoneTel}`}>{BUSINESS.phone}</a> — no pressure, no obligation.</p>
      </div>
    </div>
    <svg class="mag-hero__art" viewBox="0 0 520 420" role="img" aria-labelledby="mag-art-t">
      <title id="mag-art-t">A mountain trail with a wooden signpost reading Learn, Play, Build Confidence, and Make Informed Choices, beside a Medicare Adventure map and compass</title>
      <defs>
        <linearGradient id="magSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b9e0fb" /><stop offset="1" stop-color="#eef8ff" /></linearGradient>
        <linearGradient id="magBoard" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b9783f" /><stop offset="1" stop-color="#94592b" /></linearGradient>
        <clipPath id="magClip"><rect width="520" height="420" rx="28" /></clipPath>
      </defs>
      <g clip-path="url(#magClip)">
        <rect width="520" height="420" fill="url(#magSky)" />
        <circle cx="430" cy="74" r="32" fill="#fde68a" />
        <g fill="#fff" opacity=".9"><ellipse cx="108" cy="70" rx="46" ry="13" /><ellipse cx="136" cy="60" rx="28" ry="13" /><ellipse cx="300" cy="46" rx="38" ry="10" /></g>
        <path d="M0 250 L92 138 L152 196 L232 104 L322 206 L392 146 L520 252 V420 H0Z" fill="#9cc3e4" />
        <path d="M232 104 L254 130 L243 128 L233 140 L222 128 L210 131Z M92 138 L108 157 L99 155 L92 163 L84 155 L76 157Z M392 146 L407 163 L398 161 L391 169 L384 161 L376 163Z" fill="#fff" />
        <path d="M0 302 Q130 244 262 292 T520 278 V420 H0Z" fill="#86c97a" />
        <path d="M0 346 Q160 304 300 338 T520 330 V420 H0Z" fill="#5aa95a" />
        <path d="M150 432 C172 384 268 372 256 342 C246 318 300 306 336 298" fill="none" stroke="#f1dbad" stroke-width="22" stroke-linecap="round" />
        <g fill="#2f7d4f">
          <path d="M34 336 l20 -58 l20 58z M18 352 l22 -48 l22 48z M484 330 l18 -54 l18 54z M462 352 l20 -44 l20 44z" />
        </g>
        <g fill="#7a4a26"><rect x="50" y="334" width="6" height="12" /><rect x="497" y="328" width="6" height="12" /></g>
        <g transform="translate(66 196) rotate(-7)">
          <rect width="232" height="150" rx="8" fill="#fbf1d6" stroke="#d9c08a" stroke-width="2" />
          <path d="M77 0 V150 M155 0 V150" stroke="#eadbb2" stroke-width="2" />
          <text x="116" y="40" text-anchor="middle" font-size="25" font-weight="800" fill="#0b2c45" font-family="Georgia, 'Times New Roman', serif">Medicare</text>
          <text x="116" y="68" text-anchor="middle" font-size="23" font-weight="700" fill="#0b2c45" font-family="Georgia, 'Times New Roman', serif">Adventure</text>
          <path d="M22 126 C50 100 70 132 96 112" fill="none" stroke="#c2410c" stroke-width="3" stroke-dasharray="5 6" stroke-linecap="round" />
          <path d="M196 92 l12 12 M208 92 l-12 12" stroke="#c2410c" stroke-width="3.5" stroke-linecap="round" />
          <circle cx="146" cy="112" r="24" fill="#fff" stroke="#a16207" stroke-width="3" />
          <path d="M146 92 L152 112 L146 132 L140 112Z" fill="#0b2c45" />
          <path d="M146 92 L152 112 L140 112Z" fill="#d0343d" />
          <circle cx="146" cy="112" r="3" fill="#a16207" />
        </g>
        <rect x="402" y="150" width="15" height="240" rx="3" fill="#7a4a26" />
        <g font-family="inherit" font-weight="800" fill="#fff8e6" text-anchor="middle">
          <path d="M346 158 H478 L494 176 L478 194 H346Z" fill="url(#magBoard)" stroke="#6b3f1f" stroke-width="2" />
          <text x="416" y="183" font-size="20">Learn</text>
          <path d="M346 202 H478 L494 220 L478 238 H346Z" fill="url(#magBoard)" stroke="#6b3f1f" stroke-width="2" />
          <text x="416" y="227" font-size="20">Play</text>
          <path d="M336 246 H486 L502 266 L486 286 H336Z" fill="url(#magBoard)" stroke="#6b3f1f" stroke-width="2" />
          <text x="415" y="272" font-size="17">Build Confidence</text>
          <path d="M336 292 H486 L502 318 L486 344 H336Z" fill="url(#magBoard)" stroke="#6b3f1f" stroke-width="2" />
          <text x="415" y="314" font-size="15">Make Informed</text>
          <text x="415" y="333" font-size="15">Choices</text>
        </g>
      </g>
    </svg>
  </section>

  {/* ─── Game ─────────────────────────────────────────────────────────── */}
  <div class="mag" id="mag">
    <div class="mag-hud" aria-label="Your progress">
      <span class="mag-hud-star" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.8l2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3L2.9 9.5l6.3-.9z" /></svg></span>
      <div class="mag-hud-score"><span class="mag-hud-label">Points</span><span class="mag-hud-num" id="mag-score">0</span></div>
      <div class="mag-hud-prog">
        <span class="mag-hud-label" id="mag-prog-label">0 of 5 stages complete</span>
        <div class="mag-bar"><div class="mag-bar-fill" id="mag-bar"></div></div>
      </div>
      <ul class="mag-hud-badges" id="mag-badges" aria-label="Badges earned"></ul>
    </div>
    <div class="mag-screen" id="mag-screen">
      <noscript><p class="mag-noscript">Medicare Adventure needs JavaScript turned on in your browser. You can still learn everything it covers from the guides listed below.</p></noscript>
    </div>
    <p class="mag-sr" id="mag-live" aria-live="polite"></p>
  </div>

  <ul class="mag-trio">
    <li>
      <span class="mag-trio__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M24 6a13 13 0 0 0-7.5 23.6c1.5 1.1 2.5 2.8 2.5 4.6V36h10v-1.8c0-1.8 1-3.5 2.5-4.6A13 13 0 0 0 24 6z" fill="#facc15" stroke="#a16207" stroke-width="2" /><rect x="19" y="37" width="10" height="5" rx="1.5" fill="#94a3b8" /><path d="M21 22l3 4 3-4" fill="none" stroke="#a16207" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
      <div><h3>Learn at your own pace</h3><p>Each stage starts with a short lesson, then a few friendly questions with clear explanations.</p></div>
    </li>
    <li>
      <span class="mag-trio__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18" fill="#fff" stroke="#d0343d" stroke-width="4" /><circle cx="24" cy="24" r="11" fill="#fecaca" stroke="#d0343d" stroke-width="4" /><circle cx="24" cy="24" r="4" fill="#d0343d" /><path d="M24 24L40 8M34 8h6v6" fill="none" stroke="#0b2c45" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
      <div><h3>Earn points and badges</h3><p>Get 10 points for every correct answer and collect a badge for each stage you finish.</p></div>
    </li>
    <li>
      <span class="mag-trio__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><rect x="8" y="26" width="8" height="14" rx="2" fill="#93c5fd" /><rect x="20" y="17" width="8" height="23" rx="2" fill="#3b82f6" /><rect x="32" y="8" width="8" height="32" rx="2" fill="#1d4ed8" /></svg></span>
      <div><h3>Build real confidence</h3><p>Turn Medicare’s new words and dates into simple, practical knowledge.</p></div>
    </li>
  </ul>

  {/* ─── How to play ──────────────────────────────────────────────────── */}
  <section class="mag-howto" aria-labelledby="mag-howto-h">
    <div>
      <h2 id="mag-howto-h" class="mag-sec-h">How to play</h2>
      <ol class="mag-steps">
        <li><span class="mag-steps__n" aria-hidden="true">1</span><p><strong>Pick a stage.</strong> Start with Stage 1 on the adventure map. Each stage begins with a short lesson.</p></li>
        <li><span class="mag-steps__n" aria-hidden="true">2</span><p><strong>Choose your answer.</strong> Tap one of the large buttons. You earn 10 points for every correct answer.</p></li>
        <li><span class="mag-steps__n" aria-hidden="true">3</span><p><strong>Learn why.</strong> After every answer you see the correct answer and a plain-English explanation.</p></li>
        <li><span class="mag-steps__n" aria-hidden="true">4</span><p><strong>Earn a badge.</strong> Finishing a stage earns a badge and unlocks the next one. There is no timer.</p></li>
        <li><span class="mag-steps__n" aria-hidden="true">5</span><p><strong>See your results.</strong> Finish all five stages for your final score, a review of every question, and guides to keep learning.</p></li>
      </ol>
    </div>
    <svg class="mag-howto__art" viewBox="0 0 360 270" aria-hidden="true">
      <ellipse cx="180" cy="236" rx="170" ry="26" fill="#bbe3b0" />
      <path d="M40 236 q10 -22 20 0 M300 232 q8 -18 16 0 M90 240 q6 -14 12 0" fill="#5aa95a" />
      <ellipse cx="96" cy="232" rx="26" ry="11" fill="#94a3b8" /><ellipse cx="270" cy="236" rx="18" ry="8" fill="#94a3b8" />
      <rect x="168" y="120" width="16" height="116" rx="3" fill="#7a4a26" />
      <g transform="rotate(-8 180 90)">
        <rect x="62" y="34" width="236" height="122" rx="14" fill="#b9783f" stroke="#6b3f1f" stroke-width="3" />
        <rect x="72" y="44" width="216" height="102" rx="9" fill="none" stroke="#d9a066" stroke-width="2" />
        <g font-family="inherit" font-weight="800" fill="#fff8e6" text-anchor="middle" font-size="22">
          <text x="180" y="78">Small steps</text>
          <text x="180" y="106">lead to big Medicare</text>
          <text x="180" y="134">confidence!</text>
        </g>
      </g>
      <g transform="translate(276 196)">
        <circle r="34" fill="#fff" stroke="#a16207" stroke-width="5" />
        <path d="M0 -24 L7 0 L0 24 L-7 0Z" fill="#0b2c45" /><path d="M0 -24 L7 0 L-7 0Z" fill="#d0343d" />
        <circle r="4" fill="#a16207" />
      </g>
    </svg>
  </section>

  {/* ─── What you'll learn ────────────────────────────────────────────── */}
  <section class="mag-learn" aria-labelledby="mag-learn-h">
    <h2 id="mag-learn-h" class="mag-sec-h">What you’ll learn at each stage</h2>
    <p class="mag-sec-sub">Open a stage to see what it covers and where to read more.</p>
    <ol class="mag-learn__grid">
      {LEARN.map((l, i) => (
        <li>
          <details class="mag-learn-card">
            <summary>
              <span class="mag-learn-card__n" aria-hidden="true">{i + 1}</span>
              <span class="mag-learn-card__head"><strong>Stage {i + 1}: {l.title}</strong><span>{l.teaser}</span></span>
              <span class="mag-plus" set:html={PLUS} />
            </summary>
            <div class="mag-learn-card__body">
              <p>{l.body}</p>
              <p class="mag-learn-card__more">Read more:</p>
              <ul>{l.links.map((k) => <li><a href={k.href}>{k.text}</a></li>)}</ul>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </section>

  {/* ─── Words + FAQ ──────────────────────────────────────────────────── */}
  <div class="mag-two">
    <section class="mag-words" aria-labelledby="mag-words-h">
      <h2 id="mag-words-h" class="mag-sec-h mag-sec-h--accent">Medicare words you’ll practice</h2>
      {TERMS.map((t) => (
        <details class="mag-term">
          <summary>
            <span class="mag-term__tick" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg></span>
            <dfn>{t.term}</dfn>
            <span class="mag-plus" set:html={PLUS} />
          </summary>
          <p>{t.def}</p>
        </details>
      ))}
      <p class="mag-words__note">Real amounts depend on your coverage and change over time. See the <a href="/medicare-glossary.html">Medicare glossary</a> for more terms.</p>
    </section>

    <section class="mag-faq" aria-label="Frequently Asked Questions">
      <h2 class="mag-sec-h mag-sec-h--accent">Frequently Asked Questions</h2>
      {page.faqs?.map((f) => (
        <details class="mag-faq__item">
