        if (next === -1) hint = '“You did it! Joe is all set. Open your journal to review every card you collected.”';
        else if (LOCS[next].req && !has(LOCS[next].req)) hint = '“To get into ' + LOCS[next].name + ', you’ll need the ' + ITEMS[LOCS[next].req].t + '. Finish the place before it first.”';
        else hint = '“Head to <strong>' + LOCS[next].name + '</strong> next. ' + SCENES[LOCS[next].id].mission + '”';
        setPanel('<div class="mj-dlg"><div class="mj-speaker"><svg viewBox="-24 -90 48 96" aria-hidden="true">' + person(0, 0, 1, MABEL) + '</svg><div><p class="mj-dlg-k">Mabel, on her bench</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>A friendly hint</h2></div></div><p>' + hint + '</p>' +
          '<div class="mj-actions">' + bt('Thanks, Mabel', renderMapPanel, 'mj-btn-ghost') + '</div></div>', null);
      }

      // Walk Linda along the road. `enter`: go inside on arrival when already there.
      function goTo(target, enter) {
        if (busy) return;
        var reach = maxReach();
        if (target === S.loc) {
          if (enter && locState(target) !== 'locked') enterScene(LOCS[target].id); else renderMapPanel();
          return;
        }
        var blocked = target > reach;
        var dest = blocked ? reach : target;
        var finish = function () {
          if (blocked) {
            setPanel('<div class="mj-dlg"><p class="mj-dlg-k">Cost Canyon</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>The bridge is out</h2><p>The bridge to Joe’s Porch is missing its planks. Finish Cost Canyon to build it.</p>' +
              '<div class="mj-actions">' + (locState(dest) !== 'locked' ? bt('Go inside Cost Canyon', function () { enterScene('canyon'); }, 'mj-btn-primary') : '') + bt('Back to the map', renderMapPanel, 'mj-btn-ghost') + '</div></div>', null);
            announce('The bridge is out. Finish Cost Canyon to build it.');
          } else {
            renderMapPanel();
            announce('Linda walked to ' + LOCS[S.loc].name + '.');
          }
        };
        if (dest === S.loc) { finish(); return; }
        walk(dest, finish);
      }

      function walk(dest, done) {
        var av = document.getElementById('mj-avatar'), inner = document.getElementById('mj-av-inner');
        if (!av || !inner) { S.loc = dest; save(); done(); return; }
        busy = true;
        root.classList.add('is-walking');
        var step = function () {
          if (S.loc === dest) {
            busy = false; root.classList.remove('is-walking'); save();
            // Refresh pins/chips so "here" markers move.
            keepMapFocus = !!(document.activeElement && document.activeElement.id === 'mj-map');
            renderMap();
            done();
            if (keepMapFocus) { var m = document.getElementById('mj-map'); if (m) m.focus({ preventScroll: true }); }
            keepMapFocus = false;
            return;
          }
          var dir = dest > S.loc ? 1 : -1;
          var seg = document.getElementById('mj-seg-' + (dir > 0 ? S.loc : S.loc - 1));
          inner.setAttribute('transform', dir < 0 ? 'scale(-1 1)' : '');
          if (!seg || RM || !seg.getTotalLength) { S.loc += dir; var n = NODES[S.loc]; av.setAttribute('transform', 'translate(' + n[0] + ' ' + n[1] + ')'); step(); return; }
          var L = seg.getTotalLength(), dur = 750, t0 = null;
          var frame = function (ts) {
            if (t0 === null) t0 = ts;
            var k = Math.min(1, (ts - t0) / dur);
            var ease = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
            var pt = seg.getPointAtLength(dir > 0 ? ease * L : (1 - ease) * L);
            av.setAttribute('transform', 'translate(' + pt.x.toFixed(1) + ' ' + pt.y.toFixed(1) + ')');
            if (k < 1) window.requestAnimationFrame(frame); else { S.loc += dir; step(); }
          };
          window.requestAnimationFrame(frame);
        };
        step();
      }

      root.addEventListener('keydown', function (e) {
        if (!e.target || e.target.id !== 'mj-map' || busy) return;
        interacted = true;
        var playKey = ['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Enter', ' '].indexOf(e.key) > -1;
        if (playKey) startPlaying();
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); if (S.loc < LOCS.length - 1) goTo(S.loc + 1, false); }
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); if (S.loc > 0) goTo(S.loc - 1, false); }
        else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); if (locState(S.loc) !== 'locked') enterScene(LOCS[S.loc].id); else renderMapPanel(); }
      });

      // ─────────────────────────────────────────────────────────────────────
      // Scenes
      // ─────────────────────────────────────────────────────────────────────
      function sceneDone(id) {
        return SCENES[id].spots.filter(function (s) { return s.required; }).every(function (s) { return isDone(id, s.id); });
      }

      function enterScene(id) {
        view = 'scene'; sceneId = id;
        renderScene();
        sceneIntro();
        announce('Inside ' + SCENES[id].title + '.');
      }

      function renderScene() {
        var sc = SCENES[sceneId];
        var spots = sc.spots.map(function (s) {
          var done = isDone(sceneId, s.id);
          return '<button type="button" class="mj-spot' + (done ? ' is-done' : '') + (s.required ? '' : ' is-extra') + '" style="left:' + (s.x / 10) + '%;top:' + (s.y / 5.6) + '%" data-a="' + act(function () { openSpot(s); }) + '" aria-label="' + s.label + (done ? ', done' : '') + '">' +
            '<span class="mj-spot-dot">' + (done ? ICON.check : ICON[s.kind === 'talk' || s.kind === 'story' || s.kind === 'decide' ? 'talk' : s.kind === 'puzzle' ? 'puzzle' : 'look']) + '</span><span class="mj-spot-label" aria-hidden="true">' + s.label + '</span></button>';
        }).join('');
        stageEl.innerHTML =
          '<div class="mj-scene"><svg class="mj-art" viewBox="0 0 1000 560" aria-hidden="true">' + sc.art() + '</svg>' + spots +
          '<button type="button" class="mj-back" data-a="' + act(leaveScene) + '"><span aria-hidden="true">◀</span> Map</button></div>';
      }

      function leaveScene() { renderMap(); }

      function exploreList() {
        var sc = SCENES[sceneId];
        return '<h3 class="mj-sub">Things to explore</h3><ul class="mj-todo">' + sc.spots.map(function (s) {
          var done = isDone(sceneId, s.id);
          return '<li><button type="button" class="mj-todo-btn' + (done ? ' is-done' : '') + '" data-a="' + act(function () { openSpot(s); }) + '">' +
            '<span class="mj-todo-ic" aria-hidden="true">' + (done ? ICON.check : '') + '</span>' + s.label + (s.required ? '' : ' <em>(bonus)</em>') + (done ? '<span class="mj-sr"> — done</span>' : '') + '</button></li>';
        }).join('') + '</ul>';
      }

      function sceneIntro() {
        var sc = SCENES[sceneId];
        var finished = !!S.badges[sceneId];
        setPanel('<div class="mj-dlg"><p class="mj-dlg-k">' + (finished ? 'Explored · ' + LOCS[LOC_INDEX[sceneId]].badge + ' badge' : 'Mission') + '</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>' + sc.title + '</h2>' +
          '<p class="mj-mission">' + sc.mission + '</p><p>' + sc.intro + '</p>' + exploreList() +
          '<div class="mj-actions">' + bt('<span aria-hidden="true">◀</span> Back to the map', leaveScene, 'mj-btn-ghost') + '</div></div>', sceneIntro);
      }

      function markDone(spot) {
        S.spots[spotKey(sceneId, spot.id)] = 1;
        save();
        renderScene();
      }

      function nextButtons() {
        if (sceneDone(sceneId) && !S.badges[sceneId]) return bt('Finish this place', completeScene, 'mj-btn-primary');
        return bt('Keep exploring', sceneIntro, 'mj-btn-primary');
      }

      function speakerHead(spot) {
        var who = { 'Clerk': CLERK, 'Advisor': OFFICER, 'Clock keeper': KEEPER, 'Ranger Rosa': RANGER, 'Joe': JOE }[spot.speaker];
        return who ? '<svg viewBox="-24 -90 48 96" aria-hidden="true">' + person(0, 0, 1, who) + '</svg>' : '';
      }

      function openSpot(spot) {
        if (spot.kind === 'puzzle') return ({ sort: puzzleSort, months: puzzleMonths, bells: puzzleBells, bridge: puzzleBridge })[spot.puzzle](spot);
        if (spot.kind === 'decide') return decide(spot);
        if (spot.kind === 'story') return story(spot);
        var done = isDone(sceneId, spot.id);
        var head = '<div class="mj-dlg">' + (spot.speaker ? '<div class="mj-speaker">' + speakerHead(spot) + '<div><p class="mj-dlg-k">' + spot.speaker + '</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>' + spot.label + '</h2></div></div>' :
          '<p class="mj-dlg-k">' + SCENES[sceneId].title + '</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>' + spot.label + '</h2>');
        if (spot.kind === 'use' && !done) {
          var ok = has(spot.needs);
          setPanel(head + '<p>' + spot.text + '</p>' + (ok
            ? '<div class="mj-actions">' + bt('Use: ' + ITEMS[spot.needs].t, function () {
              markDone(spot);
              var rw = grant(spot.give);
              setPanel(head + '<p>' + spot.used + '</p>' + rw + '<div class="mj-actions">' + nextButtons() + '</div></div>', null);
            }, 'mj-btn-primary') + bt('Not now', sceneIntro, 'mj-btn-ghost') + '</div>'
            : '<p class="mj-status is-locked">' + ICON.lock + 'You need the ' + ITEMS[spot.needs].t + '.</p><div class="mj-actions">' + bt('Back', sceneIntro, 'mj-btn-ghost') + '</div>') + '</div>', null);
          return;
        }
        if (spot.quiz && !done) {
          return quiz(head + '<p>' + spot.text + '</p>', spot.quiz, function (first) {
            markDone(spot);
            return grant(spot.give, first) + (spot.give && spot.give.card ? cardHtml(spot.give.card) : '');
          });
        }
        var rewards = '';
        if (!done) { markDone(spot); rewards = grant(spot.give); }
        setPanel(head + '<p>' + (spot.used && done && spot.kind === 'use' ? spot.used : spot.text) + '</p>' + rewards +
          (spot.give && spot.give.card && done ? cardHtml(spot.give.card) : '') +
          '<div class="mj-actions">' + nextButtons() + '</div></div>', null);
      }

      // Multiple-choice: wrong answers explain and let you try again; coins only on the first try.
      function quiz(headHtml, q, onRight) {
        var tries = 0;
        var render = function (msg) {
          setPanel(headHtml + '<p class="mj-q">' + q.q + '</p>' + (msg || '') +
            '<div class="mj-opts">' + q.opts.map(function (o, oi) {
              return '<button type="button" class="mj-opt" data-a="' + act(function () { pick(oi); }) + '"><span class="mj-opt-k" aria-hidden="true">' + String.fromCharCode(65 + oi) + '</span><span>' + o + '</span></button>';
            }).join('') + '</div></div>', null);
        };
        var pick = function (oi) {
          tries++;
          if (oi === q.a) {
            var extra = onRight(tries === 1);
            setPanel(headHtml + '<p class="mj-q">' + q.q + '</p><div class="mj-fb is-right"><p class="mj-fb-h">' + ICON.check + 'Correct!</p>' + (q.why ? '<p>' + q.why + '</p>' : '') + '</div>' + extra +
              '<div class="mj-actions">' + nextButtons() + '</div></div>', null);
            announce('Correct!');
          } else {
            render('<div class="mj-fb is-wrong"><p class="mj-fb-h">' + ICON.cross + 'Not quite — try again.</p><p>“' + q.opts[oi] + '” isn’t right. Think about it and pick another answer.</p></div>');
            announce('Not quite. Try again.');
            var f = panelEl.querySelector('.mj-fb'); if (f) f.setAttribute('tabindex', '-1');
          }
        };
        render('');
      }

      function cardHtml(id) {
        var c = CARDS[id];
        return '<div class="mj-card mj-card--new"><p class="mj-card-k">' + ICON.card + 'Knowledge card</p><h3>' + c.t + '</h3><p>' + c.x + '</p><a href="' + c.href + '">' + c.ht + ' <span aria-hidden="true">›</span></a></div>';
      }

      // ── Puzzle: sort services into Parts ──
      function puzzleSort(spot) {
        var sel = null, msg = '';
        var render = function () {
          var left = SORT.filter(function (t) { return !S.sorted[t.id]; });
          var head = '<div class="mj-dlg"><p class="mj-dlg-k">Puzzle</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>Sorting crate</h2>';
          if (!left.length) {
            if (!isDone(sceneId, spot.id)) {
              markDone(spot);
              grant({ card: 'partA' }); grant({ card: 'partB' }); grant({ card: 'partD' }); grant({ card: 'notcovered', coins: 10 });
            }
            setPanel(head + '<div class="mj-fb is-right"><p class="mj-fb-h">' + ICON.check + 'Everything’s in the right stall!</p><p>You collected four knowledge cards: Parts A, B, and D, and what Original Medicare doesn’t cover.</p></div>' +
              '<div class="mj-actions">' + nextButtons() + '</div></div>', null);
            return;
          }
          setPanel(head + '<p>' + (sel ? 'Now choose the stall for <strong>' + sel.t + '</strong>.' : 'Choose an item from the crate, then choose the stall where it belongs.') + '</p>' + msg +
            '<h3 class="mj-sub">In the crate (' + left.length + ' left)</h3><div class="mj-tokens">' + left.map(function (t) {
              return '<button type="button" class="mj-token' + (sel && sel.id === t.id ? ' is-sel' : '') + '" aria-pressed="' + (sel && sel.id === t.id) + '" data-a="' + act(function () { sel = t; msg = ''; render(); }) + '">' + t.t + '</button>';
            }).join('') + '</div>' +
            '<h3 class="mj-sub">Stalls</h3><div class="mj-stalls">' + Object.keys(STALLS).map(function (k) {
              var inStall = SORT.filter(function (t) { return S.sorted[t.id] === k; });
              return '<button type="button" class="mj-stall mj-stall--' + k + '"' + (sel ? '' : ' aria-disabled="true"') + ' data-a="' + act(function () { place(k); }) + '"><strong>' + STALLS[k] + '</strong>' +
                (inStall.length ? '<span>' + inStall.map(function (t) { return t.t; }).join(' · ') + '</span>' : '<span class="mj-muted">Empty</span>') + '</button>';
            }).join('') + '</div>' +
            '<div class="mj-actions">' + bt('Back', sceneIntro, 'mj-btn-ghost') + '</div></div>', null);
        };
        var miss = {};
        var place = function (k) {
          if (!sel) { msg = '<p class="mj-status">Choose an item from the crate first.</p>'; render(); return; }
          if (sel.p === k) {
            S.sorted[sel.id] = k;
            if (!miss[sel.id]) { S.coins += 5; }
            save(); renderHud();
            msg = '<div class="mj-fb is-right"><p class="mj-fb-h">' + ICON.check + sel.t + ' → ' + STALLS[k] + '</p><p>' + STALL_WHY[k] + '</p></div>';
            announce('Correct. ' + sel.t + ' goes to ' + STALLS[k] + '.');
            sel = null;
          } else {
            miss[sel.id] = 1;
            msg = '<div class="mj-fb is-wrong"><p class="mj-fb-h">' + ICON.cross + 'Not this stall.</p><p>' + STALL_WHY[k] + ' Try another stall for “' + sel.t + '.”</p></div>';
            announce('Not this stall. Try another.');
          }
          render();
        };
        render();
      }

      // ── Puzzle: light up the Initial Enrollment Period on the clock ──
      var IEP = [3, 4, 5, 6, 7, 8, 9]; // April–October for a July birthday
      function puzzleMonths(spot) {
        if (!S.months || S.months.length !== 12) S.months = MONTHS.map(function () { return false; });
        var checks = 0, msg = '';
        var paint = function () {
          MONTHS.forEach(function (_, i) { var g = document.getElementById('mj-cm-' + i); if (g) g.classList.toggle('is-on', !!S.months[i]); });
        };
        var render = function () {
          var done = isDone(sceneId, spot.id);
          setPanel('<div class="mj-dlg"><p class="mj-dlg-k">Puzzle</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>Set the clock</h2>' +
            '<p>Linda’s 65th birthday is <strong>July 20</strong>. Light up every month of her <strong>Initial Enrollment Period</strong> — the window when she can first sign up — then press Check.</p>' + msg +
            '<div class="mj-months" role="group" aria-label="Months">' + MONTHS.map(function (m, i) {
              return '<button type="button" class="mj-month' + (S.months[i] ? ' is-on' : '') + (i === 6 ? ' is-bday' : '') + '" aria-pressed="' + !!S.months[i] + '"' + (done ? ' disabled' : '') + ' data-a="' + act(function () { S.months[i] = !S.months[i]; save(); paint(); msg = ''; render(); }) + '">' + m + (i === 6 ? '<span class="mj-sr"> (birthday month)</span>' : '') + '</button>';
            }).join('') + '</div>' +
            '<div class="mj-actions">' + (done ? nextButtons() : bt('Check', check, 'mj-btn-primary') + bt('Clear', function () { S.months = MONTHS.map(function () { return false; }); save(); paint(); msg = ''; render(); }, 'mj-btn-ghost') + bt('Back', sceneIntro, 'mj-btn-ghost')) + '</div></div>', null);
        };
        var check = function () {
          checks++;
          var on = []; S.months.forEach(function (v, i) { if (v) on.push(i); });
          if (on.join() === IEP.join()) {
            markDone(spot); paint();
            var rw = grant({ card: 'iep', coins: checks === 1 ? 15 : 0 });
            msg = '<div class="mj-fb is-right"><p class="mj-fb-h">' + ICON.check + 'The clock chimes! April through October.</p><p>' + CARDS.iep.x + '</p></div>' + rw;
            announce('Correct. April through October.');
          } else {
            var hint = on.length !== 7 ? 'The Initial Enrollment Period is 7 months long — you have ' + on.length + ' lit.' :
              S.months[6] ? 'Seven months, including July — now check where it starts: 3 months before the birthday month.' : 'It always includes the birthday month.';
            msg = '<div class="mj-fb is-wrong"><p class="mj-fb-h">' + ICON.cross + 'Not quite.</p><p>' + hint + '</p></div>';
            announce('Not quite. ' + hint);
          }
          render();
        };
        render();
      }

      // ── Puzzle: ring the right enrollment bell for each person ──
      function puzzleBells(spot) {
        if (!S.bells || S.bells.length !== 3) S.bells = [false, false, false];
        var idx = S.bells.indexOf(false), msg = '', tries = 0;
        var render = function () {
          if (idx === -1) {
            if (!isDone(sceneId, spot.id)) { markDone(spot); }
            var rw = grant({ card: 'windows' });
            setPanel('<div class="mj-dlg"><p class="mj-dlg-k">Puzzle</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>All three bells rang!</h2>' + msg + rw + cardHtml('windows') + '<div class="mj-actions">' + nextButtons() + '</div></div>', null);
            return;
          }
          var b = BELLS[idx];
          setPanel('<div class="mj-dlg"><p class="mj-dlg-k">Bell ' + (idx + 1) + ' of 3</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>Ring the right bell</h2>' + msg +
            '<p class="mj-q">' + b.q + '</p><div class="mj-opts">' + BELL_OPTS.map(function (o, oi) {
              return '<button type="button" class="mj-opt" data-a="' + act(function () { ring(oi); }) + '"><span class="mj-opt-k" aria-hidden="true">' + String.fromCharCode(65 + oi) + '</span><span>' + o + '</span></button>';
            }).join('') + '</div><div class="mj-actions">' + bt('Back', sceneIntro, 'mj-btn-ghost') + '</div></div>', null);
        };
        var ring = function (oi) {
          tries++;
          var b = BELLS[idx];
          if (oi === b.a) {
            S.bells[idx] = true;
            if (tries === 1) S.coins += 10;
            save(); renderHud();
            var g = document.getElementById('mj-bell-' + idx); if (g) g.classList.add('is-rung');
            msg = '<div class="mj-fb is-right"><p class="mj-fb-h">' + ICON.check + 'Ding! ' + BELL_OPTS[b.a] + '</p><p>' + b.why + '</p></div>';
            announce('Correct. ' + BELL_OPTS[b.a] + '.');
            idx = S.bells.indexOf(false); tries = 0;
          } else {
            msg = '<div class="mj-fb is-wrong"><p class="mj-fb-h">' + ICON.cross + 'That bell doesn’t fit.</p><p>Re-read the situation and try another bell.</p></div>';
            announce('That bell does not fit. Try another.');
          }
          render();
        };
        render();
      }

      // ── Puzzle: build the bridge, one cost-word plank at a time ──
      function puzzleBridge(spot) {
        if (!S.planks || S.planks.length !== 4) S.planks = [false, false, false, false];
        var msg = '', tries = 0;
        var render = function () {
          var gap = S.planks.indexOf(false);
          var head = '<div class="mj-dlg"><p class="mj-dlg-k">Puzzle</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>Build the bridge</h2>';
          if (gap === -1) {
            if (!isDone(sceneId, spot.id)) markDone(spot);
            var rw = grant({ card: 'costs' });
            setPanel(head + msg + '<div class="mj-fb is-right"><p class="mj-fb-h">' + ICON.check + 'The bridge is complete!</p><p>All four planks are in place.</p></div>' + rw + cardHtml('costs') + '<div class="mj-actions">' + nextButtons() + '</div></div>', null);
            return;
          }
          var options = PLANKS.map(function (_, i) { return i; }).filter(function (i) { return !S.planks[i]; });
          setPanel(head + msg + '<p>Gap ' + (gap + 1) + ' of 4. The sign over this gap says:</p><blockquote class="mj-sign">' + PLANKS[gap].def + '</blockquote><p class="mj-q">Which plank fits?</p>' +
            '<div class="mj-planks">' + options.map(function (i) {
              return '<button type="button" class="mj-plank-btn" data-a="' + act(function () { lay(i, gap); }) + '">' + PLANKS[i].term + '</button>';
            }).join('') + '</div><div class="mj-actions">' + bt('Back', sceneIntro, 'mj-btn-ghost') + '</div></div>', null);
        };
        var lay = function (i, gap) {
          tries++;
          if (i === gap) {
            S.planks[gap] = true;
            if (tries === 1) S.coins += 5;
            save(); renderHud();
            var el = document.getElementById('mj-plank-' + gap); if (el) el.classList.add('is-set');
            msg = '<div class="mj-fb is-right"><p class="mj-fb-h">' + ICON.check + 'Thunk! “' + PLANKS[i].term + '” fits.</p></div>';
            announce(PLANKS[i].term + ' fits.');
            tries = 0;
          } else {
            msg = '<div class="mj-fb is-wrong"><p class="mj-fb-h">' + ICON.cross + 'The “' + PLANKS[i].term + '” plank wobbles and falls.</p><p>' + PLANKS[i].term + ' means: ' + PLANKS[i].def + ' Try another plank.</p></div>';
            announce(PLANKS[i].term + ' does not fit. Try another plank.');
          }
          render();
        };
        render();
      }

      // ── Decisions with consequences (Ranger Rosa, Lookout) ──
      function decide(spot) {
        var d = DECISIONS[spot.decision], first = true;
        var head = '<div class="mj-dlg"><div class="mj-speaker">' + speakerHead(spot) + '<div><p class="mj-dlg-k">' + spot.speaker + '</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>' + spot.label + '</h2></div></div>';
        var ask = function () {
          setPanel(head + '<p>' + d.setup + '</p><div class="mj-opts">' + d.opts.map(function (o, oi) {
            return '<button type="button" class="mj-opt" data-a="' + act(function () { choose(oi); }) + '"><span class="mj-opt-k" aria-hidden="true">' + String.fromCharCode(65 + oi) + '</span><span>' + o.label + '</span></button>';
          }).join('') + '</div><div class="mj-actions">' + bt('Back', sceneIntro, 'mj-btn-ghost') + '</div></div>', null);
        };
        var choose = function (oi) {
          var o = d.opts[oi];
          if (o.good) {
            var already = isDone(sceneId, spot.id);
            if (!already) markDone(spot);
            var rw = already ? '' : grant({ card: d.card, coins: 10 }, first);
            setPanel(head + '<div class="mj-fb is-right"><p class="mj-fb-h">' + ICON.check + 'Good call.</p><p>' + o.out + '</p></div>' + rw + cardHtml(d.card) + '<div class="mj-actions">' + nextButtons() + '</div></div>', null);
            announce('Good call.');
          } else {
            first = false;
            setPanel(head + '<div class="mj-fb is-wrong"><p class="mj-fb-h">' + ICON.cross + 'Here’s what could happen</p><p>' + o.out + '</p></div><div class="mj-actions">' + bt('Rewind and choose again', ask, 'mj-btn-primary') + '</div></div>', null);
            announce('Here is what could happen. ' + o.out);
          }
        };
        ask();
      }

      // ── Final mission: help Joe ──
      function story(spot) {
        var head = '<div class="mj-dlg"><div class="mj-speaker">' + speakerHead(spot) + '<div><p class="mj-dlg-k">Joe · decision ' + Math.min(S.story + 1, STORY.length) + ' of ' + STORY.length + '</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>Help Joe plan</h2></div></div>';
        var stepFirst = true;
        if (S.story >= STORY.length) { renderEndingPanel(); return; }
        var st = STORY[S.story];
        var ask = function () {
          setPanel(head + '<div class="mj-meter" aria-label="Joe’s plan">' + STORY.map(function (_, i) { return '<span class="' + (i < S.story ? 'is-done' : i === S.story ? 'is-now' : '') + '"></span>'; }).join('') + '</div>' +
            '<p>' + st.setup + '</p><div class="mj-opts">' + st.opts.map(function (o, oi) {
              return '<button type="button" class="mj-opt" data-a="' + act(function () { choose(oi); }) + '"><span class="mj-opt-k" aria-hidden="true">' + String.fromCharCode(65 + oi) + '</span><span>' + o.label + '</span></button>';
            }).join('') + '</div><div class="mj-actions">' + bt('Back', sceneIntro, 'mj-btn-ghost') + '</div></div>', null);
        };
        var choose = function (oi) {
          var o = st.opts[oi];
          if (o.good) {
            if (stepFirst) S.coins += 10;
            S.story++;
            save(); renderHud();
            var last = S.story >= STORY.length;
            setPanel(head + '<div class="mj-fb is-right"><p class="mj-fb-h">' + ICON.check + 'Joe nods. “That makes sense.”</p><p>' + o.out + '</p></div>' +
              '<div class="mj-actions">' + (last ? bt('Wrap up the mission', finishStory, 'mj-btn-primary') : bt('Next question from Joe', function () { story(spot); }, 'mj-btn-primary')) + '</div></div>', null);
            announce('Good choice.');
          } else {
            stepFirst = false; S.storyMiss++; save();
            setPanel(head + '<div class="mj-fb is-wrong"><p class="mj-fb-h">' + ICON.cross + 'Uh-oh — here’s what could happen</p><p>' + o.out + '</p></div><div class="mj-actions">' + bt('Rewind and choose again', ask, 'mj-btn-primary') + '</div></div>', null);
            announce('Here is what could happen. ' + o.out);
          }
        };
        var finishStory = function () {
          markDone(spot);
          grant({ card: 'sep', coins: 20 });
          completeScene();
        };
        ask();
      }

      function confetti() {
        var colors = ['#2563eb', '#d0343d', '#f59e0b', '#16a34a', '#38bdf8', '#a855f7'], s = '';
        for (var k = 0; k < 22; k++) s += '<i style="--x:' + (k * 37 % 100) + '%;--d:' + (k % 7) * 0.08 + 's;--c:' + colors[k % colors.length] + ';--r:' + (k * 47 % 360) + 'deg"></i>';
        return '<div class="mj-confetti" aria-hidden="true">' + s + '</div>';
      }

      function completeScene() {
        var i = LOC_INDEX[sceneId], l = LOCS[i];
        if (S.badges[sceneId]) return; // already finished — never re-award or re-report
        S.badges[sceneId] = 1;
        track('game_stage_completed', { stage_id: sceneId, stage_name: stageName(sceneId), stage_number: i + 1 }, 'stage:' + sceneId);
        S.coins += 20;
        if (sceneId === 'town') track('game_completed', { cards_collected: S.cards.length, coins: S.coins }, 'completed');
        var rewardItem = { home: null, ssa: null, market: 'partsmap', clock: 'key', canyon: 'pass', town: null }[sceneId];
        if (rewardItem && !has(rewardItem)) S.items.push(rewardItem);
        if (sceneId === 'town') S.done = true;
        save(); renderHud(); renderScene();
        if (sceneId === 'town') { renderEnding(); return; }
        var next = LOCS[i + 1];
        setPanel('<div class="mj-dlg mj-dlg--win">' + confetti() + '<div class="mj-medal">' + ICON.star + '</div><p class="mj-dlg-k">Place complete</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>Badge earned: ' + l.badge + '!</h2>' +
          '<p>+20 coins' + (rewardItem ? ' and a new item: <strong>' + ITEMS[rewardItem].t + '</strong> — ' + ITEMS[rewardItem].d : '') + '</p>' +
          (next ? '<p class="mj-status">' + ICON.door + 'Next stop: <strong>' + next.name + '</strong>.</p>' : '') +
          '<div class="mj-actions">' + bt('Back to the map', leaveScene, 'mj-btn-primary') + bt('Stay and look around', sceneIntro, 'mj-btn-ghost') + '</div></div>', null);
        announce('Badge earned: ' + l.badge + '.');
      }

      // ── Ending ──
      function renderEnding() {
        if (view !== 'scene' || sceneId !== 'town') { view = 'scene'; sceneId = 'town'; renderScene(); }
        renderEndingPanel();
      }
      function renderEndingPanel() {
        var perfect = S.storyMiss === 0;
        setPanel('<div class="mj-dlg mj-dlg--win">' + confetti() + '<div class="mj-medal mj-medal--gold">' + ICON.star + '</div><p class="mj-dlg-k">Mission complete</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>Joe is on track — and so is Linda!</h2>' +
          '<p>' + (perfect ? 'You guided Joe without a single wrong turn.' : 'You helped Joe find the right path — rewinding when a choice could have cost him.') + '</p>' +
          '<ul class="mj-final-stats"><li><strong>' + S.coins + '</strong><span>coins</span></li><li><strong>' + S.cards.length + ' / ' + CARD_ORDER.length + '</strong><span>knowledge cards</span></li><li><strong>' + Object.keys(S.badges).length + ' / ' + LOCS.length + '</strong><span>badges</span></li></ul>' +
          '<p>Your journal holds everything you learned, with links to read more.</p>' +
          '<div class="mj-actions">' + bt('Open my journal', openJournal, 'mj-btn-primary') + bt('Back to the map', leaveScene, 'mj-btn-ghost') + bt('Start a new journey', restart, 'mj-btn-link') + '</div>' +
          '<p class="mj-note">Linda, Joe, and Ray are fictional. For your own situation, check Medicare.gov or talk with a licensed agent.</p></div>', renderEndingPanel);
        announce('Mission complete.');
      }

      // ── Journal ──
      function openJournal() {
        var back = panelRender || renderMapPanel;
        track('game_journal_opened', { cards_collected: S.cards.length });
        setPanel('<div class="mj-dlg"><p class="mj-dlg-k">Journal</p><h2 class="mj-dlg-h" tabindex="-1" data-focus>Knowledge cards: ' + S.cards.length + ' of ' + CARD_ORDER.length + '</h2>' +
          '<ul class="mj-journal">' + CARD_ORDER.map(function (id) {
            var got = S.cards.indexOf(id) > -1, c = CARDS[id];
            return got ? '<li class="mj-card"><p class="mj-card-k">' + ICON.card + 'Knowledge card</p><h3>' + c.t + '</h3><p>' + c.x + '</p><a href="' + c.href + '">' + c.ht + ' <span aria-hidden="true">›</span></a></li>'
              : '<li class="mj-card is-locked"><p class="mj-card-k">' + ICON.lock + 'Not found yet</p><h3>???</h3><p>Keep exploring to find this card.</p></li>';
          }).join('') + '</ul><div class="mj-actions">' + bt('Close the journal', function () { back(); }, 'mj-btn-primary') + '</div></div>', null);
      }

      function restart() {
        if (!window.confirm('Start a new journey? This erases your coins, cards, badges, and items.')) return;
        S = fresh(); save(); renderHud(); renderMap();
        announce('New journey started.');
      }

      renderHud();
      renderMap();
    })();
  </script>
</div>
</StandardPageLayout>

<style is:global>
  .mj-page {
    --mj-ink: #0b2c45; --mj-soft: #334155; --mj-line: #d3e0ee;
    --mj-blue: #1d4ed8; --mj-blue-soft: #e5edfe; --mj-coral: #d0343d; --mj-coral-dark: #a8262f;
    --mj-green: #166534; --mj-green-soft: #dcfce7; --mj-red: #991b1b; --mj-amber: #92400e; --mj-amber-soft: #fef3c7;
    --mj-shadow: 0 14px 34px -22px rgba(11, 44, 69, 0.55);
    color: var(--mj-ink);
  }
  .mj-page *, .mj-page *::before, .mj-page *::after { box-sizing: border-box; }
  .mj-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .mj-page a { color: var(--mj-blue); }
  .mj-page a:focus-visible, .mj-page button:focus-visible, .mj-page summary:focus-visible, .mj-page [tabindex]:focus-visible { outline: 4px solid #f59e0b; outline-offset: 3px; }
  .mj-page h2 { color: var(--mj-ink); }

  /* Buttons */
  .mj-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; font: inherit; font-weight: 800; font-size: 1.1rem; min-height: 56px; padding: 0.7rem 1.4rem; border-radius: 999px; cursor: pointer; border: 2px solid transparent; text-decoration: none; transition: transform 0.15s ease, background 0.15s ease; }
  .mj-btn-primary { background: var(--mj-coral); color: #fff !important; box-shadow: 0 5px 0 var(--mj-coral-dark); }
  .mj-btn-primary:hover { background: #bb2d36; transform: translateY(-1px); }
  .mj-btn-primary:active { transform: translateY(3px); box-shadow: 0 2px 0 var(--mj-coral-dark); }
  .mj-btn-ghost { background: #fff; color: var(--mj-blue); border-color: var(--mj-line); }
  .mj-btn-ghost:hover { border-color: var(--mj-blue); background: var(--mj-blue-soft); }
  .mj-btn-link { background: none; color: var(--mj-blue); text-decoration: underline; min-height: 48px; padding: 0.5rem 0.75rem; }
  .mj-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }

  /* Hero */
  .mj-hero { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; align-items: center; background: linear-gradient(180deg, #eef7ff, #fff); border: 1px solid var(--mj-line); border-radius: 26px; padding: 2rem 2.25rem; margin: 0.5rem 0 1.5rem; }
  .mj-hero h1 { font-size: clamp(2rem, 4.2vw, 2.9rem); line-height: 1.08; font-weight: 800; margin: 0 0 0.6rem; color: var(--mj-ink); }
  .mj-hero h1 span { display: block; }
  .mj-hero .mj-hero__accent { color: var(--mj-coral); }
  .mj-hero__tag { font-size: 1.2rem; font-weight: 700; margin: 0 0 0.75rem; }
  .mj-hero .summary-block { background: none; border: 0; padding: 0; margin: 0 0 0.6rem; box-shadow: none; }
  .mj-hero .summary-block p { margin: 0; font-size: 1.05rem; line-height: 1.6; color: var(--mj-soft); }
  .mj-hero .byline { margin: 0 0 1rem; font-size: 0.92rem; color: #5b6b7d; }
  .mj-hero__start { margin: 0; }
  .mj-hero__facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .mj-hero__facts li { background: #fff; border: 1px solid var(--mj-line); border-radius: 18px; padding: 1rem; text-align: center; box-shadow: var(--mj-shadow); }
  .mj-hero__facts strong { display: block; font-size: 2.2rem; line-height: 1; color: var(--mj-blue); }
  .mj-hero__facts span { color: var(--mj-soft); font-weight: 700; }

  /* Game shell */
  .mj { position: relative; font-size: 1.12rem; line-height: 1.55; background: #fff; border: 2px solid var(--mj-line); border-radius: 26px; box-shadow: 0 18px 50px -26px rgba(11, 44, 69, 0.4); padding: 1rem; margin: 0 0 2rem; scroll-margin-top: 140px; }
  .mj-noscript { font-weight: 700; padding: 1rem; }
  .mj svg { flex: none; }

  /* HUD */
  .mj-hud { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.25rem; padding: 0.7rem 0.9rem; background: #f6faff; border: 1px solid var(--mj-line); border-radius: 18px; margin-bottom: 0.9rem; }
  .mj-hud-k { display: block; font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: #5b6b7d; }
  .mj-hud-coins { display: flex; align-items: center; gap: 0.5rem; }
  .mj-hud-coins svg { width: 40px; height: 40px; }
  .mj-hud-coins strong { font-size: 1.6rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .mj-hud-cards { display: flex; align-items: center; gap: 0.5rem; font: inherit; color: var(--mj-ink); background: #fff; border: 2px solid var(--mj-line); border-radius: 14px; padding: 0.35rem 0.8rem; min-height: 52px; cursor: pointer; text-align: left; }
  .mj-hud-cards:hover { border-color: var(--mj-blue); }
  .mj-hud-cards svg { width: 28px; height: 28px; color: var(--mj-blue); }
  .mj-hud-badges ul, .mj-hud-items ul { list-style: none; margin: 0.15rem 0 0; padding: 0; display: flex; gap: 5px; flex-wrap: wrap; }
  .mj-hud-badges li { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; font-size: 0.85rem; font-weight: 800; color: #94a3b8; background: #fff; border: 2px dashed #cbd5e1; }
  .mj-hud-badges li.is-got { background: #fef3c7; color: #b45309; border: 2px solid #d97706; }
  .mj-hud-badges li svg { width: 18px; height: 18px; }
  .mj-hud-items li { width: 34px; height: 34px; border-radius: 9px; display: grid; place-items: center; background: #fff; border: 1px solid var(--mj-line); }
  .mj-hud-items li svg { width: 24px; height: 24px; }
  .mj-hud-items li.mj-hud-empty { width: auto; padding: 0 0.6rem; font-size: 0.9rem; color: #64748b; border-style: dashed; }
  .mj-toast { position: absolute; right: 12px; top: -14px; z-index: 5; max-width: 80%; background: var(--mj-ink); color: #fff; font-weight: 800; font-size: 0.95rem; padding: 0.45rem 0.9rem; border-radius: 999px; opacity: 0; transform: translateY(6px); pointer-events: none; transition: opacity 0.2s ease, transform 0.2s ease; }
  .mj-toast.is-on { opacity: 1; transform: none; }

  /* Map + scenes share a 1000×560 stage */
  .mj-map, .mj-scene { position: relative; width: 100%; aspect-ratio: 1000 / 560; border-radius: 18px; overflow: hidden; background: #e8f4fd; border: 1px solid var(--mj-line); }
  .mj-art { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .mj-map:focus-visible { outline: 4px solid #f59e0b; outline-offset: 3px; }
  .mj-av-bob { transform-box: fill-box; }
  .mj.is-walking .mj-av-bob { animation: mj-bob 0.32s ease-in-out infinite alternate; }

  .mj-pin, .mj-spot { position: absolute; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 4px; background: none; border: 0; padding: 0; cursor: pointer; font: inherit; z-index: 2; }
  .mj-pin-dot, .mj-spot-dot { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: 1.25rem; color: #fff; background: var(--mj-blue); border: 4px solid #fff; box-shadow: 0 6px 14px -6px rgba(11, 44, 69, 0.7); transition: transform 0.15s ease; }
  .mj-pin-dot svg, .mj-spot-dot svg { width: 24px; height: 24px; }
  .mj-pin:hover .mj-pin-dot, .mj-spot:hover .mj-spot-dot { transform: scale(1.08); }
  .mj-pin:active .mj-pin-dot, .mj-spot:active .mj-spot-dot { transform: scale(0.96); }
  .mj-pin-label, .mj-spot-label { background: rgba(11, 44, 69, 0.88); color: #fff; font-size: 0.85rem; font-weight: 800; padding: 0.15rem 0.6rem; border-radius: 999px; white-space: nowrap; }
  .mj-pin.is-done .mj-pin-dot { background: var(--mj-green); }
  .mj-pin.is-locked .mj-pin-dot { background: #64748b; }
  .mj-pin.is-here .mj-pin-dot { box-shadow: 0 0 0 5px rgba(208, 52, 61, 0.35), 0 6px 14px -6px rgba(11, 44, 69, 0.7); }
  .mj-pin.is-open:not(.is-here) .mj-pin-dot { animation: mj-glow 2.2s ease-in-out infinite; }
  .mj-pin--extra .mj-pin-dot { width: 44px; height: 44px; background: #b45309; }
  .mj-spot-dot { background: #f59e0b; animation: mj-glow 2.2s ease-in-out infinite; }
  .mj-spot.is-extra .mj-spot-dot { background: #7c3aed; }
  .mj-spot.is-done .mj-spot-dot { background: var(--mj-green); animation: none; }
  .mj-back { position: absolute; left: 10px; top: 10px; z-index: 3; font: inherit; font-weight: 800; font-size: 1rem; min-height: 46px; padding: 0.4rem 1rem; border-radius: 999px; background: #fff; color: var(--mj-blue); border: 2px solid var(--mj-line); cursor: pointer; }
  .mj-back:hover { border-color: var(--mj-blue); }

  .mj-cm circle { fill: #fff; stroke: #d6b56f; stroke-width: 3; transition: fill 0.2s ease; }
  .mj-cm text { fill: #92400e; }
  .mj-cm.is-on circle { fill: #f59e0b; stroke: #92400e; }
  .mj-cm.is-on text { fill: #fff; }
  .mj-bell { transform-box: fill-box; transform-origin: 50% 0; }
  .mj-bell.is-rung path:nth-child(2) { fill: #16a34a; }
  .mj-bell.is-rung { animation: mj-ring 0.8s ease 1; }
  .mj-plank { fill: transparent; stroke: #6b3f1f; stroke-width: 2; stroke-dasharray: 4 4; }
  .mj-plank.is-set { fill: #b9783f; stroke-dasharray: none; animation: mj-drop 0.4s ease 1; transform-box: fill-box; }

  .mj-travel { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 0.75rem; }
  .mj-travel-k { font-weight: 800; color: var(--mj-soft); margin-right: 0.25rem; }
  .mj-chip { display: inline-flex; align-items: center; gap: 0.4rem; font: inherit; font-size: 1rem; font-weight: 700; min-height: 48px; padding: 0.35rem 0.85rem 0.35rem 0.4rem; border-radius: 999px; background: #fff; color: var(--mj-ink); border: 2px solid var(--mj-line); cursor: pointer; }
  .mj-chip:hover { border-color: var(--mj-blue); }
  .mj-chip-n { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; color: #fff; background: var(--mj-blue); }
  .mj-chip-n svg { width: 16px; height: 16px; }
  .mj-chip.is-done .mj-chip-n { background: var(--mj-green); }
  .mj-chip.is-locked .mj-chip-n { background: #64748b; }
  .mj-chip.is-here { border-color: var(--mj-coral); background: #fff5f5; }

  /* Panel / dialog */
  .mj-panel { margin-top: 1rem; scroll-margin-top: 140px; }
  .mj-dlg { position: relative; overflow: hidden; background: #f8fbff; border: 2px solid var(--mj-line); border-radius: 20px; padding: 1.1rem 1.25rem 1.25rem; }
  .mj-dlg--win { text-align: center; background: linear-gradient(180deg, #fffbeb, #fff); border-color: #fcd34d; }
  .mj-dlg--win .mj-actions { justify-content: center; }
  .mj-dlg-k { margin: 0; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.07em; color: #5b6b7d; }
  .mj-page .mj-dlg-h { margin: 0.1rem 0 0.5rem; font-size: 1.55rem; line-height: 1.25; color: var(--mj-ink); }
  .mj-dlg-h:focus { outline: none; }
  .mj-dlg-h:focus-visible { outline: 3px dashed var(--mj-blue); outline-offset: 4px; }
  .mj-dlg p { margin: 0 0 0.6rem; }
  .mj-mission { font-weight: 800; color: var(--mj-coral); }
  .mj-speaker { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.4rem; }
  .mj-speaker svg { width: 62px; height: 124px; flex: none; margin: -16px 0 -24px; }
  .mj-status { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; color: var(--mj-blue); }
  .mj-status svg { width: 22px; height: 22px; flex: none; }
  .mj-status.is-done { color: var(--mj-green); }
  .mj-status.is-locked { color: #475569; }
  .mj-sub { margin: 1rem 0 0.5rem; font-size: 1.05rem; color: var(--mj-ink); }
  .mj-todo { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .mj-todo-btn { width: 100%; display: flex; align-items: center; gap: 0.6rem; font: inherit; font-weight: 700; font-size: 1.05rem; min-height: 54px; padding: 0.5rem 0.9rem; border-radius: 14px; background: #fff; color: var(--mj-ink); border: 2px solid var(--mj-line); cursor: pointer; text-align: left; }
  .mj-todo-btn:hover { border-color: var(--mj-blue); }
  .mj-todo-btn em { font-style: normal; color: #6b21a8; font-weight: 700; }
  .mj-todo-ic { width: 28px; height: 28px; flex: none; border-radius: 50%; display: grid; place-items: center; border: 2px solid #f59e0b; color: #fff; }
  .mj-todo-btn.is-done .mj-todo-ic { background: var(--mj-green); border-color: var(--mj-green); }
  .mj-todo-ic svg { width: 16px; height: 16px; }

  .mj-q { font-size: 1.25rem; font-weight: 800; line-height: 1.35; margin: 0.4rem 0 0.75rem !important; }
