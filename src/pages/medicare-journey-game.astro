---
// src/pages/medicare-journey-game.astro — "Medicare Journey", an explorable
// 2D browser game. The player walks Linda (a fictional neighbor turning 65)
// along a road through six places, explores illustrated scenes, talks to
// characters, solves puzzles, collects knowledge cards and items, and finishes
// by helping her neighbor Joe make enrollment decisions. No server, no signup.
//
// Separate from medicare-adventure-game (the questionnaire), which is kept
// as-is. Built on StandardPageLayout with bareHeader + bareFooter; the page's
// own hero/FAQ/sources/related/CTA reuse SummaryBlock / AuthorByline /
// SourcesList / PageCTA so every editorial marker the gate scores is real.
//
// Accuracy: every fact in the game was checked against Medicare.gov on
// 2026-10-20 and 2026-10-22 (pages in `sources`). Wording follows the
// official pages, including their conditions (e.g. automatic enrollment only
// when Social Security benefits started at least 4 months before 65). No
// yearly dollar amounts are used; "$20" / "20%" appear only as labelled
// examples. Characters and their situations are fictional.
//
// Styles are `is:global` with every selector under `.mj-page`: the game builds
// its screens with innerHTML, which Astro's scoped selectors never match.
import StandardPageLayout from '../components/layout/StandardPageLayout.astro';
import SummaryBlock from '../components/SummaryBlock.astro';
import AuthorByline from '../components/content/AuthorByline.astro';
import SourcesList from '../components/content/SourcesList.astro';
import PageCTA from '../components/content/PageCTA.astro';
import { BUSINESS } from '../data/business';
import type { PageContext } from '../types/Page';

const context: PageContext = {
  page: {
    title: 'Medicare Journey Game | Explore, Solve Puzzles & Learn Medicare | Vernal Medicare',
    heading: 'Medicare Journey: An Interactive Medicare Adventure',
    description:
      'A free Medicare adventure game. Walk Linda through Medicare Valley, explore six places, solve puzzles, collect knowledge cards, and help her neighbor Joe make smart enrollment choices. No signup, no timer.',
    taxonomy: { silo: 'tools', tags: ['tools', 'game', 'medicare-101', 'turning-65', 'enrollment', 'costs', 'part-d'] },
    summary:
      'Medicare Journey is a free browser game. You walk Linda, a fictional neighbor turning 65, through Medicare Valley: explore six places, talk to characters, solve puzzles, collect knowledge cards and items, and finish by helping her neighbor Joe make enrollment decisions. There is no timer and no signup. It teaches general Medicare concepts — it is not advice about your own coverage.',
    faqs: [
      {
        question: 'How do I play Medicare Journey?',
        answer:
          'Tap a place on the map (or use the arrow keys) to walk Linda along the road, then go inside to explore. Tap objects and characters to learn, solve each place’s puzzles, and collect the item that opens the next door.',
      },
      {
        question: 'How is this different from Medicare Adventure?',
        answer:
          'Medicare Adventure is a quick five-stage quiz. Medicare Journey is an explorable game with a map, characters, puzzles, decisions with consequences, and a collection of knowledge cards.',
      },
      {
        question: 'Is there a time limit or signup?',
        answer:
          'No. Play at your own pace. Your progress is saved only on your own device, and you can start over any time.',
      },
      {
        question: 'Will the game tell me what to do about my own Medicare?',
        answer:
          'No. Linda, Joe, and Ray are fictional, and the game teaches general concepts. Your choices depend on your own situation — check Medicare.gov or talk with a licensed agent.',
      },
    ],
    sources: [
      { title: 'Get started with Medicare', url: 'https://www.medicare.gov/basics/get-started-with-medicare', publisher: 'Medicare.gov' },
      { title: 'How do I sign up for Medicare?', url: 'https://www.medicare.gov/basics/get-started-with-medicare/sign-up/how-do-i-sign-up-for-medicare', publisher: 'Medicare.gov' },
      { title: 'When can I sign up for Medicare?', url: 'https://www.medicare.gov/basics/get-started-with-medicare/sign-up/when-can-i-sign-up-for-medicare', publisher: 'Medicare.gov' },
      { title: 'When does Medicare coverage start?', url: 'https://www.medicare.gov/basics/get-started-with-medicare/sign-up/when-does-medicare-coverage-start', publisher: 'Medicare.gov' },
      { title: 'Joining a health or drug plan', url: 'https://www.medicare.gov/basics/get-started-with-medicare/get-more-coverage/joining-a-plan', publisher: 'Medicare.gov' },
      { title: 'What Part A covers', url: 'https://www.medicare.gov/what-medicare-covers/what-part-a-covers', publisher: 'Medicare.gov' },
      { title: 'What Part B covers', url: 'https://www.medicare.gov/what-medicare-covers/what-part-b-covers', publisher: 'Medicare.gov' },
      { title: 'Skilled nursing facility care', url: 'https://www.medicare.gov/coverage/skilled-nursing-facility-snf-care', publisher: 'Medicare.gov' },
      { title: 'Hospice care', url: 'https://www.medicare.gov/coverage/hospice-care', publisher: 'Medicare.gov' },
      { title: 'What’s not covered by Original Medicare', url: 'https://www.medicare.gov/providers-services/original-medicare/not-covered', publisher: 'Medicare.gov' },
      { title: 'Medicare costs', url: 'https://www.medicare.gov/basics/costs/medicare-costs', publisher: 'Medicare.gov' },
      { title: 'Avoid late enrollment penalties', url: 'https://www.medicare.gov/basics/costs/medicare-costs/avoid-penalties', publisher: 'Medicare.gov' },
      { title: 'Medigap basics', url: 'https://www.medicare.gov/health-drug-plans/medigap/basics', publisher: 'Medicare.gov' },
    ],
  },
  meta: {
    canonical: 'https://vernalmedicare.com/medicare-journey-game.html',
    ogType: 'website',
    ogTitle: 'Medicare Journey — An Interactive Medicare Adventure Game',
    ogDescription: 'Walk through Medicare Valley, solve puzzles, collect knowledge cards, and help a neighbor make smart Medicare choices.',
  },
  author: 'rocco',
  datePublished: '2026-10-22',
  lastUpdated: '2026-10-22',
  medicalDisclaimer:
    'Medicare Journey is general education only. Its characters and situations are fictional. It does not determine your eligibility, enrollment rights, or costs, and it does not recommend any plan or carrier. Rules and amounts can change — confirm your options with Medicare.gov, Social Security, or a licensed agent.',
  breadcrumb: [
    { name: 'Home', href: '/' },
    { name: 'Calculators', href: '/medicare-calculators.html' },
    { name: 'Medicare Journey Game', href: '/medicare-journey-game.html' },
  ],
};
const { page } = context;

const PLACES = [
  { n: 1, name: 'Linda’s House', learn: 'who Medicare is for, and whether you’re enrolled automatically or sign up yourself', href: '/turning-65.html', link: 'Turning 65 checklist' },
  { n: 2, name: 'Social Security Office', learn: 'where you sign up, and what Original Medicare means', href: '/medicare-enrollment-vernal.html', link: 'Medicare enrollment help' },
  { n: 3, name: 'Medicare Market', learn: 'what Parts A, B, C, and D cover — and what Original Medicare doesn’t', href: '/medicare-part-a-vs-part-b.html', link: 'Part A vs. Part B' },
  { n: 4, name: 'Calendar Clocktower', learn: 'your 7-month Initial Enrollment Period and the yearly enrollment windows', href: '/medicare-enrollment-periods.html', link: 'Medicare enrollment periods' },
  { n: 5, name: 'Cost Canyon', learn: 'premiums, deductibles, copayments, coinsurance, and late penalties', href: '/medicare-costs.html', link: 'Medicare costs' },
  { n: 6, name: 'Joe’s Porch', learn: 'how working past 65 and COBRA affect when to sign up for Part B', href: '/working-past-65.html', link: 'Working past 65' },
];

const TOOLS = [
  { href: '/medicare-adventure-game.html', name: 'Medicare Adventure (quiz game)', desc: 'A quicker five-stage quiz with points and badges.' },
  { href: '/medicare-quiz.html', name: 'Medicare Plan Quiz', desc: 'Seven questions to see which type of coverage may fit you.' },
  { href: '/medicare-eligibility-calculator.html', name: 'Eligibility & Timeline Calculator', desc: 'See when you qualify and your enrollment dates.' },
  { href: '/medicare-calculators.html', name: 'Free Medicare Calculators', desc: 'Estimate costs, penalties, and important dates.' },
];
---

<StandardPageLayout context={context} bareHeader bareFooter>
<div class="mj-page">

  <section class="mj-hero">
    <div>
      <h1><span>Medicare Journey:</span> <span class="mj-hero__accent">An Interactive Medicare Adventure</span></h1>
      <p class="mj-hero__tag">Explore a valley, solve puzzles, and help your neighbors with Medicare.</p>
      <SummaryBlock text={page.summary} />
      <AuthorByline authorId={context.author} updated={context.lastUpdated} />
      <p class="mj-hero__start"><a class="mj-btn mj-btn-primary" href="#mj">Start the journey <span aria-hidden="true">↓</span></a></p>
    </div>
    <ul class="mj-hero__facts" aria-label="Game at a glance">
      <li><strong>6</strong><span>places to explore</span></li>
      <li><strong>15</strong><span>knowledge cards</span></li>
      <li><strong>7</strong><span>puzzles &amp; decisions</span></li>
      <li><strong>0</strong><span>timers or signups</span></li>
    </ul>
  </section>

  <div class="mj" id="mj" aria-label="Medicare Journey game">
    <div class="mj-hud" id="mj-hud"></div>
    <div class="mj-stage" id="mj-stage">
      <noscript><p class="mj-noscript">Medicare Journey needs JavaScript turned on in your browser. Everything it teaches is also covered in the guides below.</p></noscript>
    </div>
    <div class="mj-panel" id="mj-panel"></div>
    <p class="mj-sr" id="mj-live" aria-live="polite"></p>
  </div>

  <section class="mj-sec" aria-labelledby="mj-how-h">
    <h2 id="mj-how-h">How to play</h2>
    <ol class="mj-steps">
      <li><span aria-hidden="true">1</span><p><strong>Walk the road.</strong> Tap a place on the map — or use the arrow keys — and Linda walks there. The “Travel to” buttons under the map do the same.</p></li>
      <li><span aria-hidden="true">2</span><p><strong>Go inside and explore.</strong> Tap the glowing spots: objects, signs, and characters. Each one teaches something and may give you a knowledge card, an item, or coins.</p></li>
      <li><span aria-hidden="true">3</span><p><strong>Solve puzzles and make choices.</strong> Sort services, set the enrollment clock, build a bridge, and see the consequences of different decisions.</p></li>
      <li><span aria-hidden="true">4</span><p><strong>Unlock the next door.</strong> Finishing a place earns a badge and an item. Some doors only open when you bring the right item.</p></li>
      <li><span aria-hidden="true">5</span><p><strong>Finish the mission.</strong> Use what you learned to help Joe — then read every card you collected in your journal.</p></li>
    </ol>
  </section>

  <section class="mj-sec" aria-labelledby="mj-learn-h">
    <h2 id="mj-learn-h">What you’ll discover along the road</h2>
    <ul class="mj-places">
      {PLACES.map((p) => (
        <li>
          <span class="mj-places__n" aria-hidden="true">{p.n}</span>
          <div><strong>{p.name}</strong><p>Learn {p.learn}. Read more: <a href={p.href}>{p.link}</a>.</p></div>
        </li>
      ))}
    </ul>
  </section>

  <div class="mj-two">
    <section class="mj-faq" aria-label="Frequently Asked Questions">
      <h2>Frequently Asked Questions</h2>
      {page.faqs?.map((f) => (
        <details class="mj-faq__item">
          <summary><span set:html={f.question} /><span class="mj-faq__plus" aria-hidden="true">+</span></summary>
          <div class="mj-faq__a" set:html={f.answer} />
        </details>
      ))}
    </section>
    <nav class="related mj-tools" aria-labelledby="mj-tools-h">
      <h2 id="mj-tools-h">More ways to learn</h2>
      <ul>
        {TOOLS.map((t) => (
          <li><a href={t.href}><strong>{t.name}</strong><span>{t.desc}</span></a></li>
        ))}
      </ul>
    </nav>
  </div>

  <SourcesList sources={page.sources ?? []} />

  <div class="mj-cta">
    <img class="mj-cta__photo" src="/pictures/rocco.webp" alt={`${BUSINESS.legalAgent}, licensed Medicare agent in Vernal, Utah`} width="96" height="96" loading="lazy" decoding="async" />
    <PageCTA />
  </div>

  <script is:inline>
    (function () {
      'use strict';

      var root = document.getElementById('mj');
      var hudEl = document.getElementById('mj-hud');
      var stageEl = document.getElementById('mj-stage');
      var panelEl = document.getElementById('mj-panel');
      var live = document.getElementById('mj-live');
      if (!root || !hudEl || !stageEl || !panelEl || !live) return;

      var STORE = 'vm-medicare-journey-v1';
      var RM = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
      var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

      // ─────────────────────────────────────────────────────────────────────
      // Content. Facts checked against Medicare.gov (see page sources).
      // ─────────────────────────────────────────────────────────────────────
      var CARDS = {
        who: { t: 'Who Medicare is for', x: 'Medicare is health insurance for people 65 or older who meet citizenship or residency requirements. Some younger people qualify earlier — with a disability, End-Stage Renal Disease, or ALS. Income doesn’t decide who gets Medicare.', href: '/turning-65.html', ht: 'Turning 65 checklist' },
        auto: { t: 'Automatic or sign up?', x: 'If you already get Social Security or Railroad Retirement Board benefits — starting at least 4 months before you turn 65 — you get Part A and Part B automatically. Your Medicare card comes in a welcome package 3 months before your coverage starts.', href: '/medicare-enrollment-vernal.html', ht: 'Medicare enrollment help' },
        signup: { t: 'How to sign up', x: 'If you aren’t getting Social Security benefits, getting Medicare is your choice. To sign up, contact Social Security — online or at your local Social Security office.', href: '/medicare-enrollment-periods.html', ht: 'Enrollment periods' },
        original: { t: 'Original Medicare', x: 'Original Medicare is Part A plus Part B. Most people pay no Part A premium because they or a spouse paid Medicare taxes long enough while working — generally at least 10 years.', href: '/medicare-part-a-vs-part-b.html', ht: 'Part A vs. Part B' },
        partA: { t: 'Part A: Hospital Insurance', x: 'Part A helps pay for inpatient hospital stays, skilled nursing facility care (after a qualifying inpatient hospital stay of at least 3 days in a row), hospice care, and some home health care.', href: '/medicare-part-a-vs-part-b.html', ht: 'Part A vs. Part B' },
        partB: { t: 'Part B: Medical Insurance', x: 'Part B covers medically necessary services like doctor visits and outpatient care, preventive services, and durable medical equipment such as walkers.', href: '/medicare-part-a-vs-part-b.html', ht: 'Part A vs. Part B' },
        partD: { t: 'Part D: Drug coverage', x: 'Part D helps cover the cost of prescription drugs. You can get it as a separate drug plan with Original Medicare, and most Medicare Advantage plans include it.', href: '/part-d-plans-vernal.html', ht: 'Part D drug plans' },
        partC: { t: 'Part C: Medicare Advantage', x: 'Medicare Advantage is a Medicare-approved plan from a private company — an alternative to Original Medicare that bundles Part A, Part B, and usually drug coverage. You can only buy a Medigap policy if you have Original Medicare.', href: '/medicare-advantage-plans-vernal.html', ht: 'Medicare Advantage' },
        notcovered: { t: 'Not covered by Original Medicare', x: 'Original Medicare generally doesn’t cover most dental care, eye exams for prescription glasses, hearing aids and exams for fitting them, or non-medical long-term care.', href: '/medicare-dental-vision-hearing.html', ht: 'Dental, vision & hearing' },
        iep: { t: 'Initial Enrollment Period', x: 'Your Initial Enrollment Period lasts 7 months: it starts 3 months before the month you turn 65, includes your birthday month, and ends 3 months after it.', href: '/medicare-enrollment-periods.html', ht: 'Enrollment periods' },
        windows: { t: 'Yearly enrollment windows', x: 'Open Enrollment (Oct 15 – Dec 7): join, switch, or drop Medicare Advantage or drug plans; changes start Jan 1. General Enrollment (Jan 1 – Mar 31): sign up for Part A or B if you missed your window and don’t qualify for a Special Enrollment Period. Medicare Advantage Open Enrollment (Jan 1 – Mar 31): if you’re already in a Medicare Advantage plan, switch plans or return to Original Medicare.', href: '/medicare-general-enrollment-period.html', ht: 'General Enrollment Period' },
        costs: { t: 'The four cost words', x: 'Premium: what you pay for coverage, usually monthly. Deductible: what you pay each year before Medicare or your plan pays. Copayment: a set dollar amount for a service. Coinsurance: a percentage of the cost, usually after the deductible.', href: '/medicare-costs.html', ht: 'Medicare costs' },
        penalty: { t: 'Part D late penalty', x: 'If you don’t join a Medicare drug plan when you first get Medicare, or you go 63 days or more without creditable drug coverage, you may pay an extra 1% for each month — added for as long as you have Medicare drug coverage.', href: '/medicare-penalty-calculator.html', ht: 'Penalty calculator' },
        oop: { t: 'Yearly out-of-pocket limits', x: 'Original Medicare has no yearly limit on what you pay out of pocket. Medicare Advantage plans have a yearly limit that varies by plan, and a Medigap policy can help pay your share of costs in Original Medicare.', href: '/medicare-supplement-vs-advantage.html', ht: 'Medigap vs. Medicare Advantage' },
        sep: { t: 'Working past 65', x: 'If you or your spouse have group health coverage from current work, you can sign up for Part B while covered or within 8 months after the job or coverage ends — whichever happens first. COBRA doesn’t count as that coverage. Without a Special Enrollment Period, Part B’s late penalty is 10% for each full 12-month period you could have had it.', href: '/working-past-65.html', ht: 'Working past 65' },
      };
      var CARD_ORDER = ['who', 'auto', 'signup', 'original', 'partA', 'partB', 'partD', 'partC', 'notcovered', 'iep', 'windows', 'costs', 'penalty', 'oop', 'sep'];

      var ICON = {
        coin: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#fbbf24" stroke="#a16207" stroke-width="2"/><circle cx="12" cy="12" r="6" fill="none" stroke="#a16207" stroke-width="1.5"/></svg>',
        card: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="13" height="17" rx="2"/><path d="M8 3v0M20 7v13a1 1 0 0 1-1 1H8"/><path d="M7.5 8h6M7.5 12h6"/></svg>',
        lock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>',
        check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>',
        cross: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>',
        look: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4.5-4.5"/></svg>',
        talk: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v10H9l-5 4z"/></svg>',
        puzzle: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7h3.2a2 2 0 1 1 3.6 0H15v3.2a2 2 0 1 1 0 3.6V17h-3.2a2 2 0 1 0-3.6 0H5v-3.2a2 2 0 1 0 0-3.6z"/></svg>',
        door: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 21V4h12v17M3 21h18"/><circle cx="14.5" cy="12.5" r="1" fill="currentColor"/></svg>',
        star: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.8l2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3L2.9 9.5l6.3-.9z"/></svg>',
      };

      var ITEMS = {
        birthday: { t: 'Birthday note', d: 'Linda turns 65 on July 20.', ic: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="2" fill="#fff" stroke="#d0343d" stroke-width="2"/><rect x="3" y="5" width="18" height="5" fill="#d0343d"/><text x="12" y="18" font-size="7" font-weight="800" text-anchor="middle" fill="#0b2c45" font-family="Arial">JUL</text></svg>' },
        receipt: { t: 'Sign-up receipt', d: 'Proof Linda signed up through Social Security.', ic: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-2-1.5L14 21l-2-1.5L10 21l-2-1.5L6 21z" fill="#fff" stroke="#1d4ed8" stroke-width="2"/><path d="M9 8h6M9 12h6" stroke="#1d4ed8" stroke-width="2"/></svg>' },
        partsmap: { t: 'Parts map', d: 'A map of what Parts A, B, C, and D cover.', ic: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2z" fill="#fbf1d6" stroke="#a16207" stroke-width="2"/><path d="M9 4v14M15 6v14" stroke="#a16207" stroke-width="1.5"/></svg>' },
        key: { t: 'Clocktower key', d: 'Opens the trail to Cost Canyon.', ic: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="12" r="4.5" fill="none" stroke="#a16207" stroke-width="2.6"/><path d="M12.5 12H21M18 12v3M21 12v3" stroke="#a16207" stroke-width="2.6" stroke-linecap="round"/></svg>' },
        pass: { t: 'Bridge pass', d: 'Lets Linda cross Cost Canyon to Joe’s Porch.', ic: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2" fill="#dcfce7" stroke="#166534" stroke-width="2"/><path d="M6 14h12M8 14v-3M12 14v-3M16 14v-3" stroke="#166534" stroke-width="1.8"/></svg>' },
      };

      // Map nodes (where Linda stands on the road) and pin positions, in 1000×560 map units.
      var NODES = [[120, 440], [300, 345], [470, 440], [640, 305], [755, 430], [930, 300]];
      var LOCS = [
        { id: 'home', name: 'Linda’s House', pin: [120, 282], req: null, badge: 'Home Base' },
        { id: 'ssa', name: 'Social Security Office', pin: [300, 176], req: 'birthday', badge: 'Signed Up' },
        { id: 'market', name: 'Medicare Market', pin: [470, 318], req: 'receipt', badge: 'Parts Pro' },
        { id: 'clock', name: 'Calendar Clocktower', pin: [640, 96], req: 'partsmap', badge: 'Calendar Keeper' },
        { id: 'canyon', name: 'Cost Canyon', pin: [745, 352], req: 'key', badge: 'Canyon Crosser' },
        { id: 'town', name: 'Joe’s Porch', pin: [930, 178], req: 'pass', badge: 'Medicare Navigator' },
      ];
      var LOC_INDEX = {}; LOCS.forEach(function (l, i) { LOC_INDEX[l.id] = i; });

      // ── Characters ──
      var LINDA = { skin: '#f3c9a6', hair: '#cbd5e1', bun: 1, glasses: 1, top: '#d0343d', legs: '#0b2c45' };
      var CLERK = { skin: '#8d5524', hair: '#1f2937', top: '#1d4ed8', legs: '#334155', tie: '#facc15' };
      var KEEPER = { skin: '#e0ac69', hair: '#6b7280', top: '#92400e', legs: '#44403c', glasses: 1 };
      var RANGER = { skin: '#c68642', cap: '#166534', top: '#4d7c0f', legs: '#3f3f46', badge: 1 };
      var JOE = { skin: '#f1c27d', cap: '#1d4ed8', top: '#0f766e', legs: '#1e293b', glasses: 1 };
      var MABEL = { skin: '#ffdbac', hair: '#e5e7eb', bun: 1, top: '#7c3aed', legs: '#312e81', glasses: 1 };
      var OFFICER = { skin: '#a0663d', hair: '#111827', top: '#be185d', legs: '#1f2937' };

      function person(x, y, s, c, flip) {
        return '<g transform="translate(' + x + ' ' + y + ') scale(' + (flip ? -s : s) + ' ' + s + ')">' +
          '<ellipse cx="0" cy="0" rx="17" ry="5" fill="rgba(0,0,0,.18)"/>' +
          '<rect x="-9" y="-27" width="8" height="26" rx="3" fill="' + c.legs + '"/><rect x="1" y="-27" width="8" height="26" rx="3" fill="' + c.legs + '"/>' +
